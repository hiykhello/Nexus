export module nexus.vless.tls_server;
import std;
import nexus.vless;
import nexus.tls.corosio_application;
import nexus.tls.application_io;
import nexus.thirdparty.capy;
import nexus.thirdparty.corosio;
export namespace nexus::vless::detail {
    enum class TlsInboundError { state, rejected, io };
    // Single executor; owner cancels and drains outstanding calls before destruction.
    template<class Socket>
    class TlsInbound {
        using Connection=tls::detail::ApplicationConnection<Socket>;
        Connection& connection_;
        tls::detail::ApplicationStreamReader<Socket> reader_;
        ServerHandshake handshake_;
        nex::capy::async_mutex writer_;
        std::array<std::uint8_t,4096> buffer_{};
        std::size_t begin_=0,end_=0;
        bool busy_=false,accepted_=false,failed_=false;
        auto fail(TlsInboundError error) -> std::unexpected<TlsInboundError> { failed_=true; connection_.cancel(); return std::unexpected(error); }
        auto receive(std::span<std::uint8_t> output) -> nex::capy::task<std::expected<std::size_t,TlsInboundError>> {
            while (true) {
                auto result=co_await reader_.read_some(output);
                if (!result) co_return fail(TlsInboundError::io);
                if (result->kind==tls::detail::AsyncStreamReadKind::data) co_return result->size;
                if (result->kind==tls::detail::AsyncStreamReadKind::eof || (result->event && result->event->kind==tls::ApplicationEventKind::close_notify)) co_return 0;
                if (result->kind==tls::detail::AsyncStreamReadKind::backpressure || (result->event && result->event->kind==tls::ApplicationEventKind::key_update_requested)) {
                    auto [error,guard]=co_await writer_.scoped_lock();
                    if (error || failed_ || !(co_await connection_.flush())) co_return fail(TlsInboundError::io);
                }
            }
        }
    public:
        TlsInbound(Connection& connection,ServerHandshake handshake) : connection_(connection),reader_(connection),handshake_(std::move(handshake)) {}
        TlsInbound(TlsInbound const&)=delete;
        auto operator=(TlsInbound const&) -> TlsInbound& = delete;
        auto cancel() noexcept -> void { failed_=true; connection_.cancel(); }
        auto read_request() -> nex::capy::task<std::expected<TcpRequest,TlsInboundError>> {
            if (busy_ || failed_ || handshake_.status()!=ServerStatus::reading) co_return std::unexpected(TlsInboundError::state);
            busy_=true;
            while (true) {
                auto n=co_await receive(buffer_);
                if (!n || !*n || failed_) { busy_=false; co_return fail(TlsInboundError::io); }
                auto step=handshake_.feed(std::span{buffer_}.first(*n));
                if (step.status==ServerStatus::rejected) { busy_=false; co_return fail(TlsInboundError::rejected); }
                if (step.status==ServerStatus::dialing) { begin_=step.consumed; end_=*n; busy_=false; co_return *handshake_.request(); }
            }
        }
        auto complete_dial(bool connected) -> nex::capy::task<std::expected<void,TlsInboundError>> {
            if (busy_ || failed_ || handshake_.status()!=ServerStatus::dialing) co_return std::unexpected(TlsInboundError::state);
            busy_=true; auto response=handshake_.complete_dial(connected);
            if (!response) { busy_=false; co_return fail(TlsInboundError::rejected); }
            auto [error,guard]=co_await writer_.scoped_lock();
            if (error || failed_) { busy_=false; co_return fail(TlsInboundError::io); }
            auto written=co_await connection_.send_all(*response); busy_=false;
            if (!written || failed_) co_return fail(TlsInboundError::io);
            accepted_=true; co_return std::expected<void,TlsInboundError>{};
        }
        // Serialize all TLS output with KeyUpdate responses generated by the reader.
        auto send(std::span<std::uint8_t const> bytes) -> nex::capy::task<bool> {
            auto [error,guard]=co_await writer_.scoped_lock();
            if (error || failed_ || !accepted_) co_return false;
            auto result=co_await connection_.send_all(bytes);
            if (!result || failed_) { (void)fail(TlsInboundError::io); co_return false; }
            co_return true;
        }
        auto close_output() -> nex::capy::task<bool> {
            auto [error,guard]=co_await writer_.scoped_lock();
            if (error || failed_ || !accepted_) co_return false;
            auto result=co_await connection_.close_notify();
            if (!result || failed_) { (void)fail(TlsInboundError::io); co_return false; }
            co_return true;
        }
        // Zero is an authenticated TLS close_notify. The caller provides a nonempty buffer.
        auto read(std::span<std::uint8_t> output) -> nex::capy::task<std::expected<std::size_t,TlsInboundError>> {
            if (busy_ || failed_ || !accepted_ || output.empty()) co_return std::unexpected(TlsInboundError::state);
            if (begin_<end_) { auto n=std::min(output.size(),end_-begin_); std::copy_n(buffer_.begin()+begin_,n,output.begin()); begin_+=n; co_return n; }
            busy_=true; auto result=co_await receive(output); busy_=false;
            if (failed_) co_return fail(TlsInboundError::io); co_return result;
        }
    };
    // Each direction may run once, concurrently on the same executor. Owner must retain and drain both.
    template<class Incoming,class Target>
    class TlsRelay {
        TlsInbound<Incoming>& inbound_;
        Target& target_;
        std::move_only_function<void()> touch_;
        bool canceled_=false,uploading_=false,downloading_=false;
    public:
        TlsRelay(TlsInbound<Incoming>& inbound,Target& target,std::move_only_function<void()> touch = {})
            : inbound_(inbound),target_(target),touch_(std::move(touch)) {}
        TlsRelay(TlsRelay const&)=delete;
        auto operator=(TlsRelay const&) -> TlsRelay& = delete;
        auto cancel() noexcept -> void { if (!canceled_) { canceled_=true; inbound_.cancel(); target_.cancel(); } }
        auto upload() -> nex::capy::task<bool> {
            if (uploading_ || canceled_) co_return false; uploading_=true; std::array<std::uint8_t,16384> buffer{};
            while (true) {
                auto n=co_await inbound_.read(buffer);
                if (!n || canceled_) { cancel(); co_return false; }
                if (!*n) { if (target_.shutdown(nex::corosio::shutdown_send)) { cancel(); co_return false; } co_return true; }
                if (touch_) touch_();
                std::size_t sent=0;
                while (sent<*n) {
                    auto [error,count]=co_await target_.write_some(nex::capy::const_buffer(buffer.data()+sent,*n-sent));
                    if (error || !count || count>*n-sent || canceled_) { cancel(); co_return false; } sent+=count;
                }
            }
        }
        auto download() -> nex::capy::task<bool> {
            if (downloading_ || canceled_) co_return false; downloading_=true; std::array<std::uint8_t,16384> buffer{};
            while (true) {
                auto [error,n]=co_await target_.read_some(nex::capy::mutable_buffer(buffer.data(),buffer.size()));
                if (nex::capy::is_eof(error) && !canceled_) {
                    auto closed=co_await inbound_.close_output(); if (!closed || canceled_) { cancel(); co_return false; } co_return true;
                }
                if (error || !n || n>buffer.size() || canceled_) { cancel(); co_return false; }
                if (touch_) touch_();
                if (!(co_await inbound_.send(std::span{buffer}.first(n)))) { cancel(); co_return false; }
            }
        }
    };
}
