+/* The controller occupies the existing CC union.  All
+   packet spaces retain their pointer to the shared union base. */
+static void nexus_brutal_update(ngtcp2_conn *conn, ngtcp2_tstamp ts) {
+  brutal_controller *b = &conn->brutal.controller;
+  b->max_packet = conn->cstat.max_tx_udp_payload_size;
+  conn->cstat.cwnd = brutal_cwnd(b, conn->cstat.smoothed_rtt,
+                                 conn->cstat.first_rtt_sample_ts != UINT64_MAX);
+  if (conn->tx.pacing.next_ts != UINT64_MAX) {
+    ngtcp2_tstamp next = brutal_next(b, ts);
+    conn->tx.pacing.next_ts = next <= ts ? UINT64_MAX : next;
+  }
+}
+
+static void nexus_brutal_acked(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                const ngtcp2_cc_pkt *pkt, ngtcp2_tstamp ts) {
+  ngtcp2_conn *conn = ngtcp2_struct_of(cc, ngtcp2_conn, cc);
+  (void)cstat;
+  if (pkt->sent_ts >= conn->brutal.started)
+    brutal_observe(&conn->brutal.controller, ts, 0);
+  nexus_brutal_update(conn, ts);
+}
+
+static void nexus_brutal_lost(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                               const ngtcp2_cc_pkt *pkt, ngtcp2_tstamp ts) {
+  ngtcp2_conn *conn = ngtcp2_struct_of(cc, ngtcp2_conn, cc);
+  (void)cstat;
+  if (pkt->sent_ts >= conn->brutal.started)
+    brutal_observe(&conn->brutal.controller, ts, 1);
+  nexus_brutal_update(conn, ts);
+}
+
+/* PMTUD losses are omitted from normal ngtcp2 CC events.  The fixed
+   sing-quic Brutal extension counts them in its loss samples, however. */
+void nexus_brutal_pmtud_lost(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                              const ngtcp2_cc_pkt *pkt, ngtcp2_tstamp ts) {
+  if (cc->on_pkt_lost == nexus_brutal_lost)
+    nexus_brutal_lost(cc, cstat, pkt, ts);
+}
+
+int nexus_brutal_is_active(const ngtcp2_cc *cc) {
+  return cc->on_pkt_lost == nexus_brutal_lost;
+}
+
+static void nexus_brutal_ack_recv(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                   const ngtcp2_cc_ack *ack, ngtcp2_tstamp ts) {
+  ngtcp2_conn *conn = ngtcp2_struct_of(cc, ngtcp2_conn, cc);
+  (void)cstat; (void)ack; nexus_brutal_update(conn, ts);
+}
+
+static void nexus_brutal_reset(ngtcp2_cc *cc, ngtcp2_conn_stat *cstat,
+                                ngtcp2_tstamp ts) {
+  ngtcp2_conn *conn = ngtcp2_struct_of(cc, ngtcp2_conn, cc);
+  brutal_controller *b = &conn->brutal.controller;
+  uint64_t bps = b->bytes_per_second; int compensate = b->compensate;
+  (void)brutal_init(b, bps, cstat->max_tx_udp_payload_size, compensate);
+  conn->brutal.started = ts; nexus_brutal_update(conn, ts);
+}
+
+/* Call only at a quiescent boundary after handshake and authentication. */
+int nexus_ngtcp2_set_brutal(ngtcp2_conn *conn, uint64_t bps,
+                             int compensate, ngtcp2_tstamp ts) {
+  if (!conn || !bps || !conn_is_tls_handshake_completed(conn) ||
+      !conn->cstat.max_tx_udp_payload_size || conn->tx.pacing.pktlen ||
+      ts < conn->log.last_ts) return NGTCP2_ERR_INVALID_STATE;
+  if (conn->cc.on_pkt_acked == nexus_brutal_acked) {
+    if (!brutal_reconfigure(&conn->brutal.controller,bps,compensate,ts))
+      return NGTCP2_ERR_INVALID_ARGUMENT;
+    nexus_brutal_update(conn,ts);
+    ngtcp2_tstamp next=brutal_next(&conn->brutal.controller,ts);
+    conn->tx.pacing.next_ts=next<=ts ? UINT64_MAX : next;
+    return 0;
+  }
+  conn->brutal.cc = (ngtcp2_cc){.log=&conn->log,
+    .on_pkt_acked=nexus_brutal_acked, .on_pkt_lost=nexus_brutal_lost,
+    .on_ack_recv=nexus_brutal_ack_recv, .reset=nexus_brutal_reset};
+  (void)brutal_init(&conn->brutal.controller, bps,
+                     conn->cstat.max_tx_udp_payload_size, compensate);
+  conn->brutal.started=ts;
+  conn->tx.pacing.next_ts=UINT64_MAX; conn->tx.pacing.compensation=0;
+  nexus_brutal_update(conn,ts); return 0;
+}
+
+/* Restore the original native controller without discarding bytes in flight.
