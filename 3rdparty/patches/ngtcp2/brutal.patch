+int nexus_ngtcp2_restore_cc(ngtcp2_conn *conn, ngtcp2_tstamp ts) {
+  if (!conn || conn->cc.on_pkt_acked != nexus_brutal_acked ||
+      conn->tx.pacing.pktlen || ts < conn->log.last_ts)
+    return NGTCP2_ERR_INVALID_STATE;
+  if (conn->cc_algo != NGTCP2_CC_ALGO_RENO &&
+      conn->cc_algo != NGTCP2_CC_ALGO_CUBIC &&
+      conn->cc_algo != NGTCP2_CC_ALGO_BBR)
+    return NGTCP2_ERR_INVALID_ARGUMENT;
+  conn->cstat.cwnd = ngtcp2_cc_compute_initcwnd(conn->cstat.max_tx_udp_payload_size);
+  conn->cstat.ssthresh = UINT64_MAX;
+  conn->cstat.congestion_recovery_start_ts = UINT64_MAX;
+  switch (conn->cc_algo) {
+  case NGTCP2_CC_ALGO_RENO:
+    ngtcp2_cc_reno_init(&conn->reno,&conn->log,&conn->cstat); break;
+  case NGTCP2_CC_ALGO_CUBIC:
+    ngtcp2_cc_cubic_init(&conn->cubic,&conn->log,&conn->cstat,&conn->rst); break;
+  case NGTCP2_CC_ALGO_BBR:
+    ngtcp2_cc_bbr_init(&conn->bbr,&conn->log,&conn->cstat,&conn->rst,ts,&conn->pcg); break;
+  default: ngtcp2_unreachable();
+  }
+  conn->tx.pacing.next_ts=UINT64_MAX; conn->tx.pacing.compensation=0;
+  return 0;
+}
