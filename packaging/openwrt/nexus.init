#!/bin/sh /etc/rc.common
# OpenWrt procd init script for Nexus (SquashFS-friendly /tmp runtime layout)

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/nexus
CONF=/etc/nexus/config.kdl
RUNTIME_DIR=/tmp/nexus

validate_config() {
	[ -x "$PROG" ] || {
		logger -t nexus "binary not found: $PROG"
		return 1
	}
	[ -f "$CONF" ] || {
		logger -t nexus "config not found: $CONF"
		return 1
	}
	"$PROG" check --config "$CONF" >/dev/null 2>&1 || {
		logger -t nexus "config validation failed: $CONF"
		return 1
	}
	return 0
}

start_service() {
	validate_config || return 1

	# Keep volatile sockets, cache, and logs off SquashFS / JFFS2 flash.
	mkdir -p "$RUNTIME_DIR" "$RUNTIME_DIR/cache" "$RUNTIME_DIR/state"
	chmod 0700 "$RUNTIME_DIR" "$RUNTIME_DIR/cache" "$RUNTIME_DIR/state"

	procd_open_instance nexus
	procd_set_param command "$PROG" run --config "$CONF"
	procd_set_param file "$CONF"
	procd_set_param limits nofile="65536 65536"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 15
	procd_close_instance
}

reload_service() {
	validate_config || return 1
	procd_send_signal nexus nexus HUP
}

service_triggers() {
	procd_add_reload_trigger "nexus"
}
