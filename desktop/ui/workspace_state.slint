export struct WorkspaceProfileRow {
    id: string,
    remarks: string,
    kind: string, // "node" | "custom_outbound" | "policy_group" | "proxy_chain" | "full_custom_kdl"
    subtitle: string,
    sub-name: string,
    delay-ms: int,
    active: bool,
}

export struct WorkspaceSubRow {
    id: string,
    remarks: string,
    url: string,
    node-count: int,
    quota-text: string,
    quota-ratio: float,
    expire-text: string,
    prev-profile-id: string,
    next-profile-id: string,
    enabled: bool,
}

export struct WorkspaceRoutingRow {
    id: string,
    name: string,
    default-outbound: string,
    rule-count: int,
    active: bool,
}

export struct WorkspaceRuleRow {
    id: string,
    scope: string,
    target-label: string,
    match-summary: string,
    process-summary: string,
    tls-fragment: bool,
    enabled: bool,
}

export global WorkspaceState {
    in-out property <int> active-subtab: 0; // 0: Profiles, 1: Subscriptions, 2: Routing & DNS, 3: Host & Portable
    in-out property <string> active-profile-id: "";

    in property <[WorkspaceProfileRow]> profiles: [];
    in property <[WorkspaceSubRow]> subscriptions: [];
    in property <[WorkspaceRoutingRow]> routing-profiles: [];
    in property <[WorkspaceRuleRow]> routing-rules: [];

    // DNS Layer 1 fields
    in-out property <string> dns-mode: "simple"; // "simple" | "raw_kdl"
    in-out property <string> dns-direct: "https://223.5.5.5/dns-query";
    in-out property <string> dns-remote: "https://1.1.1.1/dns-query";
    in-out property <bool> dns-fakeip: false;
    in-out property <string> dns-raw-kdl: "";

    // Isolated Layer 3 Desktop Host fields (stored in local SQLite nexus-client.db; never exported into portable workspace.json)
    in property <bool> host-is-linux: true;
    in-out property <bool> host-enable-mixed: true;
    in-out property <string> host-mixed-listen: "127.0.0.1:7890";
    in-out property <bool> host-enable-tun: false;
    in-out property <string> host-tun-mtu: "1400";
    in-out property <bool> host-tun-strict-route: false;
    in-out property <string> host-workers: "1";
    in-out property <string> host-workers-spec: "";
    in-out property <string> host-workers-max: "0";
    in property <string> host-strict-route-notice: "";
    in property <string> portable-status: "";
    in property <bool> portable-status-ok: true;

    // Inline subscription chain editor state
    in-out property <string> edit-chain-sub-id: "";
    in-out property <string> edit-chain-prev: "";
    in-out property <string> edit-chain-next: "";

    // Wave 23 E2EE WebDAV Sync (stored ONLY in local 0600 secrets/sync-creds.json) & UDP Probe state
    in-out property <string> sync-webdav-url: "";
    in-out property <string> sync-webdav-user: "";
    in-out property <string> sync-webdav-pass: "";
    in-out property <string> sync-passphrase: "";
    in-out property <string> sync-device-label: "";
    in property <bool> sync-busy: false;
    in property <string> sync-status: "";
    in property <bool> sync-status-ok: true;
    in property <bool> sync-conflict-active: false;
    in property <string> sync-conflict-detail: "";
    in property <bool> udp-probe-busy: false;
    in property <string> udp-probe-result: "";
    in property <bool> udp-probe-ok: true;

    // Profile 5-kind editor inputs
    in-out property <string> draft-kind: "node";
    in-out property <string> draft-remarks: "";
    in-out property <string> draft-payload: "";
    in-out property <bool> draft-group-interrupt: false;

    // Subscription editor inputs
    in-out property <string> sub-remarks: "";
    in-out property <string> sub-url: "";
    in-out property <string> sub-prev-id: "";
    in-out property <string> sub-next-id: "";

    // Routing profile & rule adder inputs (Wave 30-31: auto_detect_interface, find_process, tls_fragment)
    in-out property <bool> routing-auto-detect-interface: false;
    in-out property <bool> routing-find-process: false;
    in-out property <string> rule-scope: "both";
    in-out property <string> rule-target-type: "proxy";
    in-out property <string> rule-target-profile-id: "";
    in-out property <string> rule-match-input: "";
    in-out property <string> rule-desktop-process: "";
    in-out property <bool> rule-tls-fragment: false;

    callback activate-profile(string);
    callback create-profile(string, string, string); // kind, remarks, payload
    callback delete-profile(string);
    callback add-subscription(string, string, string, string); // remarks, url, prev-id, next-id
    callback update-subscription-chain(string, string, string); // sub-id, prev-id, next-id
    callback delete-subscription(string);
    callback select-routing-profile(string);
    callback apply-routing-options(bool, bool); // auto_detect_interface, find_process
    callback add-routing-rule(string, string, string, string, string); // scope, target-type, target-profile-id, match, desktop-process
    callback apply-dns-config(string, string, string, bool, string); // mode, direct, remote, fakeip, raw-kdl
    callback apply-host-config();
    callback export-portable-workspace();
    callback import-portable-workspace();
    callback export-profile-share(string);
    callback import-profile-share(string);
    callback save-sync-settings();
    callback sync-push(bool); // force_overwrite
    callback sync-pull(bool); // force_pull
    callback dismiss-sync-conflict();
    callback run-udp-probe(string); // "stun" | "dns" | "ntp"
}
