import { CustomKdlDraft, OutboundNodeDraft, PolicyGroupDraft, ProxyChainDraft } from "types.slint";

export struct WorkspaceProfileRow {
    id: string,
    remarks: string,
    kind: string, // "node" | "custom_outbound" | "policy_group" | "proxy_chain" | "full_custom_kdl"
    proto-badge: string,
    endpoint: string,
    transport-summary: string,
    subtitle: string,
    sub-id: string,
    sub-name: string,
    delay-ms: int,
    active: bool,
}

export struct WorkspaceSubRow {
    id: string,
    remarks: string,
    url: string,
    node-count: int,
    quota-text: string,
    quota-ratio: float,
    expire-text: string,
    prev-profile-id: string,
    next-profile-id: string,
    auto-update-min: int,
    include-regex: string,
    exclude-regex: string,
    user-agent: string,
    enabled: bool,
}

export struct WorkspaceRoutingRow {
    id: string,
    name: string,
    default-outbound: string,
    domain-strategy: string,
    rule-count: int,
    active: bool,
}

export struct WorkspaceRuleRow {
    id: string,
    scope: string,
    target-label: string,
    match-summary: string,
    process-summary: string,
    tls-fragment: bool,
    locked: bool,
    enabled: bool,
}

export struct WorkspaceRuleSetRow {
    tag: string,
    source-type: string,
    format: string,
    locator: string,
    update-min: int,
}

export global WorkspaceState {
    in-out property <int> active-subtab: 0;
    in-out property <string> active-profile-id: "";

    // Server Table Filtering, Subscription Group Tabs & Modal State
    in-out property <string> selected-sub-tab: "all"; // "all" | "manual" | <sub.id>
    in-out property <string> profile-search: "";
    in-out property <string> profile-sort: "default"; // "default" | "latency" | "name"
    in-out property <bool> sub-drawer-open: false;
    in-out property <bool> sub-updating: false;

    // Unified 5-kind Profile Editor Modal state ("node" | "policy_group" | "proxy_chain" | "custom_outbound" | "full_custom_kdl")
    in-out property <string> editor-kind: "node";
    in-out property <int> editor-revision: 0;
    in-out property <OutboundNodeDraft> editor-node-draft: {
        edit-id: "", sub-id: "manual", proto: "vless", tag: "hk-01", host: "hk01.example.net", port: "443",
        secret: "", uuid-str: "", username: "", flow: "xtls-rprx-vision", packet-encoding: "xudp",
        hy2-ports: "", hy2-hop-interval: "", hy2-salamander: "", hy2-up-mbps: "", hy2-down-mbps: "",
        tuic-cc: "bbr", tuic-udp-over-stream: false, ss-method: "2022-blake3-aes-128-gcm",
        snell-ver: 5, snell-obfs: "none", snell-obfs-host: "", naive-proto: "h2", ssh-host-sha: "",
        wg-peer-pbk: "", wg-psk: "", wg-local-cidr: "10.0.0.2/32", wg-reserved: "", wg-mtu: "1420",
        masque-mode: "connect-udp", masque-path: "", masque-local-cidr: "",
        sni: "", fingerprint: "chrome", key-exchange: "default", cert-sha256: "",
        use-reality: true, reality-pbk: "", reality-sid: "", client-hello-fragment: false, tls-fragment: false,
        ech-dns: false, ech-config: "", ech-query-sni: "",
        transport: "tcp", transport-path: "/", transport-host: "", xhttp-mode: "auto",
        ws-max-early-data: "", ws-early-data-header: "", grpc-permit-without-stream: false,
        mux-enabled: false, mux-proto: "h2mux", mux-max-conns: "4", mux-min-streams: "2", mux-padding: false,
    };
    in-out property <PolicyGroupDraft> editor-group-draft: {
        edit-id: "", remarks: "", strategy: "url-test", member-ids-csv: "",
        dynamic-sub-id: "", include-regex: "", exclude-regex: "",
        probe-url: "https://www.gstatic.com/generate_204", probe-interval-ms: "300000", tolerance-ms: "100",
        interrupt-exist: false,
    };
    in-out property <ProxyChainDraft> editor-chain-draft: {
        edit-id: "", remarks: "", hop-ids-csv: "",
    };
    in-out property <CustomKdlDraft> editor-kdl-draft: {
        edit-id: "", remarks: "", kind: "custom_outbound", kdl-text: "",
    };

    in property <[WorkspaceProfileRow]> profiles: [];
    in property <[WorkspaceProfileRow]> filtered-profiles: [];
    in property <[WorkspaceSubRow]> subscriptions: [];
    in property <[WorkspaceRoutingRow]> routing-profiles: [];
    in property <[WorkspaceRuleRow]> routing-rules: [];
    in property <[WorkspaceRuleSetRow]> rule-sets: [];

    // Full DNS Layer 1 fields
    in-out property <string> dns-mode: "simple"; // "simple" | "raw_kdl"
    in-out property <string> dns-bootstrap: "223.5.5.5";
    in-out property <string> dns-direct: "https://223.5.5.5/dns-query";
    in-out property <string> dns-remote: "https://1.1.1.1/dns-query";
    in-out property <string> dns-strategy: "prefer_ipv4";
    in-out property <bool> dns-parallel: false;
    in-out property <bool> dns-fakeip: false;
    in-out property <string> dns-fakeip-v4: "198.18.0.0/16";
    in-out property <string> dns-fakeip-v6: "fc00::/18";
    in-out property <bool> dns-fakeip-global: false;
    in-out property <bool> dns-block-aaaa: false;
    in-out property <bool> dns-block-svcb: false;
    in-out property <bool> dns-use-system-hosts: true;
    in-out property <string> dns-hosts-text: "";
    in-out property <string> dns-raw-kdl: "";

    // FullTemplate Layer 1 fields
    in-out property <bool> tpl-enabled: false;
    in-out property <bool> tpl-append-only: false;
    in-out property <string> tpl-proxy-detour: "";
    in-out property <string> tpl-kdl: "";

    // Isolated Layer 3 Desktop Host fields (device-local only — arbitrary Mixed / HTTP / SOCKS5 combinations)
    in property <bool> host-is-linux: true;
    in-out property <bool> host-enable-mixed: true;
    in-out property <string> host-mixed-listen: "127.0.0.1:7890";
    in-out property <bool> host-enable-socks: false;
    in-out property <string> host-socks-listen: "127.0.0.1:10808";
    in-out property <bool> host-enable-http: false;
    in-out property <string> host-http-listen: "127.0.0.1:10809";
    in-out property <bool> host-allow-lan: false;
    in-out property <string> host-lan-listen: "";
    in-out property <string> host-lan-user: "";
    in-out property <string> host-lan-pass: "";
    in-out property <bool> host-enable-tun: false;
    in-out property <string> host-tun-name: "nexus-tun0";
    in-out property <string> host-tun-mtu: "1400";
    in-out property <string> host-tun-inet4: "172.19.0.1/30";
    in-out property <string> host-tun-inet6: "";
    in-out property <bool> host-tun-auto-route: true;
    in-out property <bool> host-tun-strict-route: false;
    in-out property <bool> host-tun-exclude-private: true;
    in-out property <string> host-tun-exclude-cidr: "";
    in-out property <string> host-bind-iface: "";
    in-out property <string> host-bind-inet4: "";
    in-out property <string> host-bind-inet6: "";
    in-out property <bool> host-include-siblings: true;
    in-out property <string> host-workers: "1";
    in-out property <string> host-workers-spec: "";
    in-out property <string> host-workers-max: "0";
    in property <string> host-strict-route-notice: "";
    in property <string> portable-status: "";
    in property <bool> portable-status-ok: true;

    // Inline subscription editor state
    in-out property <string> edit-chain-sub-id: "";
    in-out property <string> edit-chain-prev: "";
    in-out property <string> edit-chain-next: "";
    in-out property <string> sub-remarks: "";
    in-out property <string> sub-url: "";
    in-out property <string> sub-prev-id: "";
    in-out property <string> sub-next-id: "";
    in-out property <string> sub-auto-min: "0";
    in-out property <string> sub-include-regex: "";
    in-out property <string> sub-exclude-regex: "";
    in-out property <string> sub-user-agent: "";

    // E2EE WebDAV Sync & UDP Probe state
    in-out property <string> sync-webdav-url: "";
    in-out property <string> sync-webdav-user: "";
    in-out property <string> sync-webdav-pass: "";
    in-out property <string> sync-passphrase: "";
    in-out property <string> sync-device-label: "";
    in property <bool> sync-busy: false;
    in property <string> sync-status: "";
    in property <bool> sync-status-ok: true;
    in property <bool> sync-conflict-active: false;
    in property <string> sync-conflict-detail: "";
    in property <bool> udp-probe-busy: false;
    in property <string> udp-probe-result: "";
    in property <bool> udp-probe-ok: true;

    // Quick URI paste bar
    in-out property <string> draft-kind: "node";
    in-out property <string> draft-remarks: "";
    in-out property <string> draft-payload: "";
    in-out property <bool> draft-group-interrupt: false;

    // Routing profile, rule adder & RuleSet Asset inputs
    in-out property <string> routing-domain-strategy: "as-is";
    in-out property <string> routing-default-outbound: "proxy";
    in-out property <bool> routing-auto-detect-interface: false;
    in-out property <bool> routing-find-process: false;
    in-out property <string> new-routing-name: "";
    in-out property <string> rule-scope: "both";
    in-out property <string> rule-target-type: "proxy";
    in-out property <string> rule-target-profile-id: "";
    in-out property <string> rule-match-input: "";
    in-out property <string> rule-desktop-process: "";
    in-out property <bool> rule-tls-fragment: false;
    in-out property <string> rs-tag: "";
    in-out property <string> rs-source: "remote";
    in-out property <string> rs-format: "srs";
    in-out property <string> rs-locator: "";
    in-out property <string> rs-update-min: "1440";

    callback activate-profile(string);
    callback create-profile(string, string, string);
    callback delete-profile(string);
    callback set-sub-filter(string);
    callback set-profile-search(string);
    callback cycle-profile-sort();
    callback import-clipboard-uris();
    callback request-new-profile(string);
    callback request-edit-profile(string);
    callback save-group-profile(PolicyGroupDraft);
    callback save-chain-profile(ProxyChainDraft);
    callback save-kdl-profile(CustomKdlDraft);
    callback add-subscription(string, string, string, string);
    callback refresh-subscription(string); // "" = refresh all
    callback update-subscription-chain(string, string, string);
    callback delete-subscription(string);
    callback select-routing-profile(string);
    callback create-routing-preset(string);
    callback apply-routing-options(bool, bool);
    callback apply-routing-strategy(string, string); // domain-strategy, default-outbound
    callback add-routing-rule(string, string, string, string, string);
    callback toggle-routing-rule(string, bool);
    callback delete-routing-rule(string);
    callback add-rule-set(string, string, string, string, string);
    callback delete-rule-set(string);
    callback apply-dns-config(string, string, string, bool, string);
    callback apply-full-template();
    callback apply-host-config();
    callback export-portable-workspace();
    callback import-portable-workspace();
    callback export-profile-share(string);
    callback import-profile-share(string);
    callback save-sync-settings();
    callback sync-push(bool);
    callback sync-pull(bool);
    callback dismiss-sync-conflict();
    callback run-udp-probe(string);
}
