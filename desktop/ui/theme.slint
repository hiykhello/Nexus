import { Palette } from "std-widgets.slint";

export enum ThemePreference { system, obsidian, paper, amber }
export enum AccentPreset { ocean, emerald, violet, amber, rose }

export global Theme {
    in-out property <ThemePreference> preference: ThemePreference.system;
    in-out property <AccentPreset> accent-preset: AccentPreset.ocean;
    in-out property <bool> blur-enabled: false;
    in-out property <float> window-opacity: 1.0;

    out property <float> clamped-opacity: clamp(window-opacity, 0.40, 1.0);
    out property <float> effective-alpha:
        blur-enabled && clamped-opacity > 0.96 ? 0.88 : clamped-opacity;
    out property <bool> is-translucent: blur-enabled || clamped-opacity < 0.995;

    public function apply-preference(pref: ThemePreference) {
        preference = pref;
        if (pref == ThemePreference.obsidian || pref == ThemePreference.amber) {
            Palette.color-scheme = ColorScheme.dark;
        } else if (pref == ThemePreference.paper) {
            Palette.color-scheme = ColorScheme.light;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }

    public function toggle-light-dark() {
        apply-preference(dark ? ThemePreference.paper : ThemePreference.obsidian);
    }

    out property <bool> system-dark:
        Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme == ColorScheme.unknown && Palette.foreground.to-hsv().value > 0.5);

    out property <bool> is-amber: preference == ThemePreference.amber;

    out property <bool> dark:
        (preference == ThemePreference.obsidian || preference == ThemePreference.amber) ? true
        : preference == ThemePreference.paper ? false
        : system-dark;

    // Signal Emerald channel (live tunnel & fast RTT; WCAG AA >= 4.8:1)
    out property <color> live-emerald: dark ? #10b981 : #059669;
    out property <color> live-emerald-soft: dark ? #10b98124 : #ecfdf5;
    out property <color> live-emerald-border: dark ? #10b98160 : #6ee7b7;
    out property <color> live-emerald-on-fill: #ffffff;

    // Secondary / Rule-Interchange Accent
    out property <color> rule-vermilion: dark ? #f87171 : #dc2626;
    out property <color> rule-vermilion-soft: dark ? #f8717122 : #fef2f2;
    out property <color> rule-vermilion-fg: #ffffff;

    // Interactive Brand Accent (Electric Cobalt #2563EB / #60A5FA + optional user presets)
    out property <color> accent:
        accent-preset == AccentPreset.emerald ? (dark ? #10b981 : #059669)
        : accent-preset == AccentPreset.violet ? (dark ? #a78bfa : #6d28d9)
        : accent-preset == AccentPreset.amber ? (dark ? #f59e0b : #d97706)
        : accent-preset == AccentPreset.rose ? (dark ? #f87171 : #e11d48)
        : is-amber ? #f59e0b
        : (dark ? #60a5fa : #2563eb);

    out property <color> pill-active-top:
        accent-preset == AccentPreset.emerald ? (dark ? #10b981 : #059669)
        : accent-preset == AccentPreset.violet ? (dark ? #8b5cf6 : #6d28d9)
        : accent-preset == AccentPreset.amber ? (dark ? #f59e0b : #d97706)
        : accent-preset == AccentPreset.rose ? (dark ? #f43f5e : #e11d48)
        : is-amber ? #f59e0b
        : (dark ? #3b82f6 : #2563eb);

    out property <color> pill-active-bot:
        accent-preset == AccentPreset.emerald ? (dark ? #059669 : #047857)
        : accent-preset == AccentPreset.violet ? (dark ? #7c3aed : #5b21b6)
        : accent-preset == AccentPreset.amber ? (dark ? #d97706 : #b45309)
        : accent-preset == AccentPreset.rose ? (dark ? #e11d48 : #be123c)
        : is-amber ? #d97706
        : (dark ? #2563eb : #1d4ed8);

    out property <color> pill-active-fg:
        (accent-preset == AccentPreset.amber && dark) || (accent-preset == AccentPreset.ocean && is-amber)
            ? #14120f : #ffffff;
    out property <color> accent-fg: pill-active-fg;

    out property <color> accent-soft: accent.with-alpha(dark ? 0.18 : 0.10);
    out property <color> nav-hover-bg: is-amber ? #ffffff0b : dark ? #ffffff0a : #0f172a08;
    out property <color> nav-active-bg: is-amber ? #ffffff12 : dark ? #ffffff10 : #0f172a0b;
    out property <color> nav-active-fg:
        accent-preset == AccentPreset.emerald ? (dark ? #34d399 : #059669)
        : accent-preset == AccentPreset.violet ? (dark ? #c4b5fd : #6d28d9)
        : accent-preset == AccentPreset.amber ? (dark ? #fbbf24 : #b45309)
        : accent-preset == AccentPreset.rose ? (dark ? #fda4af : #be123c)
        : is-amber ? #fbbf24
        : (dark ? #60a5fa : #2563eb);
    out property <brush> selected-bg: accent.with-alpha(dark ? 0.16 : 0.08);
    out property <brush> selected-border: accent.with-alpha(dark ? 0.72 : 0.56);

    // Fluent 2 Control Fill & Top-Lit Elevation Borders (zero drop shadow, physical hairline bevel)
    out property <color> control-fill: is-amber ? #26221c : dark ? #202938 : #ffffff;
    out property <color> control-fill-hover: is-amber ? #2e2922 : dark ? #273245 : #f8fafc;
    out property <color> control-fill-pressed: is-amber ? #1d1a16 : dark ? #19212e : #f1f5f9;
    out property <brush> control-border-brush: is-amber
        ? @linear-gradient(180deg, #433b31 0%, #302a23 15%, #2b261f 100%)
        : dark
            ? @linear-gradient(180deg, #3c4b63 0%, #2a3649 16%, #253042 100%)
            : @linear-gradient(180deg, #e2e8f0 0%, #dbe2ea 82%, #cbd5e1 100%);
    out property <brush> control-border-hover-brush: is-amber
        ? @linear-gradient(180deg, #544a3d 0%, #3b342b 18%, #342e26 100%)
        : dark
            ? @linear-gradient(180deg, #4c5f7d 0%, #35445c 18%, #2e3b50 100%)
            : @linear-gradient(180deg, #cbd5e1 0%, #cbd5e1 80%, #94a3b8 100%);
    out property <brush> accent-control-border:
        @linear-gradient(180deg, pill-active-top.brighter(0.14) 0%, pill-active-top 18%, pill-active-bot.darker(0.22) 100%);
    out property <color> input-bottom-rest: is-amber ? #6b5f4f : dark ? #5b6d87 : #94a3b8;

    // Flagship Navigation Rail (Crisp Light / Elevated Slate Dark with Fluent 2 Subtle Wash)
    out property <color> rail-bg-solid: is-amber ? #161411 : dark ? #131923 : #ffffff;
    out property <color> rail-bg: is-translucent ? rail-bg-solid.with-alpha(clamp(effective-alpha + 0.04, 0.46, 1.0)) : rail-bg-solid;
    out property <color> rail-fg: is-amber ? #f5f1e8 : dark ? #f1f5f9 : #0f172a;
    out property <color> rail-fg-muted: is-amber ? #a89f91 : dark ? #94a3b8 : #64748b;
    out property <color> rail-hover-bg: nav-hover-bg;
    out property <color> rail-active-bg: nav-active-bg;
    out property <color> rail-active-fg: nav-active-fg;
    out property <color> rail-border: is-amber ? #2a2620 : dark ? #222c3c : #e2e8f0;

    // Primary Tunnel Hero CTA Surface (hue-tinted secondary ink, NEVER neutral gray; WCAG AA >= 5.0:1)
    out property <color> cmd-bg-solid: is-amber ? #b45309 : #2563eb;
    out property <color> cmd-bg: cmd-bg-solid;
    out property <color> cmd-well-bg: is-amber ? #24201a : dark ? #1e2736 : #f1f5f9;
    out property <color> cmd-hover-bg: is-amber ? #c2410c : #1d4ed8;
    out property <color> cmd-fg: #ffffff;
    out property <color> cmd-fg-secondary: is-amber ? #fef3c7 : #dbeafe;
    out property <color> cmd-rule: is-amber ? #42382b : dark ? #2b384d : #dbe4f0;
    out property <color> cmd-seg-active-bg: card-bg-solid;
    out property <color> cmd-seg-active-fg: nav-active-fg;

    // Decoupled Telemetry Channel Colors (Cobalt RX + Emerald TX)
    out property <color> telemetry-down: is-amber ? #fbbf24 : (dark ? #60a5fa : #2563eb);
    out property <color> telemetry-up: live-emerald;
    out property <color> telemetry-up-soft: live-emerald-soft;

    // Latency Tiers
    out property <color> lat-fast-fg: dark ? #34d399 : #059669;
    out property <color> lat-fast-bg: dark ? #10b98122 : #ecfdf5;
    out property <color> lat-good-fg: dark ? #60a5fa : #2563eb;
    out property <color> lat-good-bg: dark ? #3b82f622 : #eff6ff;
    out property <color> lat-mid-fg: dark ? #fbbf24 : #d97706;
    out property <color> lat-mid-bg: dark ? #f59e0b22 : #fffbeb;
    out property <color> lat-slow-fg: rule-vermilion;
    out property <color> lat-slow-bg: rule-vermilion-soft;

    // Protocol Badges
    out property <color> proto-quic-fg: dark ? #fbbf24 : #b45309;
    out property <color> proto-quic-bg: dark ? #f59e0b22 : #fef3c7;
    out property <color> proto-tls-fg: nav-active-fg;
    out property <color> proto-tls-bg: accent-soft;
    out property <color> proto-direct-fg: live-emerald;
    out property <color> proto-direct-bg: live-emerald-soft;

    // Canvas Ground (#F4F6F9 / #0F141C) vs Single-Level Card Surface (#FFFFFF / #171E29)
    out property <color> sidebar-card-bg-solid: rail-bg-solid;
    out property <color> surface-bg-solid: is-amber ? #12100e : dark ? #0f141c : #f4f6f9;
    out property <color> card-bg-solid: is-amber ? #1b1815 : dark ? #171e29 : #ffffff;
    out property <color> sidebar-card-bg: rail-bg;
    out property <color> surface-bg: is-translucent ? surface-bg-solid.with-alpha(effective-alpha) : surface-bg-solid;
    out property <color> sidebar-border: rail-border;

    out property <color> card-bg: is-translucent ? card-bg-solid.with-alpha(clamp(effective-alpha + 0.10, 0.52, 1.0)) : card-bg-solid;
    out property <brush> card-surface: card-bg;
    out property <color> overlay-bg-solid: is-amber ? #211e1a : dark ? #1b2432 : #ffffff;
    out property <color> overlay-bg: is-translucent ? overlay-bg-solid.with-alpha(clamp(effective-alpha + 0.18, 0.88, 1.0)) : overlay-bg-solid;
    out property <color> well-bg-solid: is-amber ? #24201b : dark ? #1e2736 : #f8fafc;
    out property <color> well-bg: is-translucent ? well-bg-solid.with-alpha(clamp(effective-alpha * 0.72, 0.36, 0.96)) : well-bg-solid;
    out property <color> inset-bg-solid: is-amber ? #2e2923 : dark ? #263244 : #eef2f6;
    out property <color> inset-bg: is-translucent ? inset-bg-solid.with-alpha(clamp(effective-alpha * 0.78, 0.42, 0.96)) : inset-bg-solid;

    // Structural Hairlines & Card Borders
    out property <color> card-border: is-amber ? #2f2a23 : dark ? #263142 : #e2e8f0;
    out property <color> well-border: is-amber ? #3a342b : dark ? #303d52 : #dbe2ea;
    out property <color> hairline-subtle: is-amber ? #28241e : dark ? #222c3c : #e9eef5;
    out property <color> hairline-strong: is-amber ? #4a4237 : dark ? #475569 : #94a3b8;
    out property <color> modal-backdrop: dark ? #020617a8 : #0f172a66;
    out property <color> modal-border: is-amber ? #574e42 : dark ? #3e506b : #94a3b8;
    out property <color> popup-border: modal-border;
    out property <color> control-knob-bg: #ffffff;
    out property <color> selection-fg: #ffffff;
    out property <color> scrollbar-rail-border: card-border;
    out property <color> scrollbar-rail-bg: well-bg;
    out property <color> scrollbar-thumb-hover: is-amber ? #aea79c : dark ? #94a3b8 : #475569;
    out property <color> scrollbar-thumb: is-amber ? #5c5448 : dark ? #475569 : #94a3b8;

    out property <color> pill-danger-bot: #dc2626;
    out property <color> pill-direct-bot: #059669;

    out property <string> mono-font: "monospace";
    out property <color> row-bg: card-bg;
    out property <color> row-alt-bg-solid: is-amber ? #1f1b17 : dark ? #1b2330 : #f8fafc;
    out property <color> row-alt-bg: is-translucent ? row-alt-bg-solid.with-alpha(effective-alpha) : row-alt-bg-solid;
    out property <color> row-hover-bg: is-amber ? #29241e : dark ? #212c3d : #f1f5f9;

    // WCAG 2.1 AA Calibrated Ink Hierarchy
    out property <brush> text-primary: is-amber ? #f5f1e8 : dark ? #f1f5f9 : #0f172a;
    out property <brush> text-secondary: is-amber ? #c2b8aa : dark ? #a3b3c9 : #475569;
    out property <brush> text-muted: is-amber ? #b0a698 : dark ? #94a3b8 : #526071;
    out property <brush> success-bg: live-emerald-soft;
    out property <color> success-fg: live-emerald;
    out property <color> success-on-fill: live-emerald-on-fill;
    out property <color> success-border: live-emerald-border;
    out property <color> warn-bg: dark ? #f59e0b22 : #fffbeb;
    out property <color> warn-fg: dark ? #fbbf24 : #d97706;
    out property <color> warn-border: dark ? #f59e0b48 : #fde68a;
    out property <brush> error-bg: dark ? #f8717122 : #fef2f2;
    out property <color> error-fg: dark ? #f87171 : #dc2626;
    out property <color> error-border: dark ? #f8717150 : #fecaca;
    out property <color> offline-fg: is-amber ? #8f887d : dark ? #64748b : #94a3b8;

    public pure function latency-fg(ms: int, state: string) -> color {
        if (ms <= 0) {
            return (state == "timeout" || state == "unreachable" || state == "error" || state == "failed")
                ? error-fg : offline-fg;
        }
        if (ms < 80) { return lat-fast-fg; }
        if (ms < 180) { return lat-good-fg; }
        if (ms < 350) { return lat-mid-fg; }
        return lat-slow-fg;
    }

    public pure function latency-bg(ms: int, state: string) -> color {
        if (ms <= 0) {
            return (state == "timeout" || state == "unreachable" || state == "error" || state == "failed")
                ? (dark ? #f8717122 : #fef2f2) : inset-bg;
        }
        if (ms < 80) { return lat-fast-bg; }
        if (ms < 180) { return lat-good-bg; }
        if (ms < 350) { return lat-mid-bg; }
        return lat-slow-bg;
    }

    public pure function latency-bars(ms: int) -> int {
        if (ms <= 0) { return 0; }
        if (ms < 80) { return 4; }
        if (ms < 180) { return 3; }
        if (ms < 350) { return 2; }
        return 1;
    }

    // 8px-grid Spacing & Fluent 2 Desktop Radius Scale (4px / 6px / 10px)
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 20px;
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
    out property <length> radius-card: 10px;
}
