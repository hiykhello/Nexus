import { Palette } from "std-widgets.slint";

export enum ThemePreference { system, light, dark }
export enum AccentPreset { ocean, emerald, violet, amber, rose }

export global Theme {
    in-out property <ThemePreference> preference: ThemePreference.system;
    in-out property <AccentPreset> accent-preset: AccentPreset.ocean;

    public function apply-preference(pref: ThemePreference) {
        preference = pref;
        if (pref == ThemePreference.dark) {
            Palette.color-scheme = ColorScheme.dark;
        } else if (pref == ThemePreference.light) {
            Palette.color-scheme = ColorScheme.light;
        } else {
            Palette.color-scheme = ColorScheme.unknown;
        }
    }

    public function toggle-light-dark() {
        apply-preference(dark ? ThemePreference.light : ThemePreference.dark);
    }

    out property <bool> system-dark:
        Palette.color-scheme == ColorScheme.dark
        || (Palette.color-scheme == ColorScheme.unknown && Palette.foreground.to-hsv().value > 0.5);

    out property <bool> dark:
        preference == ThemePreference.dark ? true
        : preference == ThemePreference.light ? false
        : system-dark;

    // Brand accent presets (WCAG AA/AAA calibrated across all 10 Dark/Light combinations)
    out property <color> accent:
        accent-preset == AccentPreset.emerald ? (dark ? #22c55e : #15803d)
        : accent-preset == AccentPreset.violet ? (dark ? #a78bfa : #6d28d9)
        : accent-preset == AccentPreset.amber ? (dark ? #f59e0b : #b45309)
        : accent-preset == AccentPreset.rose ? (dark ? #fb7185 : #dc2626)
        : (dark ? #3b82f6 : #1d4ed8);

    out property <color> accent-fg: dark && (accent-preset == AccentPreset.emerald || accent-preset == AccentPreset.amber) ? #0b1220 : #ffffff;

    // Flat crisp active pill tones (zero heavy blur/glow)
    out property <color> pill-active-top:
        accent-preset == AccentPreset.emerald ? (dark ? #22c55e : #16a34a)
        : accent-preset == AccentPreset.violet ? (dark ? #8b5cf6 : #7c3aed)
        : accent-preset == AccentPreset.amber ? (dark ? #f59e0b : #d97706)
        : accent-preset == AccentPreset.rose ? (dark ? #f43f5e : #e11d48)
        : (dark ? #3b82f6 : #2563eb);
    out property <color> pill-active-bot:
        accent-preset == AccentPreset.emerald ? (dark ? #16a34a : #15803d)
        : accent-preset == AccentPreset.violet ? (dark ? #7c3aed : #6d28d9)
        : accent-preset == AccentPreset.amber ? (dark ? #d97706 : #b45309)
        : accent-preset == AccentPreset.rose ? (dark ? #e11d48 : #be123c)
        : (dark ? #2563eb : #1d4ed8);
    out property <color> pill-active-fg:
        dark && (accent-preset == AccentPreset.emerald || accent-preset == AccentPreset.amber) ? #0b1220 : #ffffff;

    out property <color> accent-soft: accent.with-alpha(dark ? 0.16 : 0.11);
    out property <color> nav-hover-bg: dark ? #20242c : #eceff3;
    out property <color> nav-active-bg: accent.with-alpha(dark ? 0.18 : 0.12);
    out property <color> nav-active-fg: dark ? accent.brighter(0.22) : accent;
    out property <brush> selected-bg: accent.with-alpha(dark ? 0.16 : 0.10);
    out property <brush> selected-border: accent.with-alpha(dark ? 0.68 : 0.58);

    // Decoupled Telemetry Channel Colors (fixed across ALL brand accents; WCAG AA >= 4.5:1)
    out property <color> telemetry-down: dark ? #38bdf8 : #0369a1;
    out property <color> telemetry-up: dark ? #c084fc : #7c3aed;
    out property <color> telemetry-up-soft: telemetry-up.with-alpha(dark ? 0.18 : 0.12);

    // 5-tier Semantic Latency Palette (<80 fast, <180 good, <350 mid, >=350 slow, unprobed slate, timeout danger)
    out property <color> lat-fast-fg: dark ? #22c55e : #15803d;
    out property <color> lat-fast-bg: dark ? #16a34a22 : #dcfce7;
    out property <color> lat-good-fg: dark ? #2dd4bf : #0f766e;
    out property <color> lat-good-bg: dark ? #14b8a620 : #ccfbf1;
    out property <color> lat-mid-fg: dark ? #f59e0b : #b45309;
    out property <color> lat-mid-bg: dark ? #f59e0b22 : #fef3c7;
    out property <color> lat-slow-fg: dark ? #fb923c : #c2410c;
    out property <color> lat-slow-bg: dark ? #f9731622 : #ffedd5;

    // Protocol semantic badges
    out property <color> proto-quic-fg: dark ? #f59e0b : #b45309;
    out property <color> proto-quic-bg: dark ? #f59e0b20 : #fef3c7;
    out property <color> proto-tls-fg: dark ? #38bdf8 : #0369a1;
    out property <color> proto-tls-bg: dark ? #0ea5e920 : #e0f2fe;
    out property <color> proto-direct-fg: dark ? #22c55e : #15803d;
    out property <color> proto-direct-bg: dark ? #16a34a20 : #dcfce7;

    // Matte Precision Surface Hierarchy
    out property <color> surface-bg: dark ? #111317 : #f5f6f8;
    out property <color> sidebar-card-bg: dark ? #15181e : #ffffff;
    out property <color> sidebar-border: dark ? #262a33 : #e0e4ec;
    out property <color> resize-handle: dark ? #3f4654 : #cbd5e1;

    // L1 Matte Card / L2 Well / L3 Inset
    out property <color> card-bg: dark ? #191c22 : #ffffff;
    out property <brush> card-surface: card-bg;
    out property <color> overlay-bg: dark ? #1d2129 : #ffffff;
    out property <color> well-bg: dark ? #20242c : #eceff3;
    out property <color> inset-bg: dark ? #2a2f3a : #e2e6ee;

    // 1px precision structural borders
    out property <color> card-border: dark ? #262a33 : #e0e4ec;
    out property <color> well-border: dark ? #2b303b : #dce1ea;
    out property <color> hairline-subtle: dark ? #232730 : #e6eaf1;
    out property <color> hairline-strong: dark ? #363c49 : #c8d0dc;
    out property <color> modal-backdrop: dark ? #00000088 : #0f172a52;
    out property <color> modal-border: dark ? #363c49 : #cbd5e1;
    out property <color> popup-border: dark ? #363c49 : #cbd5e1;
    out property <color> control-knob-bg: #ffffff;
    out property <color> selection-fg: #ffffff;
    out property <color> scrollbar-rail-border: dark ? #262a33 : #e0e4ec;
    out property <color> scrollbar-rail-bg: dark ? #15181e : #eef1f5;
    out property <color> scrollbar-thumb-hover: dark ? #9aa3b2 : #475569;
    out property <color> scrollbar-thumb: dark ? #555e6e : #94a3b8;

    // Action pill semantic tones
    out property <color> pill-danger-top: #ef4444;
    out property <color> pill-danger-bot: #dc2626;
    out property <color> pill-direct-top: #22c55e;
    out property <color> pill-direct-bot: #15803d;

    out property <string> mono-font: "monospace";
    out property <color> row-bg: dark ? #191c22 : #ffffff;
    out property <color> row-alt-bg: dark ? #1d2027 : #f8f9fb;
    out property <color> row-hover-bg: dark ? #252a34 : #eceff3;

    // Crisp WCAG AA typography & semantic statuses
    out property <brush> text-primary: dark ? #eceff4 : #151820;
    out property <brush> text-secondary: dark ? #9aa3b2 : #555e6e;
    out property <brush> text-muted: dark ? #6e7787 : #646e80;
    out property <brush> success-bg: dark ? #16a34a22 : #dcfce7;
    out property <color> success-fg: dark ? #22c55e : #15803d;
    out property <color> success-on-fill: dark ? #0b1220 : #ffffff;
    out property <color> success-border: dark ? #22c55e48 : #15803d40;
    out property <color> warn-bg: dark ? #f59e0b22 : #fef3c7;
    out property <color> warn-fg: dark ? #f59e0b : #b45309;
    out property <color> warn-border: dark ? #f59e0b48 : #b4530940;
    out property <brush> error-bg: dark ? #ef444422 : #fee2e2;
    out property <color> error-fg: dark ? #ef4444 : #dc2626;
    out property <color> error-border: dark ? #ef44444c : #dc262640;
    out property <color> offline-fg: dark ? #7c8596 : #646e80;

    // Semantic Latency Helpers
    public pure function latency-fg(ms: int, state: string) -> color {
        if (ms <= 0) {
            return (state == "timeout" || state == "unreachable" || state == "error" || state == "failed")
                ? error-fg : offline-fg;
        }
        if (ms < 80) { return lat-fast-fg; }
        if (ms < 180) { return lat-good-fg; }
        if (ms < 350) { return lat-mid-fg; }
        return lat-slow-fg;
    }

    public pure function latency-bg(ms: int, state: string) -> color {
        if (ms <= 0) {
            return (state == "timeout" || state == "unreachable" || state == "error" || state == "failed")
                ? (dark ? #ef444422 : #fee2e2) : inset-bg;
        }
        if (ms < 80) { return lat-fast-bg; }
        if (ms < 180) { return lat-good-bg; }
        if (ms < 350) { return lat-mid-bg; }
        return lat-slow-bg;
    }

    public pure function latency-bars(ms: int) -> int {
        if (ms <= 0) { return 0; }
        if (ms < 80) { return 4; }
        if (ms < 180) { return 3; }
        if (ms < 350) { return 2; }
        return 1;
    }

    // 8px-grid Spacing & Radius Scale
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 20px;
    out property <length> radius-xs: 5px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-card: 12px;
}
