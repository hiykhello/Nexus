import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { RouteRuleDraft } from "../types.slint";
import { NexusInput } from "glass_primitives.slint";
import { NexusSwitch } from "nexus_controls.slint";
import { ConditionRow, RuleActionBar, RuleChipButton } from "rule_builder_parts.slint";

export component RuleRouteTab inherits VerticalLayout {
    in-out property <string> primary-kind: "domain-suffix";
    in-out property <string> primary-value: "example.com";
    in-out property <string> target-outbound: "proxy";
    in property <string> status-text: "";
    in property <bool> status-ok: true;

    in-out property <bool> use-rule-set: false;
    in-out property <string> rule-set-name: "geosite-cn";
    in-out property <int> cond-count: 1;

    in-out property <string> c2-kind: "port";
    in-out property <string> c2-value: "443";
    in-out property <string> c3-kind: "network";
    in-out property <string> c3-value: "tcp";
    in-out property <string> c4-kind: "protocol";
    in-out property <string> c4-value: "tls";

    in-out property <string> action-kind: "route";
    in-out property <bool> tls-fragment: false;

    callback add-route-rule(RouteRuleDraft);

    pure function current-draft() -> RouteRuleDraft {
        {
            use-rule-set: root.use-rule-set,
            rule-set-name: root.rule-set-name,
            cond-count: root.cond-count,
            c1-kind: root.primary-kind,
            c1-value: root.primary-value,
            c2-kind: root.c2-kind,
            c2-value: root.c2-value,
            c3-kind: root.c3-kind,
            c3-value: root.c3-value,
            c4-kind: root.c4-kind,
            c4-value: root.c4-value,
            action-kind: root.action-kind,
            target-outbound: root.target-outbound,
            tls-fragment: root.tls-fragment,
        }
    }

    function remove-cond(idx: int) {
        if (root.cond-count <= 1) { return; }
        if (idx == 1) {
            root.primary-kind = root.c2-kind; root.primary-value = root.c2-value;
            root.c2-kind = root.c3-kind; root.c2-value = root.c3-value;
            root.c3-kind = root.c4-kind; root.c3-value = root.c4-value;
        } else if (idx == 2) {
            root.c2-kind = root.c3-kind; root.c2-value = root.c3-value;
            root.c3-kind = root.c4-kind; root.c3-value = root.c4-value;
        } else if (idx == 3) {
            root.c3-kind = root.c4-kind; root.c3-value = root.c4-value;
        }
        root.cond-count -= 1;
    }

    function reset-form() {
        root.use-rule-set = false;
        root.rule-set-name = "geosite-cn";
        root.cond-count = 1;
        root.primary-kind = "domain-suffix";
        root.primary-value = "example.com";
        root.action-kind = "route";
        root.target-outbound = "proxy";
        root.tls-fragment = false;
    }

    vertical-stretch: 0;
    alignment: start;

    Rectangle {
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-surface;


        VerticalLayout {
            alignment: start;
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            // 1. Match predicates
            VerticalLayout {
                spacing: Theme.space-sm;

                HorizontalLayout {
                    spacing: 6px;
                    RuleChipButton { label: I18n.t("多条件组合", "Predicates"); active: !root.use-rule-set; clicked => { root.use-rule-set = false; } }
                    RuleChipButton { label: I18n.t("规则集", "Rule Set"); active: root.use-rule-set; clicked => { root.use-rule-set = true; } }
                    Rectangle { horizontal-stretch: 1; }
                    if !root.use-rule-set && root.cond-count < 4 : RuleChipButton { label: I18n.t("+ 条件", "+ Cond"); clicked => { root.cond-count += 1; } }
                }

                if !root.use-rule-set : ConditionRow { kind <=> root.primary-kind; value <=> root.primary-value; removable: root.cond-count > 1; remove-requested => { root.remove-cond(1); } }
                if !root.use-rule-set && root.cond-count >= 2 : ConditionRow { kind <=> root.c2-kind; value <=> root.c2-value; removable: root.cond-count > 1; remove-requested => { root.remove-cond(2); } }
                if !root.use-rule-set && root.cond-count >= 3 : ConditionRow { kind <=> root.c3-kind; value <=> root.c3-value; removable: root.cond-count > 1; remove-requested => { root.remove-cond(3); } }
                if !root.use-rule-set && root.cond-count >= 4 : ConditionRow { kind <=> root.c4-kind; value <=> root.c4-value; removable: root.cond-count > 1; remove-requested => { root.remove-cond(4); } }

                if root.use-rule-set : HorizontalLayout {
                    spacing: Theme.space-sm;
                    Text { text: I18n.t("规则集名", "Rule Set"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                    NexusInput { min-width: 96px; horizontal-stretch: 1; mono: true; text <=> root.rule-set-name; placeholder-text: "geosite-cn / geoip-cn"; }
                }
            }

            Rectangle { height: 1px; background: Theme.hairline-subtle; }

            // 2. Action & outbound target
            VerticalLayout {
                spacing: Theme.space-sm;

                HorizontalLayout {
                    spacing: 6px;
                    RuleChipButton { label: I18n.t("代理 / 分流", "Route"); active: root.action-kind == "route"; clicked => { root.action-kind = "route"; } }
                    RuleChipButton { label: I18n.t("直连绕过", "Direct"); active: root.action-kind == "bypass"; clicked => { root.action-kind = "bypass"; } }
                    RuleChipButton { label: I18n.t("拦截拒绝", "Block"); warn-accent: true; active: root.action-kind == "reject"; clicked => { root.action-kind = "reject"; } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.action-kind != "reject" : NexusSwitch { text: I18n.t("TLS 分片", "TLS Fragment"); checked <=> root.tls-fragment; }
                }

                if root.action-kind == "route" : HorizontalLayout {
                    spacing: Theme.space-sm;
                    Text { text: I18n.t("目标出站", "Outbound"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
                    NexusInput { min-width: 96px; horizontal-stretch: 1; mono: true; text <=> root.target-outbound; placeholder-text: "proxy / direct / profile-id"; }
                }
            }

            Rectangle { height: 1px; background: Theme.hairline-subtle; }

            // 3. Action bar (Reset + Add Rule)
            RuleActionBar {
                button-text: I18n.t("添加规则", "Add Rule");
                status-text: root.status-text;
                status-ok: root.status-ok;
                commit => { root.add-route-rule(root.current-draft()); }
                reset => { root.reset-form(); }
            }
        }
    }
}
