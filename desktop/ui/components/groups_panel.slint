import { ScrollView } from "std-widgets.slint";
import { ControlInspectState } from "../control_inspect_state.slint";
import { I18n } from "../i18n.slint";
import { LayoutMetrics } from "../layout_metrics.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { OutboundGroupItem, OutboundMemberItem } from "../types.slint";
import { EmptyStateCard, NexusInput, NexusVScrollBar } from "nexus_primitives.slint";
import { GroupRail, GroupSummaryStrip } from "group_rail.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusButton } from "nexus_buttons.slint";

export component GroupsPanel inherits VerticalLayout {
    in property <length> window-width: 1040px;
    in property <[OutboundGroupItem]> groups: [];
    in property <[OutboundMemberItem]> members: [];
    in property <string> selected-group: "";
    in property <string> active-group-mode: "";
    in property <bool> active-group-auto: false;
    in property <string> active-group-node: "";
    in property <int> active-group-latency-ms: -1;
    in property <int> active-group-fastest-ms: -1;
    in property <int> active-group-healthy: 0;
    in property <int> active-group-total: 0;
    in-out property <string> member-filter: "";
    in-out property <string> member-sort: "default"; // "default" | "latency" | "name"
    in-out property <bool> hide-timeout: false;
    in property <bool> probing: false;

    callback choose-group(string);
    callback select-member(string, string);
    callback toggle-pin-member(string, string);
    callback sort-members(string);
    callback hide-timeout-changed(bool);
    callback reset-group-auto(string);
    callback probe-group(string);
    callback refresh-groups();
    callback filter-members(string);
    callback open-add-outbound();
    callback open-config-import();

    property <bool> is-wide: LayoutMetrics.is-wide-w(root.window-width);
    private property <length> list-scroll-y: 0px;
    property <string> sort-label:
        root.member-sort == "latency" ? I18n.t("按延迟", "Latency")
        : root.member-sort == "name" ? I18n.t("按名称", "Name")
        : I18n.t("默认排序", "Default");
    property <int> computed-p50-ms:
        root.members.length > 0 ? root.members[Math.floor((root.members.length - 1) / 2)].latency-ms : -1;

    spacing: Theme.space-md;

    // Non-wide Fluent 2 group chips
    if !root.is-wide && root.groups.length > 0 : FlexboxLayout {
        vertical-stretch: 0;
        padding-right: 14px;
        spacing: 6px;
        for g in root.groups : Rectangle {
            property <bool> is-current: g.tag == root.selected-group;
            height: 28px;
            border-radius: Theme.radius-sm;
            border-width: cg-fs.has-focus ? 2px : 1px;
            border-color: cg-fs.has-focus ? Theme.accent : (is-current ? Theme.pill-active-bot : Theme.card-border);
            background: is-current ? Theme.pill-active-bot : (group-ta.has-hover ? Theme.row-hover-bg : Theme.card-surface);

            accessible-role: button;
            accessible-label: g.tag;
            accessible-action-default => { root.list-scroll-y = 0px; root.choose-group(g.tag); }

            cg-fs := FocusScope {
                key-pressed(ev) => {
                    if (ev.text == Key.Return || ev.text == " ") {
                        root.list-scroll-y = 0px;
                        root.choose-group(g.tag);
                        return accept;
                    }
                    reject
                }
            }

            group-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.list-scroll-y = 0px; root.choose-group(g.tag); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                Text { text: g.tag; font-size: 12px; font-weight: is-current ? 700 : 600; color: is-current ? Theme.pill-active-fg : Theme.text-primary; vertical-alignment: center; }
                Text { text: "· \{g.active-member}"; font-size: 11px; color: is-current ? Theme.pill-active-fg.with-alpha(0.84) : Theme.text-secondary; vertical-alignment: center; }
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 20px;

        if root.is-wide && root.groups.length > 0 : GroupRail {
            groups: root.groups;
            selected-group: root.selected-group;
            healthy-count: root.active-group-healthy;
            total-count: root.active-group-total > 0 ? root.active-group-total : root.members.length;
            fastest-latency-ms: root.active-group-fastest-ms > 0 ? root.active-group-fastest-ms : root.active-group-latency-ms;
            p50-latency-ms: root.computed-p50-ms;
            choose-group(tag) => { root.list-scroll-y = 0px; root.choose-group(tag); }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 10px;

            HorizontalLayout {
                vertical-stretch: 0;
                padding-right: 14px;
                spacing: 8px;

                NexusInput {
                    horizontal-stretch: 1;
                    min-width: 110px;
                    search-icon: true;
                    text <=> root.member-filter;
                    placeholder-text: I18n.t("搜索节点...", "Filter nodes...");
                    edited(q) => { root.filter-members(q); }
                    accepted => { root.filter-members(root.member-filter); }
                }

                NexusButton {
                    has-icon: true;
                    icon: @image-url("../icons/sort.svg");
                    label: root.sort-label;
                    active: root.member-sort != "default";
                    clicked => {
                        let next = root.member-sort == "default" ? "latency"
                            : root.member-sort == "latency" ? "name" : "default";
                        root.member-sort = next;
                        root.sort-members(next);
                    }
                }

                NexusButton {
                    has-icon: true;
                    icon: @image-url("../icons/eye-off.svg");
                    label: I18n.t("隐藏超时", "Hide Err");
                    active: root.hide-timeout;
                    clicked => {
                        root.hide-timeout = !root.hide-timeout;
                        root.hide-timeout-changed(root.hide-timeout);
                    }
                }

                if root.selected-group != "" : NexusButton {
                    has-icon: true;
                    icon: @image-url("../icons/bolt.svg");
                    label: root.probing ? I18n.t("测速中...", "Probing...") : I18n.t("测速", "Probe");
                    active: root.probing;
                    clicked => { if (!root.probing) { root.probe-group(root.selected-group); } }
                }

                NexusButton {
                    has-icon: true;
                    icon: @image-url("../icons/plus.svg");
                    label: I18n.t("新增", "Add");
                    primary: true;
                    clicked => { root.open-add-outbound(); }
                }

                if root.selected-group != "" : IconActionButton {
                    icon: @image-url("../icons/sparkles.svg");
                    label: I18n.t("恢复自动选优", "Reset Auto");
                    clicked => { root.reset-group-auto(root.selected-group); }
                }

                IconActionButton {
                    icon: @image-url("../icons/refresh.svg");
                    label: I18n.t("刷新", "Refresh");
                    clicked => { root.refresh-groups(); }
                }
            }

            if root.is-wide && root.selected-group != "" : HorizontalLayout {
                vertical-stretch: 0;
                padding-right: 14px;
                GroupSummaryStrip {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    group-name: root.selected-group;
                    group-mode: root.active-group-mode;
                    auto-mode: root.active-group-auto;
                    active-node: root.active-group-node;
                    active-latency-ms: root.active-group-latency-ms;
                    p50-latency-ms: root.computed-p50-ms;
                    healthy-count: root.active-group-healthy;
                    total-count: root.active-group-total > 0 ? root.active-group-total : root.members.length;
                    probing: root.probing;
                }
            }

            if root.probing && (!root.is-wide || root.selected-group == "") : HorizontalLayout {
                vertical-stretch: 0;
                padding-right: 14px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 2px;
                    background: Theme.accent-soft;
                    clip: true;
                    Rectangle {
                        property <float> scan: Motion.reduced ? 0.35 : mod(animation-tick(), 1100ms) / 1100ms;
                        x: (parent.width + self.width) * self.scan - self.width;
                        width: parent.width * 0.32;
                        height: 2px;
                        background: Theme.accent;
                    }
                }
            }

            // Full-Width Fluent 2 Single-Level Node Table Card
            if root.members.length == 0 : HorizontalLayout {
                vertical-stretch: 1;
                padding-right: 14px;
                EmptyStateCard {
                    horizontal-stretch: 1;
                    icon: @image-url("../icons/groups.svg");
                    title: I18n.t("暂无可用节点", "No nodes yet");
                    subtitle: I18n.t("连接后自动同步策略组，或导入分享链接添加节点", "Connect to sync groups, or import a share link");
                    action-label: I18n.t("导入链接", "Import URI");
                    secondary-action-label: I18n.t("新增节点", "Add Node");
                    action-clicked => { root.open-config-import(); }
                    secondary-action-clicked => { root.open-add-outbound(); }
                }
            }

            if root.members.length > 0 : HorizontalLayout {
                vertical-stretch: 1;
                padding-right: 14px;

                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    background: Theme.card-surface;
                    clip: true;

                    VerticalLayout {
                        Rectangle {
                            vertical-stretch: 0;
                            height: 36px;
                            background: Theme.well-bg;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 12px;
                                Text { horizontal-stretch: 2; min-width: 0px; text: I18n.t("出口节点与传输协议", "EXIT NODE & TRANSPORT"); font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                                Text { width: 96px; text: I18n.t("状态", "STATE"); font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                                Text { width: 88px; text: I18n.t("延迟", "RTT"); font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 62px; text: I18n.t("操作", "ACTIONS"); font-size: 11px; font-weight: 700; color: Theme.text-muted; horizontal-alignment: right; vertical-alignment: center; }
                            }
                            Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.card-border; }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;

                            sv := ScrollView {
                                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                                content-y <=> root.list-scroll-y;
                                content-width: self.visible-width;
                                content-height: max(self.visible-height, ledger-col.preferred-height);

                                ledger-col := VerticalLayout {
                                    x: 0px;
                                    y: 0px;
                                    width: sv.visible-width;
                                    padding-right: root.members.length * 48px > sv.visible-height ? 12px : 0px;
                                    alignment: start;

                                    for m[idx] in root.members : Rectangle {
                                        property <bool> is-timeout: m.latency-ms <= 0 && (m.state == "timeout" || m.state == "unreachable" || m.state == "error" || m.state == "failed");
                                        property <color> lat-col: Theme.latency-fg(m.latency-ms, m.state);
                                        height: 48px;
                                        background: m.selected ? Theme.selected-bg : row-ta.has-hover ? Theme.row-hover-bg : Math.mod(idx, 2) == 0 ? transparent : Theme.row-alt-bg;

                                        row-ta := TouchArea {
                                            mouse-cursor: m.selected ? default : pointer;
                                            clicked => { root.select-member(root.selected-group, m.name); }
                                        }

                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 12px;

                                            HorizontalLayout {
                                                horizontal-stretch: 2;
                                                min-width: 0px;
                                                spacing: 10px;
                                                if m.selected : Image {
                                                    width: 14px; height: 14px; y: (parent.height - self.height) / 2;
                                                    source: @image-url("../icons/check.svg"); colorize: Theme.live-emerald;
                                                }
                                                if !m.selected : Rectangle {
                                                    width: 7px; height: 7px; y: (parent.height - self.height) / 2;
                                                    border-radius: 3.5px; background: m.latency-ms > 0 ? lat-col : Theme.offline-fg;
                                                }
                                                Text {
                                                    horizontal-stretch: 1;
                                                    min-width: 0px;
                                                    text: m.name;
                                                    font-size: 13.5px;
                                                    font-weight: m.selected ? 800 : 600;
                                                    color: Theme.text-primary;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                width: 96px;
                                                spacing: 6px;
                                                if m.overridden : Rectangle {
                                                    height: 20px;
                                                    y: (parent.height - self.height) / 2;
                                                    border-radius: Theme.radius-sm;
                                                    border-width: 1px;
                                                    border-color: Theme.warn-border;
                                                    background: Theme.warn-bg;
                                                    HorizontalLayout {
                                                        padding-left: 6px;
                                                        padding-right: 6px;
                                                        Text {
                                                            text: I18n.t("手动锁定", "Pinned");
                                                            font-size: 10px;
                                                            font-weight: 700;
                                                            color: Theme.warn-fg;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                if !m.overridden : Text {
                                                    text: m.selected ? I18n.t("当前活动", "Active")
                                                        : m.breaker-open ? I18n.t("熔断保护", "Tripped")
                                                        : is-timeout ? I18n.t("不可达", "Timeout")
                                                        : I18n.t("就绪", "Ready");
                                                    font-size: 12px;
                                                    font-weight: m.selected ? 700 : 500;
                                                    color: m.selected ? Theme.live-emerald : (is-timeout || m.breaker-open) ? Theme.error-fg : Theme.text-secondary;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }

                                            Text {
                                                width: 88px;
                                                text: m.latency-ms > 0 ? "\{m.latency-ms} ms" : is-timeout ? I18n.t("超时", "Timeout") : "--";
                                                font-size: 14px;
                                                font-weight: 800;
                                                font-family: Theme.mono-font;
                                                color: lat-col;
                                                horizontal-alignment: right;
                                                vertical-alignment: center;
                                            }

                                            HorizontalLayout {
                                                width: 62px;
                                                spacing: 4px;
                                                alignment: end;
                                                VerticalLayout {
                                                    alignment: center;
                                                    IconActionButton {
                                                        size: 26px;
                                                        icon: @image-url("../icons/bolt.svg");
                                                        label: I18n.t("单节点测速", "Probe Node");
                                                        clicked => { ControlInspectState.probe-member(root.selected-group, m.name); }
                                                    }
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    IconActionButton {
                                                        size: 26px;
                                                        icon: m.pinned ? @image-url("../icons/star-filled.svg") : @image-url("../icons/star.svg");
                                                        label: m.pinned ? I18n.t("取消收藏", "Unpin") : I18n.t("收藏置顶", "Pin");
                                                        active: m.pinned;
                                                        clicked => { root.toggle-pin-member(root.selected-group, m.name); }
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle {
                                            x: 0px;
                                            y: parent.height - 1px;
                                            width: 100%;
                                            height: 1px;
                                            background: Theme.hairline-subtle;
                                        }
                                    }
                                }
                            }

                            NexusVScrollBar {
                                x: parent.width - self.width - 1px;
                                y: 2px;
                                height: max(0px, parent.height - 4px);
                                viewport-size: sv.visible-height;
                                content-size: sv.content-height;
                                scroll-pos <=> sv.content-y;
                            }
                        }
                    }
                }
            }
        }
    }
}
