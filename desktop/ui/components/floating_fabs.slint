import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { GlassSpeculum } from "glass_primitives.slint";

export component FloatingProbeFab inherits Rectangle {
    in property <bool> probing: false;
    callback clicked();

    width: probe-row.preferred-width;
    height: 42px;
    border-radius: 21px;
    border-width: 1px;
    border-color: Theme.pill-active-top.brighter(0.24);
    background: ta.pressed
        ? @linear-gradient(135deg, Theme.pill-active-bot 0%, Theme.pill-active-bot.darker(0.14) 100%)
        : ta.has-hover
            ? @linear-gradient(135deg, Theme.pill-active-top.brighter(0.10) 0%, Theme.pill-active-bot.brighter(0.06) 100%)
            : @linear-gradient(135deg, Theme.pill-active-top 0%, Theme.pill-active-bot 100%);
    drop-shadow-blur: root.probing ? 24px : 20px;
    drop-shadow-offset-y: 5px;
    drop-shadow-color: Theme.pill-active-bot.with-alpha(Theme.dark ? 0.56 : 0.36);
    transform-scale: !root.probing && ta.pressed ? 0.94 : 1.0;
    clip: true;
    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.34, 1.56, 0.64, 1.0); }

    accessible-role: button;
    accessible-label: root.probing ? I18n.t("测速中", "Probing") : I18n.t("一键测速", "Probe All");
    accessible-action-default => { if (!root.probing) { root.clicked(); } }

    GlassSpeculum { corner-inset: 14px; }

    if root.probing && !Motion.reduced : Rectangle {
        property <float> sw: mod(animation-tick(), 1100ms) / 1100ms;
        x: (parent.width + self.width) * self.sw - self.width;
        y: 0px; width: 46px; height: 2px;
        background: Theme.pill-active-fg.with-alpha(0.75);
    }

    ta := TouchArea {
        enabled: !root.probing;
        mouse-cursor: root.probing ? default : pointer;
        clicked => { root.clicked(); }
    }

    probe-row := HorizontalLayout {
        padding-left: 16px; padding-right: 18px; spacing: 7px;
        Image {
            width: 15px; height: 15px; y: (parent.height - self.height) / 2;
            source: root.probing ? @image-url("../icons/loader.svg") : @image-url("../icons/bolt.svg");
            colorize: Theme.pill-active-fg;
            transform-rotation: root.probing && !Motion.reduced ? 360deg * (mod(animation-tick(), 900ms) / 900ms) : 0deg;
        }
        Text {
            text: root.probing ? I18n.t("测速中", "Probing") : I18n.t("一键测速", "Probe All");
            font-size: 13px; font-weight: 700; color: Theme.pill-active-fg; vertical-alignment: center;
        }
    }
}
