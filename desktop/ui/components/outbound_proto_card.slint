import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { NexusInput } from "glass_primitives.slint";
import { NexusChip } from "nexus_buttons.slint";
import { NexusSwitch } from "nexus_controls.slint";
import { NexusSelect } from "nexus_select.slint";

export component OutboundProtoCard inherits VerticalLayout {
    in-out property <string> proto: "vless";
    in-out property <string> tag: "hk-01";
    in-out property <string> host: "hk01.example.net";
    in-out property <string> port: "443";
    in-out property <string> secret: "";
    in-out property <string> uuid-str: "";
    in-out property <string> username: "";
    in-out property <string> flow: "xtls-rprx-vision";
    in-out property <string> hy2-ports: "";
    in-out property <string> hy2-salamander: "";
    in-out property <string> hy2-up-mbps: "";
    in-out property <string> hy2-down-mbps: "";
    in-out property <string> tuic-cc: "bbr";
    in-out property <bool> tuic-udp-over-stream: false;
    in-out property <string> ss-method: "2022-blake3-aes-128-gcm";
    in-out property <int> snell-ver: 5;
    in-out property <string> snell-obfs: "none";
    in-out property <string> snell-obfs-host: "";
    in-out property <string> naive-proto: "h2";
    in-out property <string> ssh-host-sha: "";

    alignment: start;
    spacing: Theme.space-sm;

    Text { text: I18n.t("协议与凭据", "Protocol & Credentials"); font-size: 13px; font-weight: 700; color: Theme.text-primary; }

    FlexboxLayout {
        spacing: 6px;
        NexusChip { chip-height: 26px; label: "vless"; active: root.proto == "vless"; clicked => { root.proto = "vless"; } }
        NexusChip { chip-height: 26px; label: "trojan"; active: root.proto == "trojan"; clicked => { root.proto = "trojan"; } }
        NexusChip { chip-height: 26px; label: "hysteria2"; active: root.proto == "hysteria2"; clicked => { root.proto = "hysteria2"; } }
        NexusChip { chip-height: 26px; label: "tuic"; active: root.proto == "tuic"; clicked => { root.proto = "tuic"; } }
        NexusChip { chip-height: 26px; label: "anytls"; active: root.proto == "anytls"; clicked => { root.proto = "anytls"; } }
        NexusChip { chip-height: 26px; label: "shadowsocks"; active: root.proto == "shadowsocks"; clicked => { root.proto = "shadowsocks"; } }
        NexusChip { chip-height: 26px; label: "snell"; active: root.proto == "snell"; clicked => { root.proto = "snell"; } }
        NexusChip { chip-height: 26px; label: "naive"; active: root.proto == "naive"; clicked => { root.proto = "naive"; } }
        NexusChip { chip-height: 26px; label: "ssh"; active: root.proto == "ssh"; clicked => { root.proto = "ssh"; } }
        NexusChip { chip-height: 26px; label: "http-connect"; active: root.proto == "http-connect"; clicked => { root.proto = "http-connect"; } }
    }

    HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("名称", "Name"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 72px; horizontal-stretch: 1; mono: true; text <=> root.tag; placeholder-text: "hk-01"; }
        Text { text: I18n.t("端口", "Port"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
        NexusInput { width: 68px; mono: true; text <=> root.port; placeholder-text: "443"; }
    }

    HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("服务器", "Server"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 96px; horizontal-stretch: 1; mono: true; text <=> root.host; placeholder-text: "edge.example.net"; }
    }

    if root.proto == "vless" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: "UUID"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 96px; horizontal-stretch: 1; mono: true; text <=> root.secret; placeholder-text: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"; }
    }

    if root.proto == "vless" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: "Flow"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusSelect { horizontal-stretch: 1; options: ["none", "xtls-rprx-vision"]; current-value <=> root.flow; }
    }

    if root.proto == "trojan" || root.proto == "anytls" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("密码", "Password"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 96px; horizontal-stretch: 1; mono: true; password: true; text <=> root.secret; placeholder-text: I18n.t("输入节点密码", "Enter password"); }
    }

    if root.proto == "hysteria2" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("密码", "Password"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 72px; horizontal-stretch: 1; mono: true; password: true; text <=> root.secret; placeholder-text: I18n.t("认证密码", "Auth password"); }
        Text { text: I18n.t("跳端口", "Ports"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
        NexusInput { width: 92px; mono: true; text <=> root.hy2-ports; placeholder-text: "20000-40000"; }
    }

    if root.proto == "hysteria2" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("混淆", "Obfs"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 56px; horizontal-stretch: 1; mono: true; password: true; text <=> root.hy2-salamander; placeholder-text: I18n.t("可选", "Optional"); }
        Text { text: "Up"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
        NexusInput { width: 58px; mono: true; text <=> root.hy2-up-mbps; placeholder-text: "100"; }
        Text { text: "Down"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
        NexusInput { width: 58px; mono: true; text <=> root.hy2-down-mbps; placeholder-text: "200"; }
    }

    if root.proto == "tuic" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: "UUID"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 72px; horizontal-stretch: 1; mono: true; text <=> root.uuid-str; placeholder-text: "TUIC UUID"; }
        Text { text: I18n.t("密码", "Password"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
        NexusInput { min-width: 72px; horizontal-stretch: 1; mono: true; password: true; text <=> root.secret; placeholder-text: I18n.t("输入密码", "Password"); }
    }

    if root.proto == "tuic" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("拥塞", "CC"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusSelect { width: 92px; options: ["bbr", "cubic", "reno"]; current-value <=> root.tuic-cc; }
        Rectangle { width: 6px; }
        NexusSwitch { text: "UDP over Stream"; checked <=> root.tuic-udp-over-stream; }
        Rectangle { horizontal-stretch: 1; }
    }

    if root.proto == "shadowsocks" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("加密", "Method"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusSelect { horizontal-stretch: 1; options: ["2022-blake3-aes-128-gcm", "2022-blake3-aes-256-gcm", "2022-blake3-chacha20-poly1305"]; current-value <=> root.ss-method; }
    }

    if root.proto == "shadowsocks" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("密钥", "Key"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 80px; horizontal-stretch: 1; mono: true; password: true; text <=> root.secret; placeholder-text: I18n.t("Base64 密钥", "Base64 key"); }
    }

    if root.proto == "snell" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("版本", "Ver"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusChip { chip-height: 26px; label: "v4"; active: root.snell-ver == 4; clicked => { root.snell-ver = 4; } }
        NexusChip { chip-height: 26px; label: "v5"; active: root.snell-ver == 5; clicked => { root.snell-ver = 5; } }
        Text { text: "PSK"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
        NexusInput { min-width: 72px; horizontal-stretch: 1; mono: true; password: true; text <=> root.secret; placeholder-text: I18n.t("输入 PSK", "Pre-shared key"); }
    }

    if root.proto == "snell" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("混淆", "Obfs"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusChip { chip-height: 26px; label: "none"; active: root.snell-obfs == "none"; clicked => { root.snell-obfs = "none"; } }
        NexusChip { chip-height: 26px; label: "http"; active: root.snell-obfs == "http"; clicked => { root.snell-obfs = "http"; } }
        if root.snell-obfs == "http" : NexusInput { min-width: 72px; horizontal-stretch: 1; mono: true; text <=> root.snell-obfs-host; placeholder-text: "obfs host"; }
        Rectangle { horizontal-stretch: 1; }
    }

    if root.proto == "naive" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("承载", "Proto"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusChip { chip-height: 26px; label: "h2"; active: root.naive-proto == "h2"; clicked => { root.naive-proto = "h2"; } }
        NexusChip { chip-height: 26px; label: "h3"; active: root.naive-proto == "h3"; clicked => { root.naive-proto = "h3"; } }
        Rectangle { horizontal-stretch: 1; }
    }

    if root.proto == "naive" || root.proto == "http-connect" || root.proto == "ssh" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: I18n.t("用户", "User"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { width: 78px; mono: true; text <=> root.username; placeholder-text: "user"; }
        Text { text: root.proto == "ssh" ? I18n.t("密码/私钥", "Pass/Key") : I18n.t("密码", "Password"); font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; }
        NexusInput { min-width: 72px; horizontal-stretch: 1; mono: true; password: true; text <=> root.secret; placeholder-text: root.proto == "ssh" ? I18n.t("密码或 PEM 私钥", "Password or PEM key") : I18n.t("输入密码", "Password"); }
    }

    if root.proto == "ssh" : HorizontalLayout {
        spacing: 6px;
        Text { width: 58px; text: "HostKey"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
        NexusInput { min-width: 96px; horizontal-stretch: 1; mono: true; text <=> root.ssh-host-sha; placeholder-text: I18n.t("必填 SHA-256 指纹", "Required SHA-256"); }
    }
}
