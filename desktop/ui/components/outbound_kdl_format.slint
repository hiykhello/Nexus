export global OutboundKdl {
    pure function q(s: string) -> string {
        "\"" + s + "\""
    }

    pure function tls-block(
        proto: string,
        host: string,
        sni: string,
        fp: string,
        cert-sha: string,
        verify-tls: bool,
        use-reality: bool,
        pub-key: string,
        short-id: string,
    ) -> string {
        let server-name = sni != "" ? sni : host;
        let can-reality = use-reality && (proto == "vless" || proto == "trojan" || proto == "anytls");
        let sni-line = "        server-name " + q(server-name) + "\n";
        let fp-line = fp != "default" ? "        fingerprint " + q(fp) + "\n" : "";
        let sha-line = cert-sha != "" ? "        certificate-sha256 " + q(cert-sha) + "\n" : "";
        let ver-line = (proto == "naive" || proto == "http-connect")
            ? "        verify " + (verify-tls ? "#true" : "#false") + "\n"
            : (!verify-tls ? "        verify #false\n" : "");
        let real-line = can-reality
            ? "        reality {\n            public-key " + q(pub-key != "" ? pub-key : "<reality-public-key>") + "\n"
                + (short-id != "" ? "            short-id " + q(short-id) + "\n" : "")
                + "        }\n"
            : "";
        return "    tls {\n" + sni-line + fp-line + sha-line + ver-line + real-line + "    }\n";
    }

    pure function transport-block(proto: string, transport: string, path: string, host-hdr: string, xhttp-mode: string) -> string {
        let supported = proto == "vless" || proto == "trojan" || proto == "anytls";
        if (!supported || transport == "tcp") {
            return "";
        }
        let body = transport == "grpc"
            ? (path != "" ? "        service-name " + q(path) + "\n" : "")
                + (host-hdr != "" ? "        authority " + q(host-hdr) + "\n" : "")
            : (path != "" ? "        path " + q(path) + "\n" : "")
                + (host-hdr != "" ? "        host " + q(host-hdr) + "\n" : "")
                + (transport == "xhttp" && xhttp-mode != "" ? "        mode " + q(xhttp-mode) + "\n" : "");
        return "    transport " + q(transport) + " {\n" + body + "    }\n";
    }

    pure function hy2-quic-block(ports: string, salamander: string, send-bps: string, recv-bps: string) -> string {
        let p-line = ports != "" ? "        ports " + q(ports) + "\n" : "";
        let s-line = salamander != "" ? "        salamander-password-file " + q(salamander) + "\n" : "";
        let up-line = send-bps != "" ? "        send-bps " + send-bps + "\n" : "";
        let dn-line = recv-bps != "" ? "        receive-bps " + recv-bps + "\n" : "";
        if (p-line == "" && s-line == "" && up-line == "" && dn-line == "") {
            return "";
        }
        return "    quic {\n" + p-line + s-line + up-line + dn-line + "    }\n";
    }

    pure function dial-lines(detour: string, bind-if: string, mark: string, tfo: bool, mptcp: bool, keepalive: bool) -> string {
        let d-line = detour != "" ? "    detour " + q(detour) + "\n" : "";
        let if-line = bind-if != "" ? "    bind-interface " + q(bind-if) + "\n" : "";
        let mk-line = mark != "" ? "    routing-mark " + mark + "\n" : "";
        let tfo-line = tfo ? "    tcp-fast-open #true\n" : "";
        let mp-line = mptcp ? "    multipath-tcp #true\n" : "";
        let ka-line = keepalive ? "    tcp-keepalive #true\n" : "";
        return d-line + if-line + mk-line + tfo-line + mp-line + ka-line;
    }

    public pure function build(
        proto: string, tag: string, host: string, port: string,
        secret-file: string, uuid-str: string, username: string, flow: string,
        hy2-ports: string, hy2-salamander: string, hy2-up-bps: string, hy2-down-bps: string,
        tuic-cc: string, tuic-udp-mode: string,
        ss-method: string, snell-ver: int, snell-obfs: string, snell-obfs-host: string,
        naive-proto: string, naive-padding: bool, http-ver: string, http-udp: bool,
        ssh-host-sha: string,
        sni: string, fp: string, cert-sha: string, verify-tls: bool, use-reality: bool, reality-pbk: string, reality-sid: string,
        transport: string, t-path: string, t-host: string, xhttp-mode: string,
        detour: string, bind-if: string, routing-mark: string, tfo: bool, mptcp: bool, keepalive: bool,
    ) -> string {
        let t = tag != "" ? tag : "node-01";
        let h = host != "" ? host : "edge.example.net";
        let p = port != "" ? port : "443";
        let sec = secret-file != "" ? secret-file : "secrets/" + t + ".secret";
        let srv = "    server host=" + q(h) + " port=" + p + "\n";
        let head = "outbound " + q(t) + " type=" + q(proto) + " {\n";
        let dial = dial-lines(detour, bind-if, routing-mark, tfo, mptcp, keepalive);

        if (proto == "shadowsocks") {
            return head + srv + "    method " + q(ss-method) + "\n    key-file " + q(sec) + "\n" + dial + "}";
        }
        if (proto == "snell") {
            let obfs-block = snell-obfs == "http"
                ? "    obfs \"http\" {\n" + (snell-obfs-host != "" ? "        host " + q(snell-obfs-host) + "\n" : "") + "    }\n"
                : "";
            return head + srv + "    version " + (snell-ver == 4 ? "4" : "5") + "\n    psk-file " + q(sec) + "\n" + obfs-block + dial + "}";
        }
        if (proto == "ssh") {
            let usr = username != "" ? "    user " + q(username) + "\n" : "";
            let key = "    private-key-file " + q(sec) + "\n";
            let hk = ssh-host-sha != "" ? "    host-key-sha256 " + q(ssh-host-sha) + "\n" : "";
            return head + srv + usr + key + hk + dial + "}";
        }

        let tls = tls-block(proto, h, sni, fp, cert-sha, verify-tls, use-reality, reality-pbk, reality-sid);
        if (proto == "naive") {
            let u = username != "" ? username : "user";
            let auth = "    authentication username=" + q(u) + " password-file=" + q(sec) + "\n";
            return head + "    protocol " + q(naive-proto) + "\n" + srv + auth + tls
                + "    padding " + (naive-padding ? "#true" : "#false") + "\n" + dial + "}";
        }
        if (proto == "http-connect") {
            let hv = "    http-version " + q(http-ver) + "\n";
            let auth = username != "" ? "    authentication username=" + q(username) + " password-file=" + q(sec) + "\n" : "";
            let u-line = http-udp ? "    udp #true\n" : "";
            return head + hv + srv + auth + u-line + tls + dial + "}";
        }
        if (proto == "tuic") {
            let u-line = uuid-str != "" ? "        uuid " + q(uuid-str) + "\n" : "";
            let auth = "    authentication {\n" + u-line + "        password-file " + q(sec) + "\n    }\n";
            let cc = "    congestion-control " + q(tuic-cc) + "\n    udp-relay-mode " + q(tuic-udp-mode) + "\n";
            return head + srv + auth + cc + tls + dial + "}";
        }
        if (proto == "hysteria2") {
            let auth = "    authentication {\n        password-file " + q(sec) + "\n    }\n";
            let qblock = hy2-quic-block(hy2-ports, hy2-salamander, hy2-up-bps, hy2-down-bps);
            return head + srv + auth + qblock + tls + dial + "}";
        }

        let auth = proto == "vless"
            ? "    authentication {\n        uuid-file " + q(sec) + "\n    }\n"
                + (flow != "none" ? "    flow " + q(flow) + "\n" : "")
            : "    authentication {\n        password-file " + q(sec) + "\n    }\n";
        let trans = transport-block(proto, transport, t-path, t-host, xhttp-mode);
        return head + srv + auth + tls + trans + dial + "}";
    }
}
