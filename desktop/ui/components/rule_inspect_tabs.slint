import { ListView } from "std-widgets.slint";
import { ControlInspectState } from "../control_inspect_state.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { GlassSpeculum, NexusInput } from "glass_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusSelect } from "nexus_select.slint";

component InspectPillButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 0;
    height: 30px;
    border-radius: 15px;
    border-width: 1px;
    border-color: root.primary ? Theme.pill-active-top.brighter(0.20) : ta.has-hover && root.enabled ? Theme.selected-border : Theme.card-border;
    background: root.primary
        ? (ta.pressed
            ? @linear-gradient(135deg, Theme.pill-active-bot 0%, Theme.pill-active-bot.darker(0.14) 100%)
            : @linear-gradient(135deg, Theme.pill-active-top 0%, Theme.pill-active-bot 100%))
        : ta.pressed && root.enabled ? Theme.nav-active-bg : ta.has-hover && root.enabled ? Theme.row-hover-bg : Theme.well-bg;
    opacity: root.enabled ? 1.0 : 0.50;
    transform-scale: ta.pressed && root.enabled ? 0.96 : 1.0;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 5px;
        Image {
            width: 13px; height: 13px; y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: root.primary ? Theme.pill-active-fg : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        }
        Text {
            text: root.label; font-size: 12px; font-weight: root.primary ? 700 : 600;
            color: root.primary ? Theme.pill-active-fg : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
}

export component LiveRulesTab inherits VerticalLayout {
    spacing: Theme.space-sm;

    HorizontalLayout {
        spacing: Theme.space-sm;
        NexusInput {
            horizontal-stretch: 1; min-width: 120px; search-icon: true;
            text <=> ControlInspectState.rules-filter;
            placeholder-text: I18n.t("过滤运行中规则 (类型、动作、目标、摘要)...", "Filter active rules (type, action, target, summary)...");
            edited(q) => { ControlInspectState.filter-live-rules(q); }
            accepted => { ControlInspectState.filter-live-rules(ControlInspectState.rules-filter); }
        }
        InspectPillButton {
            icon: ControlInspectState.rules-loading ? @image-url("../icons/loader.svg") : @image-url("../icons/refresh.svg");
            label: ControlInspectState.rules-loading ? I18n.t("读取中...", "Loading...") : I18n.t("刷新运行规则", "Refresh Rules");
            primary: true;
            enabled: !ControlInspectState.rules-loading;
            clicked => { ControlInspectState.refresh-live-rules(); }
        }
    }

    if ControlInspectState.rules-error != "" : Rectangle {
        border-radius: Theme.radius-sm; border-width: 1px;
        border-color: Theme.error-border; background: Theme.error-bg;
        HorizontalLayout {
            padding: 8px;
            Text { text: ControlInspectState.rules-error; font-size: 11px; font-weight: 600; color: Theme.error-fg; wrap: word-wrap; }
        }
    }

    Rectangle {
        height: 316px;
        border-radius: 14px; border-width: 1px;
        border-color: Theme.card-border; background: Theme.card-surface;
        clip: true;
        GlassSpeculum { corner-inset: 12px; }

        VerticalLayout {
            Rectangle {
                height: 30px; background: Theme.well-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                    Text { width: 34px; text: "#"; font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { width: 108px; text: I18n.t("匹配类型", "TYPE"); font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { width: 64px; text: I18n.t("动作", "ACTION"); font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { width: 84px; text: I18n.t("目标", "TARGET"); font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; text: I18n.t("规则摘要", "SUMMARY"); font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                }
                Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.hairline-subtle; }
            }

            if ControlInspectState.live-rules.length == 0 : VerticalLayout {
                vertical-stretch: 1; alignment: center; padding: 16px; spacing: 6px;
                Text {
                    text: I18n.t("暂无运行中规则数据", "No live rules loaded");
                    font-size: 13px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center;
                }
                Text {
                    text: I18n.t("启动核心后点击「刷新运行规则」从 GET /v1/rules 获取实时规则表", "Start Core and click Refresh Rules to inspect live GET /v1/rules entries");
                    font-size: 11px; color: Theme.text-muted; horizontal-alignment: center; wrap: word-wrap;
                }
            }

            if ControlInspectState.live-rules.length > 0 : rlv := ListView {
                vertical-stretch: 1;
                for r[idx] in ControlInspectState.live-rules : Rectangle {
                    width: rlv.visible-width;
                    height: 34px;
                    background: Math.mod(idx, 2) == 0 ? Theme.row-bg : Theme.row-alt-bg;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Text { width: 34px; text: "\{r.index + 1}"; font-size: 11px; font-family: Theme.mono-font; color: Theme.text-muted; vertical-alignment: center; }
                        Text { width: 108px; text: r.rule-type; font-size: 11px; font-weight: 600; font-family: Theme.mono-font; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                        Text {
                            width: 64px; text: r.action; font-size: 11px; font-weight: 700; font-family: Theme.mono-font;
                            color: r.action == "reject" || r.action == "block" ? Theme.error-fg : r.action == "direct" ? Theme.proto-direct-fg : Theme.nav-active-fg;
                            vertical-alignment: center; overflow: elide;
                        }
                        Text { width: 84px; text: r.target != "" ? r.target : "-"; font-size: 11px; font-family: Theme.mono-font; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                        Text { horizontal-stretch: 1; min-width: 0px; text: r.summary; font-size: 11px; font-family: Theme.mono-font; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
    }
}

export component LiveDnsQueryTab inherits VerticalLayout {
    spacing: Theme.space-sm;

    Rectangle {
        border-radius: 14px; border-width: 1px;
        border-color: Theme.card-border; background: Theme.card-surface;
        GlassSpeculum { corner-inset: 12px; }

        VerticalLayout {
            padding: 12px; spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                NexusInput {
                    horizontal-stretch: 1; min-width: 140px; mono: true;
                    text <=> ControlInspectState.dns-query-name;
                    placeholder-text: I18n.t("查询域名 (如 example.com)", "Domain to query (e.g. example.com)");
                    accepted => { ControlInspectState.run-dns-query(); }
                }
                NexusSelect {
                    width: 96px;
                    options: ["A", "AAAA", "CNAME", "TXT", "HTTPS", "SVCB", "MX", "SRV"];
                    current-value <=> ControlInspectState.dns-query-type;
                }
                NexusInput {
                    width: 126px; mono: true;
                    text <=> ControlInspectState.dns-query-server;
                    placeholder-text: I18n.t("上游标签(可选)", "Server (opt)");
                    accepted => { ControlInspectState.run-dns-query(); }
                }
                InspectPillButton {
                    icon: ControlInspectState.dns-query-busy ? @image-url("../icons/loader.svg") : @image-url("../icons/bolt.svg");
                    label: ControlInspectState.dns-query-busy ? I18n.t("解析中...", "Querying...") : I18n.t("立即解析", "Query");
                    primary: true;
                    enabled: !ControlInspectState.dns-query-busy && ControlInspectState.dns-query-name != "";
                    clicked => { ControlInspectState.run-dns-query(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                InspectPillButton {
                    icon: @image-url("../icons/trash.svg");
                    label: I18n.t("清空 FakeIP 映射", "Flush FakeIP");
                    enabled: !ControlInspectState.cache-action-busy;
                    clicked => { ControlInspectState.flush-fakeip(); }
                }
                InspectPillButton {
                    icon: @image-url("../icons/refresh.svg");
                    label: I18n.t("清除 DNS 缓存", "Clear DNS Cache");
                    enabled: !ControlInspectState.cache-action-busy;
                    clicked => { ControlInspectState.clear-dns-cache(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if ControlInspectState.dns-query-rcode != "" : HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 22px; y: (parent.height - self.height) / 2; border-radius: 6px;
                        background: ControlInspectState.dns-query-rcode == "NOERROR" ? Theme.success-bg : Theme.warn-bg;
                        HorizontalLayout {
                            padding-left: 7px; padding-right: 7px;
                            Text {
                                text: ControlInspectState.dns-query-rcode;
                                font-size: 10px; font-weight: 700; font-family: Theme.mono-font;
                                color: ControlInspectState.dns-query-rcode == "NOERROR" ? Theme.success-fg : Theme.warn-fg;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if ControlInspectState.dns-query-elapsed-ms >= 0 : Text {
                        text: "\{ControlInspectState.dns-query-elapsed-ms} ms · TTL \{ControlInspectState.dns-query-ttl}s";
                        font-size: 11px; font-weight: 600; font-family: Theme.mono-font;
                        color: Theme.text-secondary; vertical-alignment: center;
                    }
                }
            }

            if ControlInspectState.cache-action-status != "" : Text {
                text: ControlInspectState.cache-action-status;
                font-size: 11px; font-family: Theme.mono-font;
                color: ControlInspectState.cache-action-ok ? Theme.success-fg : Theme.error-fg;
                overflow: elide;
            }
            if ControlInspectState.dns-query-error != "" : Rectangle {
                border-radius: Theme.radius-sm; border-width: 1px;
                border-color: Theme.error-border; background: Theme.error-bg;
                HorizontalLayout {
                    padding: 8px;
                    Text { text: ControlInspectState.dns-query-error; font-size: 11px; font-weight: 600; color: Theme.error-fg; wrap: word-wrap; }
                }
            }
        }
    }

    Rectangle {
        height: 214px;
        border-radius: 14px; border-width: 1px;
        border-color: Theme.card-border; background: Theme.card-surface;
        clip: true;
        GlassSpeculum { corner-inset: 12px; }

        VerticalLayout {
            Rectangle {
                height: 28px; background: Theme.well-bg;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                    Text { width: 150px; text: I18n.t("记录名", "NAME"); font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { width: 58px; text: I18n.t("类型", "TYPE"); font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { width: 58px; text: "TTL"; font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; text: I18n.t("解析结果 (RDATA)", "ANSWER DATA"); font-size: 10px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                }
                Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.hairline-subtle; }
            }

            if ControlInspectState.dns-answers.length == 0 : VerticalLayout {
                vertical-stretch: 1; alignment: center; padding: 14px;
                Text {
                    text: ControlInspectState.dns-query-rcode != ""
                        ? I18n.t("返回空应答记录", "Query completed with 0 answer records")
                        : I18n.t("输入域名并点击「立即解析」调用 GET /v1/dns/query 实测核心 DNS 管线", "Enter a domain and click Query to test live GET /v1/dns/query resolution");
                    font-size: 11px; color: Theme.text-muted; horizontal-alignment: center; wrap: word-wrap;
                }
            }

            if ControlInspectState.dns-answers.length > 0 : dlv := ListView {
                vertical-stretch: 1;
                for ans[idx] in ControlInspectState.dns-answers : Rectangle {
                    width: dlv.visible-width;
                    height: 32px;
                    background: Math.mod(idx, 2) == 0 ? Theme.row-bg : Theme.row-alt-bg;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Text { width: 150px; text: ans.name; font-size: 11px; font-family: Theme.mono-font; color: Theme.text-secondary; vertical-alignment: center; overflow: elide; }
                        Text { width: 58px; text: ans.rr-type; font-size: 11px; font-weight: 700; font-family: Theme.mono-font; color: Theme.nav-active-fg; vertical-alignment: center; }
                        Text { width: 58px; text: "\{ans.ttl}s"; font-size: 11px; font-family: Theme.mono-font; color: Theme.text-muted; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; min-width: 0px; text: ans.data; font-size: 11px; font-weight: 600; font-family: Theme.mono-font; color: Theme.text-primary; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
    }
}
