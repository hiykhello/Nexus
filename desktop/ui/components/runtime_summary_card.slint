import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { GlassSpeculum } from "glass_primitives.slint";

component OpsActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();

    height: 32px;
    horizontal-stretch: 1;
    min-width: 0px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color:
        !root.enabled ? Theme.well-border
        : root.danger && ta.has-hover ? Theme.error-border
        : ta.has-hover ? Theme.selected-border
        : Theme.card-border;
    background:
        !root.enabled ? Theme.well-bg
        : root.danger && ta.has-hover ? Theme.error-bg
        : ta.has-hover ? Theme.row-hover-bg
        : Theme.well-bg;
    opacity: root.enabled ? 1.0 : 0.48;
    transform-scale: root.enabled && ta.pressed ? 0.97 : 1.0;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;

        Image {
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize:
                root.danger && ta.has-hover ? Theme.error-fg
                : ta.has-hover ? Theme.nav-active-fg
                : Theme.text-secondary;
        }
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color:
                root.danger && ta.has-hover ? Theme.error-fg
                : ta.has-hover ? Theme.nav-active-fg
                : Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Bento Card: Link Quality Indicator + Cumulative DL/UL Split Bar + 2x2 Quick Actions
export component RuntimeSummaryCard inherits Rectangle {
    in property <bool> core-running: false;
    in property <string> active-node: "";
    in property <int> active-node-latency-ms: -1;
    in property <string> download-total: "0 B";
    in property <string> upload-total: "0 B";
    in property <float> total-down-ratio: 0.85;

    callback probe-active-group();
    callback reload-config();
    callback clear-cache();
    callback open-logs();
    callback open-groups();

    property <bool> is-timeout: root.core-running && root.active-node != "" && root.active-node-latency-ms == 0;
    property <int> bars: root.core-running ? Theme.latency-bars(root.active-node-latency-ms) : 0;
    property <color> qual-color:
        !root.core-running ? Theme.offline-fg
        : Theme.latency-fg(root.active-node-latency-ms, root.is-timeout ? "timeout" : "healthy");

    property <string> quality-label:
        !root.core-running ? I18n.t("待连接", "Idle")
        : root.is-timeout ? I18n.t("连接波动", "Timeout")
        : root.active-node-latency-ms <= 0 ? I18n.t("已就绪", "Ready")
        : root.active-node-latency-ms < 80 ? I18n.t("极佳", "Optimal")
        : root.active-node-latency-ms < 180 ? I18n.t("良好", "Good")
        : I18n.t("波动", "Slow");

    vertical-stretch: 0;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: Theme.card-shadow;

    GlassSpeculum {}

    VerticalLayout {
        padding: Theme.space-md;
        spacing: Theme.space-sm;

        // Header
        HorizontalLayout {
            spacing: Theme.space-sm;
            Text {
                text: I18n.t("链路状态与快捷操作", "Link & Quick Ops");
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle {
                horizontal-stretch: 0;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-xs;
                background: root.core-running ? Theme.latency-bg(root.active-node-latency-ms, root.is-timeout ? "timeout" : "healthy") : Theme.well-bg;
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    spacing: 4px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: root.qual-color;
                    }
                    Text {
                        text: root.quality-label;
                        font-size: 10px;
                        font-weight: 700;
                        color: root.qual-color;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Link Quality Strip (4-bar ascending signal + active node + latency pill)
        Rectangle {
            height: 42px;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: link-ta.has-hover ? Theme.selected-border : Theme.well-border;
            background: link-ta.has-hover ? Theme.row-hover-bg : Theme.well-bg;
            animate border-color { duration: Motion.fast; }
            animate background { duration: Motion.fast; }

            link-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-groups(); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: Theme.space-sm;

                // 4-bar ascending signal meter
                HorizontalLayout {
                    width: 20px;
                    spacing: 2px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    Rectangle { width: 3.5px; height: 5px; y: parent.height - self.height - 12px; border-radius: 1.5px; background: root.bars >= 1 ? root.qual-color : Theme.offline-fg; opacity: root.bars >= 1 ? 1.0 : 0.26; }
                    Rectangle { width: 3.5px; height: 8px; y: parent.height - self.height - 12px; border-radius: 1.5px; background: root.bars >= 2 ? root.qual-color : Theme.offline-fg; opacity: root.bars >= 2 ? 1.0 : 0.24; }
                    Rectangle { width: 3.5px; height: 11px; y: parent.height - self.height - 12px; border-radius: 1.5px; background: root.bars >= 3 ? root.qual-color : Theme.offline-fg; opacity: root.bars >= 3 ? 1.0 : 0.22; }
                    Rectangle { width: 3.5px; height: 14px; y: parent.height - self.height - 12px; border-radius: 1.5px; background: root.bars >= 4 ? root.qual-color : Theme.offline-fg; opacity: root.bars >= 4 ? 1.0 : 0.20; }
                }

                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.active-node != "" ? root.active-node : I18n.t("未选择节点", "No active node");
                    font-size: 12px;
                    font-weight: 700;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.core-running && (root.active-node-latency-ms > 0 || root.is-timeout) : Rectangle {
                    horizontal-stretch: 0;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-xs;
                    background: Theme.latency-bg(root.active-node-latency-ms, root.is-timeout ? "timeout" : "healthy");
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: root.active-node-latency-ms > 0 ? "\{root.active-node-latency-ms} ms" : I18n.t("超时", "Timeout");
                            font-size: 10px;
                            font-weight: 700;
                            font-family: Theme.mono-font;
                            color: root.qual-color;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Cumulative Dual-Channel Traffic Split Bar (Sky Cyan DL vs Prism Violet UL)
        Rectangle {
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.well-border;
            background: Theme.well-bg;

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                HorizontalLayout {
                    spacing: Theme.space-sm;
                    Text {
                        text: I18n.t("流量构成", "Traffic Split");
                        font-size: 11px;
                        font-weight: 600;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "↓ " + root.download-total;
                        font-size: 11px;
                        font-weight: 700;
                        font-family: Theme.mono-font;
                        color: Theme.telemetry-down;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "↑ " + root.upload-total;
                        font-size: 11px;
                        font-weight: 700;
                        font-family: Theme.mono-font;
                        color: Theme.telemetry-up;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: (root.core-running && (root.download-total != "0 B" || root.upload-total != "0 B"))
                        ? Theme.telemetry-up.with-alpha(0.85) : Theme.hairline-strong;
                    clip: true;

                    if root.core-running && (root.download-total != "0 B" || root.upload-total != "0 B") : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * clamp(root.total-down-ratio, 0.05, 0.95);
                        height: parent.height;
                        border-radius: 3px;
                        background: Theme.telemetry-down;
                        animate width { duration: Motion.normal; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                    }
                }
            }
        }

        // Compact 2x2 Quick Ops
        GridLayout {
            spacing: 6px;
            Row {
                OpsActionButton { icon: @image-url("../icons/bolt.svg"); label: I18n.t("测速", "Probe"); enabled: root.core-running; clicked => { root.probe-active-group(); } }
                OpsActionButton { icon: @image-url("../icons/reload.svg"); label: I18n.t("重载", "Reload"); enabled: root.core-running; clicked => { root.reload-config(); } }
            }
            Row {
                OpsActionButton { icon: @image-url("../icons/trash.svg"); label: I18n.t("清缓存", "Cache"); enabled: root.core-running; danger: true; clicked => { root.clear-cache(); } }
                OpsActionButton { icon: @image-url("../icons/logs.svg"); label: I18n.t("日志", "Logs"); clicked => { root.open-logs(); } }
            }
        }
    }
}
