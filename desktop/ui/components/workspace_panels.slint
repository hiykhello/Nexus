import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { WorkspaceState } from "../workspace_state.slint";
import { NexusInput, ProportionBar } from "nexus_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusButton, NexusChip } from "nexus_buttons.slint";

export component WorkspaceSubscriptionsDrawer inherits Rectangle {
    in property <length> grid-w: 600px;

    width: root.grid-w;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: I18n.t("远端订阅分组与链式代理设置", "Subscription Groups & Chain Proxy");
                font-size: 14px;
                font-weight: 800;
                color: Theme.text-primary;
                vertical-alignment: center;
            }
            NexusButton {
                btn-height: 28px;
                has-icon: true;
                icon: @image-url("../icons/refresh.svg");
                label: WorkspaceState.sub-updating ? I18n.t("更新中...", "Updating...") : I18n.t("更新全部订阅", "Update All");
                primary: true;
                enabled: !WorkspaceState.sub-updating && WorkspaceState.subscriptions.length > 0;
                clicked => { WorkspaceState.refresh-subscription(""); }
            }
            IconActionButton {
                size: 28px;
                icon: @image-url("../icons/x.svg");
                label: I18n.t("收起", "Close");
                clicked => { WorkspaceState.sub-drawer-open = false; }
            }
        }

        // Add Subscription Form
        HorizontalLayout {
            spacing: 8px;
            NexusInput { horizontal-stretch: 28; preferred-width: 0px; min-width: 90px; text <=> WorkspaceState.sub-remarks; placeholder-text: I18n.t("订阅备注名称", "Group Remarks"); }
            NexusInput { horizontal-stretch: 54; preferred-width: 0px; min-width: 140px; mono: true; text <=> WorkspaceState.sub-url; placeholder-text: "https://sub.example.com/api/v1/client/subscribe?token=..."; }
            NexusInput { width: 88px; mono: true; text <=> WorkspaceState.sub-auto-min; placeholder-text: I18n.t("自动分钟", "Auto min"); }
            NexusButton {
                has-icon: true;
                icon: @image-url("../icons/plus.svg");
                label: I18n.t("添加并更新", "Add & Fetch");
                primary: true;
                clicked => {
                    if (WorkspaceState.sub-remarks != "" || WorkspaceState.sub-url != "") {
                        WorkspaceState.add-subscription(WorkspaceState.sub-remarks, WorkspaceState.sub-url, WorkspaceState.sub-prev-id, WorkspaceState.sub-next-id);
                        WorkspaceState.sub-remarks = ""; WorkspaceState.sub-url = "";
                        WorkspaceState.sub-prev-id = ""; WorkspaceState.sub-next-id = "";
                        WorkspaceState.sub-include-regex = ""; WorkspaceState.sub-exclude-regex = "";
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            NexusInput { horizontal-stretch: 1; preferred-width: 0px; mono: true; text <=> WorkspaceState.sub-include-regex; placeholder-text: I18n.t("包含节点正则(可选)", "Include regex"); }
            NexusInput { horizontal-stretch: 1; preferred-width: 0px; mono: true; text <=> WorkspaceState.sub-exclude-regex; placeholder-text: I18n.t("排除节点正则(可选)", "Exclude regex"); }
            NexusInput { horizontal-stretch: 1; preferred-width: 0px; mono: true; text <=> WorkspaceState.sub-prev-id; placeholder-text: I18n.t("前置代理 ID(可选)", "Pre-proxy ID"); }
            NexusInput { horizontal-stretch: 1; preferred-width: 0px; mono: true; text <=> WorkspaceState.sub-next-id; placeholder-text: I18n.t("落地代理 ID(可选)", "Landing ID"); }
        }

        if WorkspaceState.subscriptions.length > 0 : Rectangle { height: 1px; background: Theme.hairline-subtle; }

        for sub in WorkspaceState.subscriptions : VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1; min-width: 0px;
                    text: (sub.remarks != "" ? sub.remarks : sub.id) + "  (" + sub.node-count + I18n.t(" 节点)", " nodes)");
                    font-size: 13px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; overflow: elide;
                }
                if sub.quota-text != "" : Text {
                    text: sub.quota-text + (sub.expire-text != "" ? " · " + sub.expire-text : "");
                    font-size: 11px; font-family: Theme.mono-font; color: Theme.text-secondary; vertical-alignment: center;
                }
                if sub.url != "" : NexusButton {
                    btn-height: 26px;
                    label: I18n.t("更新", "Update");
                    enabled: !WorkspaceState.sub-updating;
                    clicked => { WorkspaceState.refresh-subscription(sub.id); }
                }
                NexusChip {
                    chip-height: 26px;
                    label: I18n.t("链式前置/落地", "Chain");
                    active: WorkspaceState.edit-chain-sub-id == sub.id;
                    clicked => {
                        if (WorkspaceState.edit-chain-sub-id == sub.id) {
                            WorkspaceState.edit-chain-sub-id = "";
                        } else {
                            WorkspaceState.edit-chain-sub-id = sub.id;
                            WorkspaceState.edit-chain-prev = sub.prev-profile-id;
                            WorkspaceState.edit-chain-next = sub.next-profile-id;
                        }
                    }
                }
                if sub.id != "manual" : IconActionButton {
                    icon: @image-url("../icons/trash.svg"); label: I18n.t("删除订阅", "Delete"); danger: true; size: 26px;
                    clicked => { WorkspaceState.delete-subscription(sub.id); }
                }
            }
            if sub.quota-ratio > 0.0 : ProportionBar {
                bar-height: 4px;
                first-ratio: sub.quota-ratio;
                first-color: sub.quota-ratio >= 0.90 ? Theme.error-fg : Theme.accent;
                has-second: false;
            }
            if WorkspaceState.edit-chain-sub-id == sub.id : HorizontalLayout {
                spacing: 8px;
                NexusInput { horizontal-stretch: 1; preferred-width: 0px; mono: true; text <=> WorkspaceState.edit-chain-prev; placeholder-text: I18n.t("前置代理 ID", "Prev Profile ID"); }
                NexusInput { horizontal-stretch: 1; preferred-width: 0px; mono: true; text <=> WorkspaceState.edit-chain-next; placeholder-text: I18n.t("落地代理 ID", "Next Profile ID"); }
                NexusButton {
                    btn-height: 30px; label: I18n.t("保存链", "Save"); primary: true;
                    clicked => {
                        WorkspaceState.update-subscription-chain(sub.id, WorkspaceState.edit-chain-prev, WorkspaceState.edit-chain-next);
                        WorkspaceState.edit-chain-sub-id = "";
                    }
                }
            }
        }
    }
}
