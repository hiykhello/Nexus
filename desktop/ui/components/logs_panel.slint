import { ListView } from "std-widgets.slint";
import { ControlInspectState } from "../control_inspect_state.slint";
import { ToastState } from "../feedback.slint";
import { NexusInput } from "nexus_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusSelect } from "nexus_select.slint";
import { LogLineItem } from "../types.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";

component LiveStreamToggle inherits Rectangle {
    forward-focus: fs;
    horizontal-stretch: 0;
    height: 32px;
    border-radius: Theme.radius-md;
    border-width: fs.has-focus ? 2px : 1px;
    border-color:
        fs.has-focus ? Theme.accent
        : !ControlInspectState.logs-stream-enabled ? Theme.card-border
        : ControlInspectState.logs-stream-connected ? Theme.live-emerald-border
        : Theme.selected-border;
    background: !ControlInspectState.logs-stream-enabled ? Theme.row-bg : ControlInspectState.logs-stream-connected ? Theme.live-emerald-soft : Theme.selected-bg;
    transform-scale: stream-ta.pressed ? 0.97 : 1.0;
    animate background { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }
    accessible-role: button;
    accessible-label: I18n.t("实时日志流", "Live Log Stream");
    accessible-action-default => {
        let next = !ControlInspectState.logs-stream-enabled;
        ControlInspectState.logs-stream-enabled = next;
        ControlInspectState.toggle-logs-stream(next);
    }

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Return || ev.text == " ") {
                let next = !ControlInspectState.logs-stream-enabled;
                ControlInspectState.logs-stream-enabled = next;
                ControlInspectState.toggle-logs-stream(next);
                return accept;
            }
            reject
        }
    }

    stream-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            let next = !ControlInspectState.logs-stream-enabled;
            ControlInspectState.logs-stream-enabled = next;
            ControlInspectState.toggle-logs-stream(next);
        }
    }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px;
        Rectangle {
            width: 6px; height: 6px; y: (parent.height - self.height) / 2; border-radius: 3px;
            background: !ControlInspectState.logs-stream-enabled ? Theme.offline-fg : ControlInspectState.logs-stream-connected ? Theme.live-emerald : Theme.accent;
        }
        Text {
            text: !ControlInspectState.logs-stream-enabled ? I18n.t("暂停", "Paused") : ControlInspectState.logs-stream-connected ? I18n.t("实时", "Live") : I18n.t("连接中", "Connecting");
            font-size: 11px; font-weight: 700; font-family: Theme.mono-font;
            color: !ControlInspectState.logs-stream-enabled ? Theme.text-muted : ControlInspectState.logs-stream-connected ? Theme.live-emerald : Theme.nav-active-fg;
            vertical-alignment: center;
        }
    }
}

export component LogsPanel inherits VerticalLayout {
    in property <length> window-width: 1040px;
    in property <[LogLineItem]> logs: [];
    in-out property <string> log-level: "info";
    in-out property <string> domain-filter: "all";
    in-out property <string> search-text: "";
    in-out property <string> sev-choice: "all";
    in property <string> export-status: "";
    in property <bool> export-ok: true;

    callback apply-log-level(string);
    callback sev-filter-changed(string);
    callback search-changed(string);
    callback refresh-logs();
    callback export-logs();
    callback clear-logs();
    callback copy-text(string);

    property <bool> compact-bar: root.window-width < 900px;

    spacing: Theme.space-md;

    // Wide (>=900px): Single compact toolbar
    if !root.compact-bar : HorizontalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-sm;

        NexusInput {
            horizontal-stretch: 1;
            min-width: 140px;
            search-icon: true;
            text <=> root.search-text;
            placeholder-text: I18n.t("搜索日志…", "Search logs…");
            edited(q) => { root.search-changed(q); }
            accepted => { root.refresh-logs(); }
        }

        NexusSelect {
            width: 106px;
            mono: false;
            prefix: I18n.t("级别", "Lvl");
            all-label: I18n.t("全部", "All");
            options: ["all", "ERR", "WRN", "INF", "DBG"];
            current-value <=> root.sev-choice;
            selected(v) => {
                let norm = v == "ERR" ? "error" : v == "WRN" ? "warn" : v == "INF" ? "info" : v == "DBG" ? "debug" : "all";
                root.sev-filter-changed(norm);
            }
        }

        NexusSelect {
            width: 114px;
            prefix: I18n.t("采集", "Cap");
            options: ["error", "warn", "info", "debug", "trace"];
            current-value <=> root.log-level;
            selected(lvl) => { root.apply-log-level(lvl); }
        }

        NexusSelect {
            width: 110px;
            prefix: I18n.t("模块", "Mod");
            all-label: I18n.t("全部", "All");
            options: ["all", "core", "proxy", "route", "dns", "tun", "quic", "tls", "net", "state", "control"];
            current-value <=> root.domain-filter;
            selected(d) => { root.refresh-logs(); }
        }

        LiveStreamToggle {}

        IconActionButton { icon: @image-url("../icons/refresh.svg"); label: I18n.t("刷新", "Refresh"); clicked => { root.refresh-logs(); } }
        IconActionButton { icon: @image-url("../icons/download.svg"); label: I18n.t("导出快照", "Export"); clicked => { root.export-logs(); } }
        IconActionButton { icon: @image-url("../icons/trash.svg"); label: I18n.t("清空", "Clear"); danger: true; clicked => { root.clear-logs(); } }
    }

    // Compact (<900px, e.g. 780x560): 2 tidy rows so search input never squeezes to 140px
    if root.compact-bar : VerticalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-sm;

        HorizontalLayout {
            spacing: Theme.space-sm;
            NexusInput {
                horizontal-stretch: 1;
                min-width: 160px;
                search-icon: true;
                text <=> root.search-text;
                placeholder-text: I18n.t("搜索日志…", "Search logs…");
                edited(q) => { root.search-changed(q); }
                accepted => { root.refresh-logs(); }
            }
            LiveStreamToggle {}
            IconActionButton { icon: @image-url("../icons/refresh.svg"); label: I18n.t("刷新", "Refresh"); clicked => { root.refresh-logs(); } }
            IconActionButton { icon: @image-url("../icons/download.svg"); label: I18n.t("导出快照", "Export"); clicked => { root.export-logs(); } }
            IconActionButton { icon: @image-url("../icons/trash.svg"); label: I18n.t("清空", "Clear"); danger: true; clicked => { root.clear-logs(); } }
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            NexusSelect {
                horizontal-stretch: 1;
                mono: false;
                prefix: I18n.t("级别", "Lvl");
                all-label: I18n.t("全部", "All");
                options: ["all", "ERR", "WRN", "INF", "DBG"];
                current-value <=> root.sev-choice;
                selected(v) => {
                    let norm = v == "ERR" ? "error" : v == "WRN" ? "warn" : v == "INF" ? "info" : v == "DBG" ? "debug" : "all";
                    root.sev-filter-changed(norm);
                }
            }
            NexusSelect {
                horizontal-stretch: 1;
                prefix: I18n.t("采集", "Cap");
                options: ["error", "warn", "info", "debug", "trace"];
                current-value <=> root.log-level;
                selected(lvl) => { root.apply-log-level(lvl); }
            }
            NexusSelect {
                horizontal-stretch: 1;
                prefix: I18n.t("模块", "Mod");
                all-label: I18n.t("全部", "All");
                options: ["all", "core", "proxy", "route", "dns", "tun", "quic", "tls", "net", "state", "control"];
                current-value <=> root.domain-filter;
                selected(d) => { root.refresh-logs(); }
            }
        }
    }

    if root.export-status != "" : Rectangle {
        vertical-stretch: 0;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: root.export-ok ? Theme.success-border : Theme.error-border;
        background: root.export-ok ? Theme.success-bg : Theme.error-bg;
        HorizontalLayout {
            padding-left: Theme.space-md; padding-right: Theme.space-md; padding-top: Theme.space-sm; padding-bottom: Theme.space-sm;
            Text {
                text: root.export-status; font-size: 12px;
                color: root.export-ok ? Theme.success-fg : Theme.error-fg; overflow: elide;
            }
        }
    }

    // Full-Height Fluent 2 Single-Level Log Console Card
    Rectangle {
        vertical-stretch: 1;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-surface;
        clip: true;

        VerticalLayout {
            width: 100%;
            height: 100%;

            if root.logs.length > 0 : Rectangle {
                vertical-stretch: 0;
                height: 36px;
                background: Theme.well-bg;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: Theme.space-sm;
                    Text { width: 46px; text: I18n.t("级别", "LVL"); font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { width: 70px; text: I18n.t("域", "DOMAIN"); font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Text { horizontal-stretch: 1; text: I18n.t("消息", "MESSAGE"); font-size: 11px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }
                    Rectangle {
                        height: 20px; y: (parent.height - self.height) / 2; border-radius: Theme.radius-sm; background: Theme.inset-bg;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text { text: "\{root.logs.length}"; font-size: 10.5px; font-weight: 700; font-family: Theme.mono-font; color: Theme.text-secondary; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { x: 0px; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.card-border; }
            }

            if root.logs.length == 0 : VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                padding: Theme.space-xl;
                spacing: Theme.space-sm;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 44px; height: 44px; border-radius: 22px;
                        border-width: 1px; border-color: Theme.well-border; background: Theme.well-bg;
                        Image { x: 12px; y: 12px; width: 20px; height: 20px; source: @image-url("../icons/logs.svg"); colorize: Theme.accent; }
                    }
                }
                Text { text: I18n.t("暂无日志", "No logs yet"); font-size: 14px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center; }
                Text { text: I18n.t("连接后刷新查看实时运行日志与诊断输出", "Connect and refresh to stream runtime logs"); font-size: 12px; color: Theme.text-muted; horizontal-alignment: center; }
            }

            if root.logs.length > 0 : lv := ListView {
                vertical-stretch: 1;
                for entry[idx] in root.logs : Rectangle {
                    width: lv.visible-width;
                    height: row-body.preferred-height;
                    clip: true;
                    background: Math.mod(idx, 2) == 0 ? transparent : Theme.row-alt-bg;

                    ContextMenuArea {
                        Menu {
                            MenuItem {
                                title: I18n.t("复制此日志", "Copy Log Line");
                                activated => {
                                    let line = "[" + entry.level + "] [" + entry.domain + "] " + entry.message;
                                    root.copy-text(line);
                                    ToastState.push(I18n.t("已复制日志行", "Copied log line"), "success");
                                }
                            }
                        }

                        row-body := HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: Theme.space-sm;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 46px;
                                    height: 20px;
                                    border-radius: Theme.radius-xs;
                                    border-width: 1px;
                                    border-color:
                                        entry.level == "error" ? Theme.error-border
                                        : entry.level == "warn" ? Theme.warn-border
                                        : entry.level == "info" ? Theme.telemetry-down.with-alpha(0.40)
                                        : entry.level == "trace" ? Theme.telemetry-up.with-alpha(0.35)
                                        : Theme.well-border;
                                    background:
                                        entry.level == "error" ? Theme.error-bg
                                        : entry.level == "warn" ? Theme.warn-bg
                                        : entry.level == "info" ? Theme.proto-tls-bg
                                        : entry.level == "trace" ? Theme.telemetry-up-soft
                                        : Theme.inset-bg;
                                    Text {
                                        width: 100%; height: 100%;
                                        text:
                                            entry.level == "error" ? "ERR"
                                            : entry.level == "warn" ? "WRN"
                                            : entry.level == "info" ? "INF"
                                            : entry.level == "debug" ? "DBG"
                                            : entry.level == "trace" ? "TRC"
                                            : entry.level;
                                        font-size: 10px; font-weight: 700; font-family: Theme.mono-font;
                                        horizontal-alignment: center; vertical-alignment: center;
                                        color:
                                            entry.level == "error" ? Theme.error-fg
                                            : entry.level == "warn" ? Theme.warn-fg
                                            : entry.level == "info" ? Theme.telemetry-down
                                            : entry.level == "trace" ? Theme.telemetry-up
                                            : Theme.text-secondary;
                                    }
                                }
                            }

                            Text {
                                text: entry.domain; font-size: 12px; font-weight: 600; font-family: Theme.mono-font;
                                color: Theme.text-secondary; width: 70px; vertical-alignment: center; overflow: elide;
                            }

                            Text {
                                text: entry.message; font-size: 12px; font-family: Theme.mono-font;
                                color: Theme.text-primary; horizontal-stretch: 1; min-width: 0px;
                                wrap: word-wrap; vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
