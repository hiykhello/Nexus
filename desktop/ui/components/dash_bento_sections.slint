import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { OutboundMemberItem, ProfileItem } from "../types.slint";
import { DragHandleOverlay, SectionDragHeader } from "dash_drag_chrome.slint";
import { DashInfoGrid, DeckCardSlot } from "dash_slot_cards.slint";
import { BentoSwitchTile } from "bento_cards.slint";
import { OutboundModeCard } from "bento_deck_cards.slint";
import { HeroCommandCard } from "hero_command_card.slint";
import { SpeedWaveCard } from "speed_wave_card.slint";

// Single-template Reorderable Bento Section Slot (1x Slint codegen via `for sec-id in dash-section-order`)
export component DashSectionSlot inherits VerticalLayout {
    in property <int> section-id: 0;
    in property <bool> shown: true;
    in property <length> top-gap: 0px;
    in property <bool> is-compact: false;
    in property <bool> is-wide: false;
    in property <length> row1-h: 178px;
    in property <bool> editing: false;
    in property <string> drag-kind: "";
    in property <int> drag-source-id: -1;
    in property <int> target-sec-id: -1;
    in property <int> target-info-id: -1;
    in property <int> target-deck-id: -1;
    in property <length> drag-abs-x: 0px;
    in property <length> drag-abs-y: 0px;

    in property <bool> core-running: false;
    in property <bool> core-toggling: false;
    in property <string> core-uptime: "";
    in property <string> app-memory-text: "--";
    in property <string> core-memory-text: "--";
    in property <string> total-memory-text: "--";
    in property <float> app-memory-ratio: 0.78;
    in property <bool> system-proxy-supported: true;
    in property <bool> system-proxy-enabled: false;
    in property <string> sys-proxy-port: "";
    in property <string> outbound-mode: "rule";
    in-out property <bool> mixed-proxy-enabled: true;
    in-out property <string> mixed-proxy-host: "127.0.0.1";
    in-out property <string> mixed-proxy-port: "7890";
    in-out property <bool> socks-proxy-enabled: true;
    in-out property <string> socks-proxy-host: "127.0.0.1";
    in-out property <string> socks-proxy-port: "1080";
    in-out property <bool> http-proxy-enabled: false;
    in-out property <string> http-proxy-host: "127.0.0.1";
    in-out property <string> http-proxy-port: "8080";
    in property <bool> tun-enabled: false;
    in property <string> active-profile: "";
    in property <[ProfileItem]> profiles: [];
    in property <string> selected-group: "";
    in property <string> active-node: "";
    in property <int> active-node-latency-ms: -1;
    in property <int> active-sessions: 0;
    in property <string> upload-total: "0 B";
    in property <string> download-total: "0 B";
    in property <float> total-down-ratio: 0.85;
    in property <string> down-speed-value: "0.0";
    in property <string> down-speed-unit: "KB/s";
    in property <string> down-speed-peak: "0.0 KB/s";
    in property <string> down-wave-area: "";
    in property <string> down-wave-line: "";
    in property <string> up-speed-value: "0.0";
    in property <string> up-speed-unit: "KB/s";
    in property <string> up-speed-peak: "0.0 KB/s";
    in property <string> up-wave-area: "";
    in property <string> up-wave-line: "";
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;
    in property <string> hero-state-override: "";
    in property <[OutboundMemberItem]> quick-nodes: [];
    in property <bool> groups-probing: false;
    in property <bool> dash-show-speed: true;
    in property <bool> dash-show-quick-nodes: true;
    in property <bool> dash-show-network: true;
    in property <bool> dash-show-memory: true;
    in property <bool> dash-show-traffic: true;
    in property <bool> dash-show-ports: true;
    in property <[int]> dash-info-order: [0, 1, 2, 3];
    in property <bool> deck-swapped: false;

    callback toggle-core();
    callback toggle-system-proxy(bool);
    callback switch-outbound-mode(string);
    callback apply-inbound-proxy-config(string, bool, string, string);
    callback toggle-tun(bool);
    callback reload-config();
    callback clear-cache();
    callback copy-text(string);
    callback copy-proxy-env();
    callback select-member(string, string);
    callback activate-profile(string);
    callback probe-active-group();
    callback open-groups();
    callback open-connections();
    callback open-profiles();
    callback open-config();
    callback open-logs();
    callback open-rules();
    callback start-drag(string, int, length, length);
    callback move-drag(length, length);
    callback end-drag();
    callback cancel-drag();
    callback report-hover-sec(int, bool);
    callback report-hover-info(int, bool);
    callback report-hover-deck(int, bool);

    property <bool> is-sec-source: root.drag-kind == "section" && root.drag-source-id == root.section-id;
    property <bool> is-sec-target: root.target-sec-id == root.section-id;
    property <bool> is-dragging-any: root.drag-kind != "";
    property <int> deck-first-id: root.deck-swapped ? 1 : 0;
    property <int> deck-second-id: root.deck-swapped ? 0 : 1;
    property <bool> deck-first-shown: root.deck-first-id == 0 ? root.dash-show-quick-nodes : true;
    property <bool> deck-second-shown: root.deck-second-id == 0 ? root.dash-show-quick-nodes : true;
    property <string> sec-title:
        root.section-id == 0 ? I18n.t("主控与速率", "Hero & Speed")
        : root.section-id == 1 ? I18n.t("控制条", "Controls")
        : root.section-id == 2 ? I18n.t("信息卡片", "Status Cards")
        : I18n.t("底部面板", "Quick Deck");
    property <string> sec-hint:
        root.section-id == 2 ? I18n.t("拖移整行或单独拖拽卡片", "Drag row or individual cards")
        : root.section-id == 3 ? I18n.t("拖移整行或互换左右面板", "Drag row or swap panels")
        : I18n.t("上下拖拽调整区域顺序", "Drag vertically to reorder");

    property <bool> sec-ptr-over:
        root.shown && root.drag-kind != "" && root.height > 0px
        && root.drag-abs-y >= root.absolute-position.y
        && root.drag-abs-y < root.absolute-position.y + root.height;
    changed sec-ptr-over => { root.report-hover-sec(root.section-id, self.sec-ptr-over); }

    vertical-stretch: root.shown && !root.is-compact && root.section-id == 3 ? 1 : 0;
    padding-top: root.shown ? root.top-gap : 0px;
    spacing: root.shown && root.editing ? 4px : 0px;

    if root.shown && root.editing : SectionDragHeader {
        label: root.sec-title; hint: root.sec-hint;
        is-source: root.is-sec-source; is-target: root.is-sec-target; is-dragging-any: root.is-dragging-any;
        drag-started(ax, ay) => { root.start-drag("section", root.section-id, ax, ay); }
        drag-moved(ax, ay) => { root.move-drag(ax, ay); }
        drag-ended => { root.end-drag(); }
        drag-cancelled => { root.cancel-drag(); }
    }

    // ===== SECTION 0: Hero + Download/Upload Speed Waves =====
    if root.shown && root.section-id == 0 && !root.is-compact : Rectangle {
        vertical-stretch: 0; height: root.row1-h;
        HorizontalLayout {
            spacing: Theme.space-md;
            HeroCommandCard {
                horizontal-stretch: 2; preferred-width: 0px; min-width: 0px; wide: root.is-wide;
                core-running: root.core-running; core-toggling: root.core-toggling; core-uptime: root.core-uptime;
                active-profile: root.active-profile; selected-group: root.selected-group; active-node: root.active-node;
                active-node-latency-ms: root.active-node-latency-ms; active-sessions: root.active-sessions;
                diagnostic-message: root.diagnostic-message; diagnostic-ok: root.diagnostic-ok; hero-state-override: root.hero-state-override;
                toggle-core => { root.toggle-core(); } reload-config => { root.reload-config(); }
                open-groups => { root.open-groups(); } open-connections => { root.open-connections(); }
                open-profiles => { root.open-profiles(); } open-config => { root.open-config(); } probe-active-group => { root.probe-active-group(); }
            }
            if root.dash-show-speed : SpeedWaveCard {
                preferred-width: 0px; title: I18n.t("下载", "Download");
                value: root.down-speed-value; unit: root.down-speed-unit; peak-text: root.down-speed-peak; total-text: root.download-total;
                wave-area: root.down-wave-area; wave-line: root.down-wave-line; wave-color: Theme.telemetry-down;
                core-running: root.core-running; compact: !root.is-wide; show-peak: root.is-wide;
            }
            if root.dash-show-speed : SpeedWaveCard {
                preferred-width: 0px; title: I18n.t("上传", "Upload"); arrow: "↑";
                value: root.up-speed-value; unit: root.up-speed-unit; peak-text: root.up-speed-peak; total-text: root.upload-total;
                wave-area: root.up-wave-area; wave-line: root.up-wave-line; wave-color: Theme.telemetry-up;
                core-running: root.core-running; compact: !root.is-wide; show-peak: root.is-wide;
            }
        }
        if root.editing : DragHandleOverlay {
            editing: root.editing; show-grip-pill: false; is-source: root.is-sec-source; is-target: root.is-sec-target; is-dragging-any: root.is-dragging-any;
            drag-started(ax, ay) => { root.start-drag("section", 0, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
            drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
        }
    }

    if root.shown && root.section-id == 0 && root.is-compact : Rectangle {
        vertical-stretch: 0;
        VerticalLayout {
            spacing: Theme.space-sm;
            HeroCommandCard {
                min-height: 152px; compact: true;
                core-running: root.core-running; core-toggling: root.core-toggling; core-uptime: root.core-uptime;
                active-profile: root.active-profile; selected-group: root.selected-group; active-node: root.active-node;
                active-node-latency-ms: root.active-node-latency-ms; active-sessions: root.active-sessions;
                diagnostic-message: root.diagnostic-message; diagnostic-ok: root.diagnostic-ok; hero-state-override: root.hero-state-override;
                toggle-core => { root.toggle-core(); } reload-config => { root.reload-config(); }
                open-groups => { root.open-groups(); } open-connections => { root.open-connections(); }
                open-profiles => { root.open-profiles(); } open-config => { root.open-config(); } probe-active-group => { root.probe-active-group(); }
            }
            if root.dash-show-speed : HorizontalLayout {
                height: 154px; spacing: Theme.space-sm;
                SpeedWaveCard {
                    preferred-width: 0px; title: I18n.t("下载", "Download"); compact: true;
                    value: root.down-speed-value; unit: root.down-speed-unit; peak-text: root.down-speed-peak; total-text: root.download-total;
                    wave-area: root.down-wave-area; wave-line: root.down-wave-line; wave-color: Theme.telemetry-down; core-running: root.core-running;
                }
                SpeedWaveCard {
                    preferred-width: 0px; title: I18n.t("上传", "Upload"); arrow: "↑"; compact: true;
                    value: root.up-speed-value; unit: root.up-speed-unit; peak-text: root.up-speed-peak; total-text: root.upload-total;
                    wave-area: root.up-wave-area; wave-line: root.up-wave-line; wave-color: Theme.telemetry-up; core-running: root.core-running;
                }
            }
        }
        if root.editing : DragHandleOverlay {
            editing: root.editing; show-grip-pill: false; is-source: root.is-sec-source; is-target: root.is-sec-target; is-dragging-any: root.is-dragging-any;
            drag-started(ax, ay) => { root.start-drag("section", 0, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
            drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
        }
    }

    // ===== SECTION 1: Outbound Mode + System Proxy + TUN =====
    if root.shown && root.section-id == 1 && !root.is-compact : Rectangle {
        vertical-stretch: 0; height: 58px;
        HorizontalLayout {
            spacing: Theme.space-md;
            OutboundModeCard { horizontal-stretch: 2; preferred-width: 0px; min-width: 0px; compact: !root.is-wide; mode: root.outbound-mode; mode-selected(m) => { root.switch-outbound-mode(m); } }
            BentoSwitchTile {
                preferred-width: 0px; icon: @image-url("../icons/connections.svg");
                label: root.system-proxy-supported ? I18n.t("系统代理", "System Proxy") : I18n.t("代理不可用", "Proxy N/A");
                subtitle: !root.system-proxy-supported ? "" : root.system-proxy-enabled ? root.sys-proxy-port : I18n.t("未开启", "Off");
                enabled: root.core-running && root.system-proxy-supported; active: root.system-proxy-enabled; toggled(on) => { root.toggle-system-proxy(on); }
            }
            BentoSwitchTile {
                preferred-width: 0px; icon: @image-url("../icons/bolt.svg"); badge-color: Theme.telemetry-up;
                label: I18n.t("TUN 模式", "TUN Mode"); subtitle: I18n.t("全局接管", "Full Device");
                enabled: root.core-running; active: root.tun-enabled; toggled(on) => { root.toggle-tun(on); }
            }
        }
        if root.editing : DragHandleOverlay {
            editing: root.editing; show-grip-pill: false; is-source: root.is-sec-source; is-target: root.is-sec-target; is-dragging-any: root.is-dragging-any;
            drag-started(ax, ay) => { root.start-drag("section", 1, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
            drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
        }
    }

    if root.shown && root.section-id == 1 && root.is-compact : Rectangle {
        vertical-stretch: 0;
        VerticalLayout {
            spacing: Theme.space-sm;
            OutboundModeCard { compact: true; mode: root.outbound-mode; mode-selected(m) => { root.switch-outbound-mode(m); } }
            HorizontalLayout {
                height: 58px; spacing: Theme.space-sm;
                BentoSwitchTile {
                    preferred-width: 0px; compact: true; icon: @image-url("../icons/connections.svg");
                    label: root.system-proxy-supported ? I18n.t("系统代理", "System Proxy") : I18n.t("代理不可用", "Proxy N/A");
                    subtitle: !root.system-proxy-supported ? "" : root.system-proxy-enabled ? root.sys-proxy-port : I18n.t("未开启", "Off");
                    enabled: root.core-running && root.system-proxy-supported; active: root.system-proxy-enabled; toggled(on) => { root.toggle-system-proxy(on); }
                }
                BentoSwitchTile {
                    preferred-width: 0px; compact: true; icon: @image-url("../icons/bolt.svg"); badge-color: Theme.telemetry-up;
                    label: I18n.t("TUN 模式", "TUN Mode"); subtitle: I18n.t("全局接管", "Full Device");
                    enabled: root.core-running; active: root.tun-enabled; toggled(on) => { root.toggle-tun(on); }
                }
            }
        }
        if root.editing : DragHandleOverlay {
            editing: root.editing; show-grip-pill: false; is-source: root.is-sec-source; is-target: root.is-sec-target; is-dragging-any: root.is-dragging-any;
            drag-started(ax, ay) => { root.start-drag("section", 1, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
            drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
        }
    }

    // ===== SECTION 2: 4 Reorderable Info Cards =====
    if root.shown && root.section-id == 2 : Rectangle {
        vertical-stretch: 0;
        height: info-grid.height;

        info-grid := DashInfoGrid {
            width: 100%;
            is-compact: root.is-compact; editing: root.editing;
            drag-kind: root.drag-kind; drag-source-id: root.drag-source-id; target-info-id: root.target-info-id;
            drag-abs-x: root.drag-abs-x; drag-abs-y: root.drag-abs-y;
            info-order: root.dash-info-order;
            show-network: root.dash-show-network; show-memory: root.dash-show-memory;
            show-traffic: root.dash-show-traffic; show-ports: root.dash-show-ports;
            core-running: root.core-running; active-node: root.active-node; active-node-latency-ms: root.active-node-latency-ms; groups-probing: root.groups-probing;
            total-memory-text: root.total-memory-text; app-memory-text: root.app-memory-text; core-memory-text: root.core-memory-text; app-memory-ratio: root.app-memory-ratio;
            active-sessions: root.active-sessions; download-total: root.download-total; upload-total: root.upload-total; total-down-ratio: root.total-down-ratio;
            mixed-proxy-enabled <=> root.mixed-proxy-enabled; mixed-proxy-host <=> root.mixed-proxy-host; mixed-proxy-port <=> root.mixed-proxy-port;
            socks-proxy-enabled <=> root.socks-proxy-enabled; socks-proxy-host <=> root.socks-proxy-host; socks-proxy-port <=> root.socks-proxy-port;
            http-proxy-enabled <=> root.http-proxy-enabled; http-proxy-host <=> root.http-proxy-host; http-proxy-port <=> root.http-proxy-port;
            probe-active-group => { root.probe-active-group(); } open-groups => { root.open-groups(); } clear-cache => { root.clear-cache(); }
            open-connections => { root.open-connections(); } apply-inbound-proxy-config(pr, on, h, p) => { root.apply-inbound-proxy-config(pr, on, h, p); }
            copy-text(t) => { root.copy-text(t); } copy-proxy-env => { root.copy-proxy-env(); } open-config => { root.open-config(); }
            start-drag(k, id, ax, ay) => { root.start-drag(k, id, ax, ay); } move-drag(ax, ay) => { root.move-drag(ax, ay); }
            end-drag => { root.end-drag(); } cancel-drag => { root.cancel-drag(); }
            report-hover-info(id, inside) => { root.report-hover-info(id, inside); }
        }

        if root.editing && root.is-sec-target : Rectangle {
            border-radius: 20px; border-width: 2px; border-color: Theme.accent;
            background: Theme.accent.with-alpha(Theme.dark ? 0.14 : 0.09);
            drop-shadow-blur: 14px; drop-shadow-color: Theme.accent.with-alpha(0.42);
        }
    }

    // ===== SECTION 3: Bottom Swappable Deck =====
    if root.shown && root.section-id == 3 && !root.is-compact : Rectangle {
        vertical-stretch: 1;
        min-height: 184px;

        HorizontalLayout {
            spacing: Theme.space-md;
            if root.deck-first-shown : DeckCardSlot {
                deck-id: root.deck-first-id;
                horizontal-stretch: root.deck-first-id == 0 ? 62 : 38;
                preferred-width: 0px; min-width: 0px;
                is-wide: root.is-wide; editing: root.editing;
                is-source: root.drag-kind == "deck" && root.drag-source-id == root.deck-first-id;
                is-target: root.target-deck-id == root.deck-first-id; is-dragging-any: root.is-dragging-any;
                drag-kind: root.drag-kind; drag-abs-x: root.drag-abs-x; drag-abs-y: root.drag-abs-y;
                selected-group: root.selected-group; quick-nodes: root.quick-nodes; groups-probing: root.groups-probing;
                profiles: root.profiles; active-profile: root.active-profile;
                select-member(g, m) => { root.select-member(g, m); } probe-active-group => { root.probe-active-group(); }
                open-groups => { root.open-groups(); } activate-profile(id) => { root.activate-profile(id); }
                open-profiles => { root.open-profiles(); } open-logs => { root.open-logs(); } open-rules => { root.open-rules(); }
                drag-started(id, ax, ay) => { root.start-drag("deck", id, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
                drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
                report-hover(id, inside) => { root.report-hover-deck(id, inside); }
            }
            if root.deck-second-shown : DeckCardSlot {
                deck-id: root.deck-second-id;
                horizontal-stretch: root.deck-second-id == 0 ? 62 : 38;
                preferred-width: 0px; min-width: 0px;
                is-wide: root.is-wide; editing: root.editing;
                is-source: root.drag-kind == "deck" && root.drag-source-id == root.deck-second-id;
                is-target: root.target-deck-id == root.deck-second-id; is-dragging-any: root.is-dragging-any;
                drag-kind: root.drag-kind; drag-abs-x: root.drag-abs-x; drag-abs-y: root.drag-abs-y;
                selected-group: root.selected-group; quick-nodes: root.quick-nodes; groups-probing: root.groups-probing;
                profiles: root.profiles; active-profile: root.active-profile;
                select-member(g, m) => { root.select-member(g, m); } probe-active-group => { root.probe-active-group(); }
                open-groups => { root.open-groups(); } activate-profile(id) => { root.activate-profile(id); }
                open-profiles => { root.open-profiles(); } open-logs => { root.open-logs(); } open-rules => { root.open-rules(); }
                drag-started(id, ax, ay) => { root.start-drag("deck", id, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
                drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
                report-hover(id, inside) => { root.report-hover-deck(id, inside); }
            }
        }

        if root.editing && root.is-sec-target : Rectangle {
            border-radius: 20px; border-width: 2px; border-color: Theme.accent;
            background: Theme.accent.with-alpha(Theme.dark ? 0.14 : 0.09);
            drop-shadow-blur: 14px; drop-shadow-color: Theme.accent.with-alpha(0.42);
        }
    }

    if root.shown && root.section-id == 3 && root.is-compact : Rectangle {
        vertical-stretch: 0;
        preferred-height: c-deck-col.preferred-height;

        c-deck-col := VerticalLayout {
            spacing: Theme.space-sm;
            if root.deck-first-shown : DeckCardSlot {
                deck-id: root.deck-first-id; editing: root.editing;
                is-source: root.drag-kind == "deck" && root.drag-source-id == root.deck-first-id;
                is-target: root.target-deck-id == root.deck-first-id; is-dragging-any: root.is-dragging-any;
                drag-kind: root.drag-kind; drag-abs-x: root.drag-abs-x; drag-abs-y: root.drag-abs-y;
                selected-group: root.selected-group; quick-nodes: root.quick-nodes; groups-probing: root.groups-probing;
                profiles: root.profiles; active-profile: root.active-profile;
                select-member(g, m) => { root.select-member(g, m); } probe-active-group => { root.probe-active-group(); }
                open-groups => { root.open-groups(); } activate-profile(id) => { root.activate-profile(id); }
                open-profiles => { root.open-profiles(); } open-logs => { root.open-logs(); } open-rules => { root.open-rules(); }
                drag-started(id, ax, ay) => { root.start-drag("deck", id, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
                drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
                report-hover(id, inside) => { root.report-hover-deck(id, inside); }
            }
            if root.deck-second-shown : DeckCardSlot {
                deck-id: root.deck-second-id; editing: root.editing;
                is-source: root.drag-kind == "deck" && root.drag-source-id == root.deck-second-id;
                is-target: root.target-deck-id == root.deck-second-id; is-dragging-any: root.is-dragging-any;
                drag-kind: root.drag-kind; drag-abs-x: root.drag-abs-x; drag-abs-y: root.drag-abs-y;
                selected-group: root.selected-group; quick-nodes: root.quick-nodes; groups-probing: root.groups-probing;
                profiles: root.profiles; active-profile: root.active-profile;
                select-member(g, m) => { root.select-member(g, m); } probe-active-group => { root.probe-active-group(); }
                open-groups => { root.open-groups(); } activate-profile(id) => { root.activate-profile(id); }
                open-profiles => { root.open-profiles(); } open-logs => { root.open-logs(); } open-rules => { root.open-rules(); }
                drag-started(id, ax, ay) => { root.start-drag("deck", id, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
                drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
                report-hover(id, inside) => { root.report-hover-deck(id, inside); }
            }
        }

        if root.editing && root.is-sec-target : Rectangle {
            border-radius: 20px; border-width: 2px; border-color: Theme.accent;
            background: Theme.accent.with-alpha(Theme.dark ? 0.14 : 0.09);
            drop-shadow-blur: 14px; drop-shadow-color: Theme.accent.with-alpha(0.42);
        }
    }
}
