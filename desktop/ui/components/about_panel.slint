import { AboutSlint, ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { LayoutMetrics } from "../layout_metrics.slint";
import { Theme } from "../theme.slint";
import { WorkspaceState } from "../workspace_state.slint";
import { NexusVScrollBar, SlidingSegmentBar } from "glass_primitives.slint";
import { ThemeStudioCard } from "theme_studio_card.slint";
import { TraySettingsCard } from "tray_settings_card.slint";
import { ShortcutsCard } from "shortcuts_card.slint";

component SpecRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text-primary;
    in property <bool> show-divider: true;

    vertical-stretch: 0;

    HorizontalLayout {
        height: 38px;
        spacing: Theme.space-sm;

        Text {
            horizontal-stretch: 0;
            text: root.label;
            font-size: 12px;
            font-weight: 600;
            color: Theme.text-secondary;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.value;
            font-size: 12px;
            font-weight: 600;
            font-family: Theme.mono-font;
            color: root.value-color;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    if root.show-divider : Rectangle { height: 1px; background: Theme.hairline-subtle; }
}

component AboutIdentityCard inherits Rectangle {
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-md;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-md;

            Rectangle {
                width: 48px; height: 48px; border-radius: Theme.radius-md;
                border-width: 1px; border-color: Theme.accent.with-alpha(Theme.dark ? 0.42 : 0.28);
                background: Theme.accent-soft;
                Image {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 28px; height: 28px; source: @image-url("../icons/nexus-prism.svg");
                }
            }

            VerticalLayout {
                horizontal-stretch: 1; min-width: 0px; alignment: center; spacing: 3px;
                Text { text: "Nexus"; font-size: 20px; font-weight: 800; letter-spacing: 0.2px; color: Theme.text-primary; }
                Text { text: I18n.t("高性能跨平台网络代理客户端", "High-performance cross-platform proxy client"); font-size: 12px; color: Theme.text-secondary; overflow: elide; }
            }
        }

        Rectangle { height: 1px; background: Theme.hairline-subtle; }

        // Required attribution badge under Slint's Royalty-Free Desktop License
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            AboutSlint {
                vertical-stretch: 0;
                height: 96px;
            }
        }
    }
}

component AboutRuntimeCard inherits Rectangle {
    in property <bool> core-running: false;
    in property <bool> tun-enabled: false;

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;

    VerticalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-xs;

        Text {
            text: I18n.t("运行环境", "Runtime");
            font-size: 14px; font-weight: 700; color: Theme.text-primary;
        }

        Rectangle { height: 4px; }

        SpecRow {
            label: I18n.t("界面引擎", "UI Engine");
            value: "Slint 1.19";
        }
        SpecRow {
            label: I18n.t("核心模式", "Core Engine");
            value: root.core-running
                ? (WorkspaceState.host-is-linux
                    ? (root.tun-enabled ? I18n.t("io_uring · TUN 运行中", "io_uring · TUN Active") : I18n.t("io_uring · 运行中", "io_uring · Active"))
                    : (root.tun-enabled ? I18n.t("原生异步引擎 · TUN 运行中", "Native Async · TUN Active") : I18n.t("原生异步引擎 · 运行中", "Native Async · Active")))
                : (WorkspaceState.host-is-linux
                    ? I18n.t("io_uring / epoll · 待命", "io_uring / epoll · Standby")
                    : I18n.t("原生异步引擎 · 待命", "Native Async · Standby"));
            value-color: root.core-running ? Theme.success-fg : Theme.text-secondary;
        }
        SpecRow {
            label: I18n.t("配置管理", "Configuration");
            value: I18n.t("托管工作区 · 已就绪", "Managed Workspace · Ready");
            value-color: Theme.text-secondary;
            show-divider: false;
        }
    }
}

export component AboutPanel inherits VerticalLayout {
    in property <length> window-width: 1040px;
    in-out property <int> active-subtab: 0;

    in-out property <bool> close-to-tray: true;
    in-out property <bool> start-minimized: false;
    in-out property <bool> tray-show-nodes: true;
    in-out property <bool> tray-show-speed: true;
    in-out property <string> tray-click-action: "toggle";
    in property <bool> tray-native-active: true;
    in-out property <bool> tun-elevate-persistent: true;
    in property <string> tun-privilege-status: "needs_elevation";
    in property <bool> tun-persistent-granted: false;
    in property <bool> tun-can-persist: true;
    in property <bool> tun-privilege-busy: false;
    in property <bool> core-running: false;
    in property <bool> tun-enabled: false;

    callback tray-prefs-changed();
    callback ui-prefs-changed();
    callback grant-tun-privilege();
    callback revoke-tun-privilege();

    property <bool> is-compact: LayoutMetrics.is-compact-w(root.window-width);
    property <bool> about-two-col: root.window-width >= 840px;

    spacing: Theme.space-md;

    HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;

        SlidingSegmentBar {
            horizontal-stretch: root.is-compact ? 1 : 0;
            preferred-width: 340px;
            max-width: root.is-compact ? 9999px : 360px;
            bar-height: 32px;
            options: [I18n.t("外观", "Appearance"), I18n.t("系统", "System"), I18n.t("快捷键", "Shortcuts"), I18n.t("关于", "About")];
            current-index: root.active-subtab;
            selected(idx) => {
                root.active-subtab = idx;
                sv.content-y = 0px;
            }
        }

        if !root.is-compact : Rectangle { horizontal-stretch: 1; }
    }

    Rectangle {
        vertical-stretch: 1;
        clip: true;

        sv := ScrollView {
            width: 100%;
            height: 100%;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, settings-col.preferred-height);

            settings-col := VerticalLayout {
                x: 0px;
                y: 0px;
                width: min(780px, sv.visible-width);
                padding-right: 18px;
                padding-bottom: 6px;
                spacing: Theme.space-md;
                alignment: start;

                if root.active-subtab == 0 : ThemeStudioCard {
                    window-width: root.window-width;
                    prefs-changed => { root.ui-prefs-changed(); }
                }

                if root.active-subtab == 1 : TraySettingsCard {
                    window-width: root.window-width;
                    close-to-tray <=> root.close-to-tray;
                    start-minimized <=> root.start-minimized;
                    tray-show-nodes <=> root.tray-show-nodes;
                    tray-show-speed <=> root.tray-show-speed;
                    tray-click-action <=> root.tray-click-action;
                    tray-native-active: root.tray-native-active;
                    tun-elevate-persistent <=> root.tun-elevate-persistent;
                    tun-privilege-status: root.tun-privilege-status;
                    tun-persistent-granted: root.tun-persistent-granted;
                    tun-can-persist: root.tun-can-persist;
                    tun-privilege-busy: root.tun-privilege-busy;
                    prefs-changed => { root.tray-prefs-changed(); }
                    grant-tun-privilege => { root.grant-tun-privilege(); }
                    revoke-tun-privilege => { root.revoke-tun-privilege(); }
                }

                if root.active-subtab == 2 : ShortcutsCard {
                    window-width: root.window-width;
                }

                if root.active-subtab == 3 && root.about-two-col : HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    AboutIdentityCard { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
                    AboutRuntimeCard {
                        horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                        core-running: root.core-running; tun-enabled: root.tun-enabled;
                    }
                }

                if root.active-subtab == 3 && !root.about-two-col : VerticalLayout {
                    vertical-stretch: 0;
                    spacing: Theme.space-md;
                    AboutIdentityCard {}
                    AboutRuntimeCard {
                        core-running: root.core-running; tun-enabled: root.tun-enabled;
                    }
                }
            }
        }

        NexusVScrollBar {
            x: parent.width - self.width - 3px;
            y: 2px;
            height: max(0px, parent.height - 4px);
            viewport-size: sv.visible-height;
            content-size: sv.content-height;
            scroll-pos <=> sv.content-y;
        }
    }
}
