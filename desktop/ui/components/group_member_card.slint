import { ControlInspectState } from "../control_inspect_state.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { OutboundMemberItem } from "../types.slint";

// Matte Precision Node Card directly on canvas (no nested button inside card hit region)
export component GroupMemberCard inherits Rectangle {
    in property <OutboundMemberItem> member;
    in property <string> group-name: "";
    in property <int> group-max-latency-ms: 0;
    callback select-clicked();
    callback toggle-pin-clicked();
    callback probe-clicked();

    property <bool> is-selected: root.member.selected;
    property <bool> is-probing: ControlInspectState.probing-member-name != "" && ControlInspectState.probing-member-name == root.member.name;
    property <bool> is-timeout: root.member.latency-ms <= 0 && (root.member.state == "timeout" || root.member.state == "unreachable" || root.member.state == "error" || root.member.state == "failed");
    property <color> lat-color: Theme.latency-fg(root.member.latency-ms, root.member.state);
    property <int> bars: Theme.latency-bars(root.member.latency-ms);
    property <float> rel-lat-ratio: (root.member.latency-ms > 0 && root.group-max-latency-ms > 0)
        ? clamp(root.member.latency-ms / root.group-max-latency-ms, 0.08, 1.0) : 0.0;

    changed is-selected => {
        if (self.is-selected) {
            root.ensure-visible(Motion.reduced ? ScrollBehavior.instant : ScrollBehavior.smooth);
        }
    }

    height: 92px;
    border-radius: Theme.radius-card;
    border-width: card-fs.has-focus ? 2px : 1px;
    border-color:
        card-fs.has-focus ? Theme.accent
        : root.member.selected ? Theme.selected-border
        : is-timeout ? Theme.error-border
        : member-ta.has-hover ? Theme.hairline-strong
        : Theme.card-border;
    background:
        root.member.selected ? Theme.selected-bg
        : member-ta.has-hover ? Theme.row-hover-bg
        : Theme.card-surface;
    clip: true;
    animate border-color { duration: Motion.fast; }
    animate background { duration: Motion.fast; }

    // Subtle relative-latency background fill + 2px bottom indicator (healthy nodes only; preserves >12:1 text contrast)
    if root.rel-lat-ratio > 0.0 : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * root.rel-lat-ratio;
        height: parent.height;
        background: lat-color.with-alpha(Theme.dark ? 0.07 : 0.05);
    }

    if root.rel-lat-ratio > 0.0 : Rectangle {
        x: 0px;
        y: parent.height - 2px;
        width: parent.width * root.rel-lat-ratio;
        height: 2px;
        background: lat-color.with-alpha(Theme.dark ? 0.55 : 0.45);
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: I18n.t("选择此节点", "Select Node");
                enabled: !root.member.selected;
                activated => { root.select-clicked(); }
            }
            MenuItem {
                title: I18n.t("单节点测速", "Probe Node");
                activated => { root.probe-clicked(); }
            }
            MenuItem {
                title: root.member.pinned ? I18n.t("取消置顶", "Unpin Node") : I18n.t("置顶节点", "Pin Node");
                activated => { root.toggle-pin-clicked(); }
            }
        }

        VerticalLayout {
            padding: Theme.space-md;
            spacing: Theme.space-sm;

            // Top selectable region (outside bottom sibling probe/pin action buttons)
            Rectangle {
                vertical-stretch: 1;
                accessible-role: button;
                accessible-label: root.member.name;
                accessible-action-default => { if (!root.member.selected) { root.select-clicked(); } }

                card-fs := FocusScope {
                    key-pressed(ev) => {
                        if (!root.member.selected && (ev.text == Key.Return || ev.text == " ")) {
                            root.select-clicked();
                            return accept;
                        }
                        reject
                    }
                }

                member-ta := TouchArea {
                    mouse-cursor: root.member.selected ? default : pointer;
                    clicked => {
                        root.ensure-visible(Motion.reduced ? ScrollBehavior.instant : ScrollBehavior.smooth);
                        if (!root.member.selected) { root.select-clicked(); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.space-sm;

                    if root.member.selected : Image {
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/check.svg");
                        colorize: Theme.live-emerald;
                    }

                    if !root.member.selected : Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: is-timeout ? Theme.error-fg : (root.member.latency-ms > 0 ? lat-color : Theme.offline-fg);
                    }

                    Text {
                        text: root.member.name;
                        font-size: 14px;
                        font-weight: 700;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        overflow: elide;
                    }

                    if root.member.overridden : Rectangle {
                        horizontal-stretch: 0;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-xs;
                        background: Theme.warn-bg;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text { text: I18n.t("手动", "Manual"); font-size: 9px; font-weight: 700; color: Theme.warn-fg; vertical-alignment: center; }
                        }
                    }

                    if root.member.breaker-open : Rectangle {
                        horizontal-stretch: 0;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-xs;
                        background: Theme.error-bg;
                        HorizontalLayout {
                            padding-left: 5px; padding-right: 5px;
                            Text { text: I18n.t("熔断", "Breaker"); font-size: 9px; font-weight: 700; color: Theme.error-fg; vertical-alignment: center; }
                        }
                    }
                }
            }

            // Bottom row: 4-bar meter left + single fixed-width latency badge + 26px sibling probe/pin controls
            HorizontalLayout {
                vertical-stretch: 0;
                height: 26px;
                spacing: 6px;

                HorizontalLayout {
                    horizontal-stretch: 0; width: 20px; spacing: 2px; padding-top: 5px; padding-bottom: 5px;
                    Rectangle { width: 3.5px; height: 5px; y: parent.height - self.height - 5px; border-radius: 1.5px; background: bars >= 1 ? lat-color : Theme.offline-fg; opacity: bars >= 1 ? 1.0 : 0.28; }
                    Rectangle { width: 3.5px; height: 8px; y: parent.height - self.height - 5px; border-radius: 1.5px; background: bars >= 2 ? lat-color : Theme.offline-fg; opacity: bars >= 2 ? 1.0 : 0.25; }
                    Rectangle { width: 3.5px; height: 11px; y: parent.height - self.height - 5px; border-radius: 1.5px; background: bars >= 3 ? lat-color : Theme.offline-fg; opacity: bars >= 3 ? 1.0 : 0.22; }
                    Rectangle { width: 3.5px; height: 14px; y: parent.height - self.height - 5px; border-radius: 1.5px; background: bars >= 4 ? lat-color : Theme.offline-fg; opacity: bars >= 4 ? 1.0 : 0.20; }
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    horizontal-stretch: 0;
                    min-width: 58px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: Theme.latency-bg(root.member.latency-ms, root.member.state);
                    HorizontalLayout {
                        padding-left: 7px; padding-right: 7px;
                        Text {
                            horizontal-stretch: 1;
                            text: root.member.latency-ms > 0 ? "\{root.member.latency-ms} ms" : (is-timeout ? I18n.t("超时", "Timeout") : "--");
                            font-size: 11px; font-weight: 700; font-family: Theme.mono-font;
                            horizontal-alignment: right; vertical-alignment: center; color: lat-color;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 0; width: 26px; height: 26px; border-radius: Theme.radius-sm;
                    border-width: probe-fs.has-focus ? 2px : 0px;
                    border-color: probe-fs.has-focus ? Theme.accent : transparent;
                    background: probe-ta.has-hover ? Theme.well-bg : transparent;
                    opacity: root.is-probing || member-ta.has-hover || probe-ta.has-hover || probe-fs.has-focus ? 1.0 : 0.72;
                    transform-scale: (probe-ta.pressed && !root.is-probing) ? 0.97 : 1.0;
                    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }
                    accessible-role: button;
                    accessible-label: I18n.t("测速", "Probe");
                    accessible-action-default => { if (!root.is-probing) { root.probe-clicked(); } }
                    probe-fs := FocusScope {
                        enabled: !root.is-probing;
                        key-pressed(ev) => {
                            if (!root.is-probing && (ev.text == Key.Return || ev.text == " ")) { root.probe-clicked(); return accept; }
                            reject
                        }
                    }
                    probe-ta := TouchArea {
                        enabled: !root.is-probing;
                        mouse-cursor: root.is-probing ? default : pointer;
                        clicked => { root.probe-clicked(); }
                    }
                    Image {
                        x: 6px; y: 6px; width: 14px; height: 14px;
                        source: root.is-probing ? @image-url("../icons/loader.svg") : @image-url("../icons/bolt.svg");
                        colorize: root.is-probing ? Theme.accent : probe-ta.has-hover ? Theme.accent : Theme.text-secondary;
                        transform-rotation: root.is-probing && !Motion.reduced ? 360deg * (mod(animation-tick(), 900ms) / 900ms) : 0deg;
                    }
                }

                Rectangle {
                    horizontal-stretch: 0; width: 26px; height: 26px; border-radius: Theme.radius-sm;
                    border-width: pin-fs.has-focus ? 2px : 0px;
                    border-color: pin-fs.has-focus ? Theme.accent : transparent;
                    background: pin-ta.has-hover ? Theme.well-bg : transparent;
                    opacity: root.member.pinned || member-ta.has-hover || pin-ta.has-hover || pin-fs.has-focus ? 1.0 : 0.72;
                    transform-scale: pin-ta.pressed ? 0.97 : 1.0;
                    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }
                    accessible-role: button;
                    accessible-label: root.member.pinned ? I18n.t("取消置顶", "Unpin") : I18n.t("置顶", "Pin");
                    accessible-action-default => { root.toggle-pin-clicked(); }
                    pin-fs := FocusScope {
                        key-pressed(ev) => {
                            if (ev.text == Key.Return || ev.text == " ") { root.toggle-pin-clicked(); return accept; }
                            reject
                        }
                    }
                    pin-ta := TouchArea { mouse-cursor: pointer; clicked => { root.toggle-pin-clicked(); } }
                    Image {
                        x: 6px; y: 6px; width: 14px; height: 14px;
                        source: root.member.pinned ? @image-url("../icons/star-filled.svg") : @image-url("../icons/star.svg");
                        colorize: root.member.pinned ? Theme.warn-fg : Theme.text-secondary;
                    }
                }
            }
        }
    }
}
