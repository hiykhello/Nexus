import { CommandPaletteState } from "../command_palette_state.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Shortcuts } from "../shortcuts.slint";
import { Theme } from "../theme.slint";

component FooterActionButton inherits Rectangle {
    in property <string> label;
    in property <string> tone: "neutral"; // "neutral" | "accent" | "danger"
    in property <bool> enabled: true;
    callback clicked();

    forward-focus: fs;
    horizontal-stretch: 0;
    height: 22px;
    border-radius: Theme.radius-xs;
    border-width: fs.has-focus ? 2px : 1px;
    border-color:
        fs.has-focus ? Theme.accent
        : !root.enabled ? Theme.well-border
        : root.tone == "accent" ? Theme.pill-active-top
        : root.tone == "danger" ? Theme.error-border
        : ta.has-hover ? Theme.hairline-strong : Theme.well-border;
    background:
        !root.enabled ? Theme.well-bg
        : root.tone == "accent" ? (ta.pressed ? Theme.pill-active-bot.darker(0.12) : Theme.pill-active-bot)
        : root.tone == "danger" ? (ta.has-hover ? Theme.error-fg.with-alpha(0.24) : Theme.error-bg)
        : ta.has-hover ? Theme.row-hover-bg : Theme.well-bg;
    opacity: root.enabled ? 1.0 : 0.50;
    transform-scale: (ta.pressed && root.enabled) ? 0.97 : 1.0;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(ev) => {
            if (root.enabled && (ev.text == Key.Return || ev.text == " ")) {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color:
                !root.enabled ? Theme.text-muted
                : root.tone == "accent" ? Theme.pill-active-fg
                : root.tone == "danger" ? Theme.error-fg
                : Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

export component BottomStatusBar inherits Rectangle {
    in property <bool> core-running: false;
    in property <bool> core-toggling: false;
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;
    in property <bool> conn-probe-busy: false;
    in property <bool> groups-probing: false;

    callback probe-connectivity();
    callback probe-all-nodes();
    callback toggle-core();

    height: 32px;
    vertical-stretch: 0;
    background: Theme.sidebar-card-bg;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 1px;
        background: Theme.card-border;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background:
                !root.diagnostic-ok && root.diagnostic-message != "" ? Theme.error-fg
                : root.core-toggling ? Theme.warn-fg
                : root.core-running ? Theme.live-emerald
                : Theme.offline-fg;
        }

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text:
                root.diagnostic-message != "" ? root.diagnostic-message
                : root.core-toggling ? I18n.t("正在切换代理内核状态...", "Switching proxy state...")
                : root.core-running ? I18n.t("代理内核运行中", "Proxy core active")
                : I18n.t("就绪", "Ready");
            font-size: 11px;
            font-weight: 500;
            color: !root.diagnostic-ok && root.diagnostic-message != "" ? Theme.error-fg : Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                forward-focus: pal-fs;
                horizontal-stretch: 0;
                height: 22px;
                border-radius: Theme.radius-xs;
                border-width: pal-fs.has-focus ? 2px : 1px;
                border-color: pal-fs.has-focus ? Theme.accent : (pal-ta.has-hover ? Theme.hairline-strong : Theme.well-border);
                background: pal-ta.has-hover ? Theme.row-hover-bg : Theme.well-bg;

                accessible-role: button;
                accessible-label: I18n.t("命令面板", "Command Palette");
                accessible-action-default => { CommandPaletteState.toggle-palette(); }

                pal-fs := FocusScope {
                    key-pressed(ev) => {
                        if (ev.text == Key.Return || ev.text == " ") { CommandPaletteState.toggle-palette(); return accept; }
                        reject
                    }
                }
                pal-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { CommandPaletteState.toggle-palette(); }
                }
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    spacing: 5px;
                    Image {
                        width: 11px; height: 11px; y: (parent.height - self.height) / 2;
                        source: @image-url("../icons/search.svg");
                        colorize: Theme.text-secondary;
                    }
                    Text {
                        text: Shortcuts.format-full(Shortcuts.command-palette);
                        font-size: 10px; font-weight: 700; font-family: Theme.mono-font;
                        color: Theme.text-secondary; vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            FooterActionButton {
                label: root.conn-probe-busy ? I18n.t("检测中...", "Probing...") : I18n.t("网络检测", "Net Check");
                enabled: root.core-running && !root.conn-probe-busy;
                clicked => { root.probe-connectivity(); }
            }
        }

        VerticalLayout {
            alignment: center;
            FooterActionButton {
                label: root.groups-probing ? I18n.t("测速中...", "Testing...") : I18n.t("测速全部", "Test All");
                enabled: root.core-running && !root.groups-probing;
                clicked => { root.probe-all-nodes(); }
            }
        }

        VerticalLayout {
            alignment: center;
            FooterActionButton {
                label: root.core-toggling
                    ? I18n.t("处理中...", "Working...")
                    : root.core-running ? I18n.t("停止代理", "Stop Proxy") : I18n.t("启动代理", "Start Proxy");
                tone: root.core-running ? "danger" : "accent";
                enabled: !root.core-toggling;
                clicked => { root.toggle-core(); }
            }
        }
    }
}
