import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { ActiveConnectionItem, OutboundGroupItem } from "../types.slint";
import { HeroStatusCard, SpeedMiniCard } from "dash_perf_cards.slint";
import { AppPerfCard, CorePerfCard } from "dash_process_cards.slint";
import { ConnectionsPreviewCard, QuickSwitchRow } from "dash_row_cards.slint";
import { OutboundModeCard, PolicyGroupsCard, RoutingSummaryCard, ServiceHealthCard } from "dash_utility_cards.slint";

// Zero-Scroll 4-Row Matte Bento Overview Console (1280x760 fits in one screen; stacks cleanly on compact <960px)
export component StatusCard inherits VerticalLayout {
    in property <length> window-width: 1280px;
    in property <bool> core-running: false;
    in property <bool> core-toggling: false;
    in property <string> core-uptime: "";
    in property <string> app-pid-text: "--";
    in property <string> app-cpu-text: "0.0%";
    in property <float> app-cpu-ratio: 0.0;
    in property <string> app-memory-text: "--";
    in property <string> core-pid-text: "";
    in property <string> core-cpu-text: "--";
    in property <float> core-cpu-ratio: 0.0;
    in property <string> core-memory-text: "--";
    in property <string> outbound-mode: "rule";
    in property <bool> system-proxy-supported: true;
    in property <bool> system-proxy-enabled: false;
    in property <bool> mixed-proxy-enabled: true;
    in property <string> mixed-proxy-port: "7890";
    in property <bool> lan-share-enabled: false;
    in property <string> lan-share-subtitle: "";
    in property <bool> tun-enabled: false;
    in property <string> active-profile: "";
    in property <string> active-node: "";
    in property <int> active-node-latency-ms: -1;
    in property <int> active-sessions: 0;
    in property <[ActiveConnectionItem]> connections: [];
    in property <[OutboundGroupItem]> groups: [];
    in property <string> selected-group: "";
    in property <string> active-routing-name: "";
    in property <int> active-rule-count: 0;
    in property <string> upload-total: "0 B";
    in property <string> download-total: "0 B";
    in property <string> down-speed-value: "0.0";
    in property <string> down-speed-unit: "KB/s";
    in property <string> down-speed-peak: "0.0 KB/s";
    in property <string> down-wave-area: "";
    in property <string> down-wave-line: "";
    in property <string> up-speed-value: "0.0";
    in property <string> up-speed-unit: "KB/s";
    in property <string> up-speed-peak: "0.0 KB/s";
    in property <string> up-wave-area: "";
    in property <string> up-wave-line: "";
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;
    in property <string> hero-state-override: "";
    in property <bool> conn-probe-busy: false;
    in property <int> conn-google-ms: -1;
    in property <int> conn-cf-ms: -1;
    in property <int> conn-github-ms: -1;
    in property <int> conn-youtube-ms: -1;

    callback toggle-core();
    callback switch-outbound-mode(string);
    callback toggle-system-proxy(bool);
    callback toggle-tun(bool);
    callback toggle-mixed-port(bool);
    callback toggle-lan-share(bool);
    callback probe-connectivity();
    callback clear-cache();
    callback choose-group(string);
    callback open-groups();
    callback open-connections();
    callback open-rules();

    property <bool> is-desktop-grid: root.window-width >= 960px;

    padding: 12px;
    spacing: 10px;

    // Desktop Precision 4-Row Zero-Scroll Bento Grid (>= 960px)
    if root.is-desktop-grid : VerticalLayout {
        vertical-stretch: 1;
        spacing: 10px;

        // Row 1 (2fr : 1fr : 1fr): Status Hero | Upload | Download
        HorizontalLayout {
            vertical-stretch: 0;
            height: 150px;
            spacing: 10px;

            HeroStatusCard {
                horizontal-stretch: 2;
                preferred-width: 0px;
                min-width: 0px;
                core-running: root.core-running;
                core-toggling: root.core-toggling;
                core-uptime: root.core-uptime;
                active-profile: root.active-profile;
                active-node: root.active-node;
                active-node-latency-ms: root.active-node-latency-ms;
                outbound-mode: root.outbound-mode;
                tun-enabled: root.tun-enabled;
                diagnostic-message: root.diagnostic-message;
                diagnostic-ok: root.diagnostic-ok;
                hero-state-override: root.hero-state-override;
                toggle-core => { root.toggle-core(); }
                open-groups => { root.open-groups(); }
            }

            SpeedMiniCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                title: I18n.t("实时上传", "Upload");
                rate-value: root.up-speed-value;
                rate-unit: root.up-speed-unit;
                peak-text: root.up-speed-peak;
                total-text: root.upload-total;
                wave-area: root.up-wave-area;
                wave-line: root.up-wave-line;
                channel-color: Theme.telemetry-up;
            }

            SpeedMiniCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                title: I18n.t("实时下载", "Download");
                rate-value: root.down-speed-value;
                rate-unit: root.down-speed-unit;
                peak-text: root.down-speed-peak;
                total-text: root.download-total;
                wave-area: root.down-wave-area;
                wave-line: root.down-wave-line;
                channel-color: Theme.telemetry-down;
            }
        }

        // Row 2 (2fr : 1fr : 1fr): Active Connections Preview | App Performance | Core Performance
        HorizontalLayout {
            vertical-stretch: 1;
            min-height: 186px;
            spacing: 10px;

            ConnectionsPreviewCard {
                horizontal-stretch: 2;
                preferred-width: 0px;
                min-width: 0px;
                active-sessions: root.active-sessions;
                connections: root.connections;
                open-connections => { root.open-connections(); }
            }

            AppPerfCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                pid-text: root.app-pid-text;
                cpu-text: root.app-cpu-text;
                cpu-ratio: root.app-cpu-ratio;
                memory-text: root.app-memory-text;
            }

            CorePerfCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                core-running: root.core-running;
                pid-text: root.core-pid-text;
                cpu-text: root.core-cpu-text;
                cpu-ratio: root.core-cpu-ratio;
                memory-text: root.core-memory-text;
                clear-cache => { root.clear-cache(); }
            }
        }

        // Row 3 (1fr x 4): Service Health | Routing Rules | Outbound Mode | Policy Groups
        HorizontalLayout {
            vertical-stretch: 1;
            min-height: 184px;
            spacing: 10px;

            ServiceHealthCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                core-running: root.core-running;
                probe-busy: root.conn-probe-busy;
                google-ms: root.conn-google-ms;
                cf-ms: root.conn-cf-ms;
                github-ms: root.conn-github-ms;
                youtube-ms: root.conn-youtube-ms;
                probe-connectivity => { root.probe-connectivity(); }
            }

            RoutingSummaryCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                routing-name: root.active-routing-name;
                rule-count: root.active-rule-count;
                outbound-mode: root.outbound-mode;
                open-rules => { root.open-rules(); }
            }

            OutboundModeCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                outbound-mode: root.outbound-mode;
                switch-outbound-mode(m) => { root.switch-outbound-mode(m); }
            }

            PolicyGroupsCard {
                horizontal-stretch: 1;
                preferred-width: 0px;
                min-width: 0px;
                groups: root.groups;
                selected-group: root.selected-group;
                choose-group(t) => { root.choose-group(t); }
                open-groups => { root.open-groups(); }
            }
        }

        // Row 4 (1fr x 4): Port Proxy | LAN Proxy | System Proxy | TUN Mode
        QuickSwitchRow {
            mixed-enabled: root.mixed-proxy-enabled;
            mixed-port: root.mixed-proxy-port;
            lan-enabled: root.lan-share-enabled;
            lan-subtitle: root.lan-share-subtitle;
            sys-proxy-supported: root.system-proxy-supported;
            sys-proxy-enabled: root.system-proxy-enabled;
            tun-enabled: root.tun-enabled;
            toggle-mixed-port(on) => { root.toggle-mixed-port(on); }
            toggle-lan-share(on) => { root.toggle-lan-share(on); }
            toggle-system-proxy(on) => { root.toggle-system-proxy(on); }
            toggle-tun(on) => { root.toggle-tun(on); }
        }
    }

    // Compact Stacked Layout (< 960px, e.g. 780x560)
    if !root.is-desktop-grid : VerticalLayout {
        spacing: 10px;
        alignment: start;

        HeroStatusCard {
            height: 146px;
            core-running: root.core-running;
            core-toggling: root.core-toggling;
            core-uptime: root.core-uptime;
            active-profile: root.active-profile;
            active-node: root.active-node;
            active-node-latency-ms: root.active-node-latency-ms;
            outbound-mode: root.outbound-mode;
            tun-enabled: root.tun-enabled;
            diagnostic-message: root.diagnostic-message;
            diagnostic-ok: root.diagnostic-ok;
            hero-state-override: root.hero-state-override;
            toggle-core => { root.toggle-core(); }
            open-groups => { root.open-groups(); }
        }

        HorizontalLayout {
            height: 138px;
            spacing: 10px;
            SpeedMiniCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                title: I18n.t("实时上传", "Upload");
                rate-value: root.up-speed-value; rate-unit: root.up-speed-unit;
                peak-text: root.up-speed-peak; total-text: root.upload-total;
                wave-area: root.up-wave-area; wave-line: root.up-wave-line;
                channel-color: Theme.telemetry-up;
            }
            SpeedMiniCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                title: I18n.t("实时下载", "Download");
                rate-value: root.down-speed-value; rate-unit: root.down-speed-unit;
                peak-text: root.down-speed-peak; total-text: root.download-total;
                wave-area: root.down-wave-area; wave-line: root.down-wave-line;
                channel-color: Theme.telemetry-down;
            }
        }

        QuickSwitchRow {
            compact: true;
            mixed-enabled: root.mixed-proxy-enabled;
            mixed-port: root.mixed-proxy-port;
            lan-enabled: root.lan-share-enabled;
            lan-subtitle: root.lan-share-subtitle;
            sys-proxy-supported: root.system-proxy-supported;
            sys-proxy-enabled: root.system-proxy-enabled;
            tun-enabled: root.tun-enabled;
            toggle-mixed-port(on) => { root.toggle-mixed-port(on); }
            toggle-lan-share(on) => { root.toggle-lan-share(on); }
            toggle-system-proxy(on) => { root.toggle-system-proxy(on); }
            toggle-tun(on) => { root.toggle-tun(on); }
        }

        HorizontalLayout {
            height: 186px;
            spacing: 10px;
            AppPerfCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                pid-text: root.app-pid-text; cpu-text: root.app-cpu-text; cpu-ratio: root.app-cpu-ratio; memory-text: root.app-memory-text;
            }
            CorePerfCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                core-running: root.core-running; pid-text: root.core-pid-text; cpu-text: root.core-cpu-text; cpu-ratio: root.core-cpu-ratio; memory-text: root.core-memory-text;
                clear-cache => { root.clear-cache(); }
            }
        }

        ConnectionsPreviewCard {
            height: 176px;
            active-sessions: root.active-sessions;
            connections: root.connections;
            open-connections => { root.open-connections(); }
        }

        HorizontalLayout {
            height: 180px;
            spacing: 10px;
            ServiceHealthCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                core-running: root.core-running; probe-busy: root.conn-probe-busy;
                google-ms: root.conn-google-ms; cf-ms: root.conn-cf-ms; github-ms: root.conn-github-ms; youtube-ms: root.conn-youtube-ms;
                probe-connectivity => { root.probe-connectivity(); }
            }
            OutboundModeCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                outbound-mode: root.outbound-mode;
                switch-outbound-mode(m) => { root.switch-outbound-mode(m); }
            }
        }

        HorizontalLayout {
            height: 164px;
            spacing: 10px;
            RoutingSummaryCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                routing-name: root.active-routing-name; rule-count: root.active-rule-count; outbound-mode: root.outbound-mode;
                open-rules => { root.open-rules(); }
            }
            PolicyGroupsCard {
                horizontal-stretch: 1; preferred-width: 0px; min-width: 0px;
                groups: root.groups; selected-group: root.selected-group;
                choose-group(t) => { root.choose-group(t); }
                open-groups => { root.open-groups(); }
            }
        }
    }
}
