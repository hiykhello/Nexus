import { ToastState } from "../feedback.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { I18n } from "../i18n.slint";
import { GlassSpeculum, NexusInput, SlidingSegmentBar } from "glass_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusSwitch } from "nexus_controls.slint";

export component TonalToggleTile inherits Rectangle {
    in property <string> label;
    in property <string> subtitle: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback toggled(bool);

    height: root.compact ? 42px : 48px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(Theme.dark ? 0.44 : 0.34) : Theme.well-border;
    background:
        root.active ? Theme.accent.with-alpha(Theme.dark ? 0.14 : 0.08)
        : (root.enabled && tile-ta.has-hover) ? Theme.row-hover-bg
        : Theme.well-bg;
    opacity: root.enabled ? 1.0 : 0.54;
    transform-scale: root.enabled && tile-ta.pressed ? 0.985 : 1.0;
    animate border-color { duration: Motion.fast; }
    animate background { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.34, 1.56, 0.64, 1.0); }

    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.active;
    accessible-action-default => {
        if (root.enabled) { root.toggled(!root.active); }
    }

    tile-ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!root.active); }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-sm;
        spacing: Theme.space-xs;

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.label;
                font-size: 13px;
                font-weight: root.active ? 700 : 600;
                color: root.active ? Theme.nav-active-fg : Theme.text-primary;
                overflow: elide;
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                font-size: 11px;
                font-family: Theme.mono-font;
                color: root.active ? Theme.text-secondary : Theme.text-muted;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            NexusSwitch {
                enabled: root.enabled;
                checked: root.active;
                interactive: false;
            }
        }
    }
}

export component DashboardKpiTile inherits Rectangle {
    in property <string> caption;
    in property <string> value;
    in property <string> subvalue: "";
    in property <color> dot-color: Theme.accent;
    in property <brush> subvalue-color: Theme.text-secondary;
    in property <bool> clickable: false;
    in property <bool> mono-value: true;
    in property <bool> compact: false;
    in property <int> signal-bars: -1;
    in property <color> signal-color: Theme.accent;
    callback clicked();

    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: root.compact ? 66px : 82px;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: root.clickable && ta.has-hover ? Theme.selected-border : Theme.card-border;
    background: root.clickable && ta.has-hover ? Theme.row-hover-bg : Theme.card-surface;
    drop-shadow-blur: root.clickable && ta.has-hover ? 16px : 10px;
    drop-shadow-offset-y: root.clickable && ta.has-hover ? 4px : 2px;
    drop-shadow-color: root.clickable && ta.has-hover ? Theme.card-hover-shadow : Theme.card-shadow;
    transform-scale: root.clickable && ta.pressed ? 0.98 : 1.0;
    animate border-color { duration: Motion.fast; }
    animate drop-shadow-blur { duration: Motion.fast; }
    animate drop-shadow-offset-y { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.34, 1.56, 0.64, 1.0); }

    GlassSpeculum {}

    ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }

    if root.clickable : FocusScope {
        width: 0px;
        height: 0px;
        accessible-role: button;
        accessible-label: root.caption + " " + root.value;
        accessible-action-default => { root.clicked(); }
    }

    VerticalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        padding-top: root.compact ? 7px : 10px;
        padding-bottom: root.compact ? 7px : 10px;
        alignment: space-between;
        spacing: root.compact ? 1px : 2px;

        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                y: (parent.height - self.height) / 2;
                background: root.dot-color;
            }
            Text {
                text: root.caption;
                font-size: 11px;
                font-weight: 600;
                color: Theme.text-muted;
                horizontal-stretch: 1;
                min-width: 0px;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.clickable : Rectangle {
                width: 14px;
                height: 14px;
                Text {
                    x: ta.has-hover ? 3px : 1px;
                    y: ta.has-hover ? -1px : 1px;
                    text: "↗";
                    font-size: 11px;
                    font-weight: 700;
                    color: ta.has-hover ? Theme.accent : Theme.text-muted;
                    animate x { duration: Motion.fast; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                    animate y { duration: Motion.fast; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                }
            }
        }

        Text {
            text: root.value;
            font-size: root.compact ? (root.mono-value ? 16px : 15px) : (root.mono-value ? 18px : 16px);
            font-weight: 700;
            font-family: root.mono-value ? Theme.mono-font : "";
            color: Theme.text-primary;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px;
            if root.signal-bars >= 0 : HorizontalLayout {
                width: 18px;
                spacing: 2px;
                padding-top: 2px;
                padding-bottom: 2px;
                Rectangle { width: 3px; height: 4px; y: parent.height - self.height - 2px; border-radius: 1.5px; background: root.signal-bars >= 1 ? root.signal-color : Theme.offline-fg; opacity: root.signal-bars >= 1 ? 1.0 : 0.28; }
                Rectangle { width: 3px; height: 6px; y: parent.height - self.height - 2px; border-radius: 1.5px; background: root.signal-bars >= 2 ? root.signal-color : Theme.offline-fg; opacity: root.signal-bars >= 2 ? 1.0 : 0.24; }
                Rectangle { width: 3px; height: 8px; y: parent.height - self.height - 2px; border-radius: 1.5px; background: root.signal-bars >= 3 ? root.signal-color : Theme.offline-fg; opacity: root.signal-bars >= 3 ? 1.0 : 0.22; }
                Rectangle { width: 3px; height: 10px; y: parent.height - self.height - 2px; border-radius: 1.5px; background: root.signal-bars >= 4 ? root.signal-color : Theme.offline-fg; opacity: root.signal-bars >= 4 ? 1.0 : 0.20; }
            }
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.subvalue;
                font-size: root.compact ? 10px : 11px;
                font-family: root.mono-value ? Theme.mono-font : "";
                color: root.subvalue-color;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component InboundEndpointRow inherits Rectangle {
    in property <string> protocol;
    in property <bool> core-running: false;
    in property <bool> compact: false;
    in-out property <bool> enabled: true;
    in-out property <string> host: "127.0.0.1";
    in-out property <string> port: "";
    in property <string> default-port: "";
    callback changed();
    callback copy-endpoint(string);

    property <bool> live: root.enabled && root.core-running;
    private property <bool> copied: false;

    vertical-stretch: 0;
    height: root.compact ? 42px : 44px;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: root.enabled ? Theme.accent.with-alpha(0.30) : Theme.well-border;
    background: root.enabled ? Theme.row-bg : Theme.well-bg;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }

    Timer {
        interval: 1400ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    HorizontalLayout {
        padding-left: root.compact ? Theme.space-sm : Theme.space-md;
        padding-right: Theme.space-sm;
        spacing: root.compact ? 6px : Theme.space-sm;

        VerticalLayout {
            alignment: center;
            NexusSwitch {
                checked <=> root.enabled;
                toggled => { root.changed(); }
            }
        }

        Rectangle {
            width: root.compact ? 50px : 56px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xs;
            background: root.enabled ? Theme.accent-soft : Theme.row-alt-bg;
            Text {
                width: 100%;
                height: 100%;
                text:
                    root.protocol == "mixed" ? I18n.t("混合", "Mixed")
                    : root.protocol == "socks5" ? "SOCKS"
                    : "HTTP";
                font-size: 10px;
                font-weight: 700;
                color: root.enabled ? Theme.nav-active-fg : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if !root.compact : NexusInput {
            min-width: 88px;
            preferred-width: 120px;
            max-width: 164px;
            horizontal-stretch: 1;
            input-height: 28px;
            y: (parent.height - self.height) / 2;
            mono: true;
            text <=> root.host;
            placeholder-text: "127.0.0.1";
            accepted => { root.changed(); }
        }

        if root.compact : Rectangle { horizontal-stretch: 1; }

        Text {
            text: ":";
            font-size: 13px;
            font-weight: 700;
            color: Theme.text-muted;
            opacity: root.enabled ? 1.0 : 0.5;
            vertical-alignment: center;
        }

        NexusInput {
            width: 60px;
            input-height: 28px;
            y: (parent.height - self.height) / 2;
            mono: true;
            text <=> root.port;
            placeholder-text: root.default-port;
            accepted => { root.changed(); }
        }

        VerticalLayout {
            alignment: center;
            IconActionButton {
                size: 26px;
                icon: root.copied ? @image-url("../icons/check.svg") : @image-url("../icons/copy.svg");
                success: root.copied;
                label: root.copied ? I18n.t("已复制", "Copied") : I18n.t("复制", "Copy");
                clicked => {
                    let p = root.port != "" ? root.port : root.default-port;
                    let ep = ToastState.format-endpoint(root.host, p);
                    if (ep != "") {
                        root.copied = true;
                        root.copy-endpoint(ep);
                        ToastState.push(I18n.t("已复制 ", "Copied ") + ep, "success");
                    }
                }
            }
        }

        if !root.compact : Rectangle { horizontal-stretch: 1; }

        if !root.compact : Rectangle {
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xs;
            background:
                root.live ? Theme.success-bg
                : root.enabled ? Theme.accent-soft
                : Theme.row-alt-bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 5px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background:
                        root.live ? Theme.success-fg
                        : root.enabled ? Theme.accent
                        : Theme.offline-fg;
                }
                Text {
                    text:
                        root.live ? I18n.t("运行", "Live")
                        : root.enabled ? I18n.t("就绪", "Ready")
                        : I18n.t("关闭", "Off");
                    font-size: 11px;
                    font-weight: 600;
                    color:
                        root.live ? Theme.success-fg
                        : root.enabled ? Theme.nav-active-fg
                        : Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        if root.compact : Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background:
                root.live ? Theme.success-fg
                : root.enabled ? Theme.accent
                : Theme.offline-fg;
        }
    }
}

export component OutboundModeBar inherits Rectangle {
    in property <string> mode: "rule";
    in property <bool> compact: false;
    callback mode-selected(string);

    vertical-stretch: 0;
    height: root.compact ? 34px : 38px;

    SlidingSegmentBar {
        width: 100%;
        height: 100%;
        bar-height: root.compact ? 34px : 38px;
        options: [I18n.t("规则", "Rule"), I18n.t("全局", "Global"), I18n.t("直连", "Direct")];
        current-index: root.mode == "global" ? 1 : root.mode == "direct" ? 2 : 0;
        selected(idx) => {
            let next = idx == 1 ? "global" : idx == 2 ? "direct" : "rule";
            root.mode-selected(next);
        }
    }
}
