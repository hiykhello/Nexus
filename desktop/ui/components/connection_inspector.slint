import { ToastState } from "../feedback.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { ProportionBar } from "nexus_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusButton } from "nexus_buttons.slint";

component MetaKeyValueRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: true;
    in property <bool> copyable: false;
    in property <bool> accent-value: false;
    in property <bool> show-divider: true;
    callback copy-clicked(string);

    vertical-stretch: 0;

    HorizontalLayout {
        height: 32px;
        spacing: Theme.space-sm;

        Text {
            horizontal-stretch: 0;
            width: 68px;
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.value != "" ? root.value : "-";
            font-size: 12px;
            font-weight: root.accent-value ? 700 : 600;
            font-family: root.mono ? Theme.mono-font : "";
            color: root.accent-value ? Theme.nav-active-fg : Theme.text-primary;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.copyable && root.value != "" : VerticalLayout {
            alignment: center;
            IconActionButton {
                size: 20px;
                icon: @image-url("../icons/copy.svg");
                label: I18n.t("复制", "Copy");
                clicked => {
                    root.copy-clicked(root.value);
                    ToastState.push(I18n.t("已复制 ", "Copied ") + root.value, "success");
                }
            }
        }
    }

    if root.show-divider : Rectangle { height: 1px; background: Theme.hairline-subtle; }
}

component RuleToneSegment inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <string> tone: "accent"; // "direct" | "accent" | "danger"
    callback clicked();

    forward-focus: fs;
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    height: 26px;
    border-radius: Theme.radius-xs;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: fs.has-focus ? Theme.accent : transparent;
    background:
        root.active
            ? (root.tone == "danger" ? Theme.pill-danger-bot
                : root.tone == "direct" ? Theme.pill-direct-bot
                : Theme.pill-active-bot)
            : ta.has-hover ? Theme.row-hover-bg : transparent;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Return || ev.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: 12px;
        font-weight: root.active ? 700 : 600;
        color:
            root.active
                ? (root.tone == "accent" ? Theme.pill-active-fg : Theme.selection-fg)
                : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component ConnectionInspectorCard inherits Rectangle {
    in property <string> conn-id: "";
    in property <string> protocol: "";
    in property <string> target-host: "";
    in property <int> dest-port: 0;
    in property <string> inbound: "";
    in property <string> outbound: "";
    in property <string> route-rule: "";
    in property <string> process-path: "";
    in property <string> source-addr: "";
    in property <string> duration-text: "";
    in property <string> upload-text: "0 B";
    in property <string> download-text: "0 B";
    in property <float> up-ratio: 0.0;
    in property <bool> has-traffic: false;
    in property <string> raw-detail: "";
    in property <bool> side-pane: false;
    in property <string> default-proxy-outbound: "proxy";

    callback dismiss();
    callback copy-text(string);
    callback close-connection(string);
    callback create-rule-from-connection(string, int, string, string, string);

    private property <string> custom-rule-action: "";
    changed conn-id => { root.custom-rule-action = ""; }

    property <string> eff-rule-action:
        root.custom-rule-action != "" ? root.custom-rule-action
        : (root.outbound == "direct" ? "proxy" : "direct");

    property <bool> has-selection: root.conn-id != "" || root.raw-detail != "";
    property <bool> is-udp: root.protocol == "QUIC" || root.protocol == "UDP" || root.protocol == "udp/quic";
    property <bool> is-tls: root.protocol == "TLS" || root.protocol == "tcp/tls";
    property <string> display-target:
        root.target-host != "" ? root.target-host
        : root.dest-port > 0 ? "\{root.outbound}:\{root.dest-port}" : root.outbound;
    property <string> source-chip:
        root.process-path != "" ? root.process-path
        : root.source-addr != "" ? root.source-addr
        : I18n.t("本机", "Local");

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.has-selection ? Theme.selected-border : Theme.card-border;
    background: Theme.card-surface;
    clip: true;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        if !root.has-selection : VerticalLayout {
            padding: Theme.space-lg;
            spacing: Theme.space-sm;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 44px; height: 44px; border-radius: 22px;
                    background: Theme.well-bg; border-width: 1px; border-color: Theme.well-border;
                    Image { x: 12px; y: 12px; width: 20px; height: 20px; source: @image-url("../icons/connections.svg"); colorize: Theme.text-muted; }
                }
            }
            Text {
                text: I18n.t("连接详情", "Connection Details");
                font-size: 14px; font-weight: 700; color: Theme.text-primary; horizontal-alignment: center;
            }
            Text {
                text: I18n.t("选择连接查看路由与流量", "Select a connection to inspect");
                font-size: 12px; color: Theme.text-muted; horizontal-alignment: center; wrap: word-wrap;
            }
        }

        // Header: Protocol pill + #id + duration pill + close icon
        if root.has-selection : HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            if root.protocol != "" : Rectangle {
                horizontal-stretch: 0;
                height: 24px; y: (parent.height - self.height) / 2; border-radius: 12px;
                background: root.is-udp ? Theme.proto-quic-bg : root.is-tls ? Theme.proto-tls-bg : Theme.proto-direct-bg;
                HorizontalLayout {
                    padding-left: 9px; padding-right: 9px;
                    Text {
                        text: root.protocol; font-size: 11px; font-weight: 800; font-family: Theme.mono-font;
                        color: root.is-udp ? Theme.proto-quic-fg : root.is-tls ? Theme.proto-tls-fg : Theme.proto-direct-fg;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                horizontal-stretch: 0;
                text: root.conn-id != "" ? "#\{root.conn-id}" : I18n.t("连接详情", "Details");
                font-size: 16px; font-weight: 800; letter-spacing: -0.2px;
                color: Theme.text-primary; vertical-alignment: center;
            }

            if root.duration-text != "" : Rectangle {
                horizontal-stretch: 0;
                height: 22px; y: (parent.height - self.height) / 2; border-radius: 11px;
                border-width: 1px; border-color: Theme.well-border; background: Theme.well-bg;
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    Text { text: root.duration-text; font-size: 11px; font-weight: 700; font-family: Theme.mono-font; color: Theme.text-secondary; vertical-alignment: center; }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            IconActionButton {
                icon: @image-url("../icons/x.svg");
                label: I18n.t("关闭", "Dismiss");
                size: 24px;
                clicked => { root.dismiss(); }
            }
        }

        if root.has-selection : Rectangle { height: 1px; background: Theme.hairline-subtle; }

        // Flat hairline-separated metadata rows (no redundant truncated pipeline or nested tiles)
        if root.has-selection : VerticalLayout {
            vertical-stretch: 0;
            MetaKeyValueRow { label: I18n.t("目标地址", "Target"); value: root.display-target; copyable: true; copy-clicked(v) => { root.copy-text(v); } }
            MetaKeyValueRow { label: I18n.t("出口节点", "Outbound"); value: root.outbound; accent-value: true; }
            MetaKeyValueRow { label: I18n.t("规则命中", "Rule Match"); value: root.route-rule != "" ? root.route-rule : I18n.t("默认路由", "Default"); copyable: root.route-rule != ""; copy-clicked(v) => { root.copy-text(v); } }
            MetaKeyValueRow { label: I18n.t("本地来源", "Source"); value: root.source-addr; }
            MetaKeyValueRow { label: I18n.t("所属进程", "Process"); value: root.process-path; show-divider: false; }
        }

        if root.has-selection : Rectangle { height: 1px; background: Theme.hairline-subtle; }

        // Flat matte Traffic Distribution section (zero gradients, zero nested card)
        if root.has-selection : VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-sm;

            HorizontalLayout {
                spacing: 6px;
                Text { text: "↓ " + root.download-text; font-size: 12px; font-weight: 700; font-family: Theme.mono-font; color: Theme.telemetry-down; horizontal-stretch: 1; }
                Text { text: I18n.t("流量分布", "Traffic Split"); font-size: 11px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                Text { text: "↑ " + root.upload-text; font-size: 12px; font-weight: 700; font-family: Theme.mono-font; color: Theme.telemetry-up; horizontal-stretch: 1; horizontal-alignment: right; }
            }

            ProportionBar {
                first-ratio: 1.0 - root.up-ratio;
                first-color: Theme.telemetry-down;
                second-color: Theme.telemetry-up;
                has-data: root.has-traffic;
            }
        }

        if root.has-selection : Rectangle { height: 1px; background: Theme.hairline-subtle; }

        // Quick Rule Deck (concentric 8px outer / 5px inner + unified 8px NexusButton actions)
        if root.has-selection : VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-sm;

            Text {
                text: I18n.t("快速分流", "Quick Rule");
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-secondary;
            }

            Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.well-border;
                background: Theme.well-bg;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 4px;
                    RuleToneSegment { label: I18n.t("直连", "Direct"); tone: "direct"; active: root.eff-rule-action == "direct"; clicked => { root.custom-rule-action = "direct"; } }
                    RuleToneSegment { label: I18n.t("代理", "Proxy"); active: root.eff-rule-action == "proxy"; clicked => { root.custom-rule-action = "proxy"; } }
                    RuleToneSegment { label: I18n.t("拒绝", "Reject"); tone: "danger"; active: root.eff-rule-action == "reject"; clicked => { root.custom-rule-action = "reject"; } }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-sm;

                NexusButton {
                    horizontal-stretch: 1;
                    has-icon: true;
                    icon: @image-url("../icons/wand.svg");
                    label: I18n.t("添加分流规则", "Add Rule");
                    primary: true;
                    clicked => {
                        root.create-rule-from-connection(root.display-target, root.dest-port, root.protocol, root.outbound, root.eff-rule-action);
                    }
                }

                if root.conn-id != "" : NexusButton {
                    label: I18n.t("断开", "Close");
                    danger: true;
                    clicked => { root.close-connection(root.conn-id); }
                }
            }
        }
    }
}
