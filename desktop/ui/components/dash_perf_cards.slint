import { TelemetryWaveState } from "../command_palette_state.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";

component MetricPill inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text-secondary;
    in property <brush> bg: Theme.well-bg;
    in property <color> bd: Theme.well-border;

    horizontal-stretch: 0;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.bd;
    background: root.bg;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            font-family: Theme.mono-font;
            color: root.fg;
            vertical-alignment: center;
        }
    }
}

export component HeroStatusCard inherits Rectangle {
    in property <bool> core-running: false;
    in property <bool> core-toggling: false;
    in property <string> core-uptime: "";
    in property <string> active-profile: "";
    in property <string> active-node: "";
    in property <int> active-node-latency-ms: -1;
    in property <string> outbound-mode: "rule";
    in property <bool> tun-enabled: false;
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;
    in property <string> hero-state-override: "";

    callback toggle-core();
    callback open-groups();

    property <bool> is-error: root.hero-state-override == "error" || (!root.diagnostic-ok && root.diagnostic-message != "" && !root.core-running);
    property <bool> is-degraded: root.hero-state-override == "degraded" || (root.core-running && !root.diagnostic-ok && root.diagnostic-message != "");
    property <color> state-fg:
        root.is-error ? Theme.error-fg
        : root.is-degraded || root.core-toggling ? Theme.warn-fg
        : root.core-running ? Theme.live-emerald
        : Theme.offline-fg;
    property <brush> state-bg:
        root.is-error ? Theme.error-bg
        : root.is-degraded || root.core-toggling ? Theme.warn-bg
        : root.core-running ? Theme.live-emerald-soft
        : Theme.well-bg;
    property <color> state-bd:
        root.is-error ? Theme.error-border
        : root.is-degraded || root.core-toggling ? Theme.warn-border
        : root.core-running ? Theme.live-emerald-border
        : Theme.well-border;
    property <string> state-label:
        root.is-error ? I18n.t("连接异常", "Error")
        : root.is-degraded ? I18n.t("状态降级", "Degraded")
        : root.core-toggling ? I18n.t("切换中", "Switching")
        : root.core-running ? I18n.t("代理已连接", "Connected")
        : I18n.t("待命", "Standby");
    property <string> headline:
        root.active-node != "" ? root.active-node
        : root.active-profile != "" ? root.active-profile
        : I18n.t("默认工作区", "Default Workspace");
    property <string> mode-label:
        root.outbound-mode == "global" ? I18n.t("全局", "Global")
        : root.outbound-mode == "direct" ? I18n.t("直连", "Direct")
        : I18n.t("规则", "Rule");

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.is-error ? Theme.error-border : root.core-running ? Theme.live-emerald-border : Theme.card-border;
    background: Theme.card-surface;

    HorizontalLayout {
        padding: Theme.space-lg;
        spacing: Theme.space-md;

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: space-between;
            spacing: 6px;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 0;
                    height: 22px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: root.state-bd;
                    background: root.state-bg;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 9px;
                        spacing: 5px;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            background: root.state-fg;
                        }
                        Text {
                            text: root.state-label;
                            font-size: 11px;
                            font-weight: 700;
                            color: root.state-fg;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.tun-enabled : MetricPill {
                    text: "TUN";
                    fg: Theme.nav-active-fg;
                    bg: Theme.selected-bg;
                    bd: Theme.selected-border;
                }

                Rectangle { horizontal-stretch: 1; }
            }

            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.headline;
                    font-size: 18px;
                    font-weight: 800;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: root.active-profile != "" && root.active-profile != root.headline
                        ? root.active-profile
                        : (root.core-running ? I18n.t("本机代理与分流策略已激活", "Proxy and routing policies active")
                                            : I18n.t("点击右侧开关启动本地代理内核", "Press toggle to start local proxy core"));
                    font-size: 11px;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }

            // Anti-redundancy: Hero owns mode + uptime (RouteTransitStrip owns live latency & ingress path)
            HorizontalLayout {
                spacing: 6px;

                MetricPill {
                    text: root.mode-label;
                }

                if root.core-running && root.core-uptime != "" : MetricPill {
                    text: root.core-uptime;
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Crisp Matte Circular Start/Stop Button
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;

            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                border-width: 2px;
                border-color:
                    pwr-fs.has-focus ? Theme.accent
                    : root.core-running ? Theme.live-emerald
                    : root.core-toggling ? Theme.warn-fg
                    : pwr-ta.has-hover ? Theme.accent : Theme.hairline-strong;
                background:
                    root.core-running ? (pwr-ta.pressed ? Theme.live-emerald.darker(0.15) : Theme.live-emerald)
                    : pwr-ta.pressed ? Theme.well-bg
                    : pwr-ta.has-hover ? Theme.selected-bg : Theme.well-bg;
                transform-scale: (pwr-ta.pressed && !root.core-toggling) ? 0.97 : 1.0;
                animate background { duration: Motion.fast; }
                animate border-color { duration: Motion.fast; }
                animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }

                accessible-role: button;
                accessible-label: root.core-running ? I18n.t("停止代理", "Stop Proxy") : I18n.t("启动代理", "Start Proxy");
                accessible-action-default => { if (!root.core-toggling) { root.toggle-core(); } }

                pwr-fs := FocusScope {
                    enabled: !root.core-toggling;
                    key-pressed(ev) => {
                        if (!root.core-toggling && (ev.text == Key.Return || ev.text == " ")) {
                            root.toggle-core();
                            return accept;
                        }
                        reject
                    }
                }

                pwr-ta := TouchArea {
                    enabled: !root.core-toggling;
                    mouse-cursor: root.core-toggling ? default : pointer;
                    clicked => { root.toggle-core(); }
                }

                Image {
                    x: (parent.width - self.width) / 2 + (root.core-running ? 0px : 1.5px);
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    source: root.core-running ? @image-url("../icons/stop.svg") : @image-url("../icons/play.svg");
                    colorize: root.core-running ? Theme.live-emerald-on-fill : (pwr-ta.has-hover ? Theme.accent : Theme.text-primary);
                }
            }
        }
    }
}

// Spacious 2fr Dual-Track Throughput Telemetry Card (shared Y-scale RX solid+fill, TX pre-segmented dashed, peak ceiling, onset tick)
export component DualTrackSpeedCard inherits Rectangle {
    in property <string> down-value: "0.0";
    in property <string> down-unit: "KB/s";
    in property <string> down-total: "0 B";
    in property <string> up-value: "0.0";
    in property <string> up-unit: "KB/s";
    in property <string> up-total: "0 B";

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;
    clip: true;

    VerticalLayout {
        padding: Theme.space-md;
        spacing: 6px;

        // Top calibration row: RX solid legend + TX dashed legend + shared scale ceiling
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-md;

            // RX channel readout (solid dot legend + fixed-width numeric slot)
            VerticalLayout {
                horizontal-stretch: 0;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 5px;
                    Rectangle {
                        width: 6px; height: 6px; y: (parent.height - self.height) / 2;
                        border-radius: 3px; background: Theme.telemetry-down;
                    }
                    Text {
                        text: I18n.t("下载", "RX") + " · " + root.down-total;
                        font-size: 10px; font-weight: 600; font-family: Theme.mono-font;
                        color: Theme.text-secondary; vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text {
                        horizontal-stretch: 0;
                        min-width: 68px;
                        text: root.down-value;
                        font-size: 20px;
                        font-weight: 800;
                        font-family: Theme.mono-font;
                        color: Theme.text-primary;
                        vertical-alignment: bottom;
                    }
                    Text {
                        horizontal-stretch: 0;
                        min-width: 34px;
                        text: root.down-unit;
                        font-size: 11px;
                        font-weight: 700;
                        font-family: Theme.mono-font;
                        color: Theme.telemetry-down;
                        vertical-alignment: bottom;
                    }
                }
            }

            Rectangle { width: 1px; y: 4px; height: 28px; background: Theme.hairline-subtle; }

            // TX channel readout (2-dash legend for color-blind distinction + fixed-width numeric slot)
            VerticalLayout {
                horizontal-stretch: 0;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 5px;
                    HorizontalLayout {
                        height: 2px;
                        y: (parent.height - self.height) / 2;
                        spacing: 2px;
                        Rectangle { width: 4px; height: 2px; border-radius: 1px; background: Theme.telemetry-up; }
                        Rectangle { width: 4px; height: 2px; border-radius: 1px; background: Theme.telemetry-up; }
                    }
                    Text {
                        text: I18n.t("上传", "TX") + " · " + root.up-total;
                        font-size: 10px; font-weight: 600; font-family: Theme.mono-font;
                        color: Theme.text-secondary; vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text {
                        horizontal-stretch: 0;
                        min-width: 68px;
                        text: root.up-value;
                        font-size: 20px;
                        font-weight: 800;
                        font-family: Theme.mono-font;
                        color: Theme.text-primary;
                        vertical-alignment: bottom;
                    }
                    Text {
                        horizontal-stretch: 0;
                        min-width: 34px;
                        text: root.up-unit;
                        font-size: 11px;
                        font-weight: 700;
                        font-family: Theme.mono-font;
                        color: Theme.telemetry-up;
                        vertical-alignment: bottom;
                    }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // Shared vertical scale ceiling readout
            VerticalLayout {
                horizontal-stretch: 0;
                alignment: start;
                Text {
                    min-width: 86px;
                    text: I18n.t("标尺 ", "Scale ") + TelemetryWaveState.scale-peak-text;
                    font-size: 10px;
                    font-weight: 600;
                    font-family: Theme.mono-font;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
            }
        }

        // Shared Dual-Track Wave Canvas (edge-to-edge, 50% gridline, RX solid+fill, TX dashed, onset marker)
        wave-well := Rectangle {
            vertical-stretch: 1;
            min-height: 46px;
            border-radius: Theme.radius-xs;
            background: Theme.well-bg.with-alpha(0.55);
            clip: true;

            property <length> path-h: min(self.height, self.width * 60 / 560);

            // Subtle 50% reference line
            Rectangle {
                x: 0px;
                y: parent.height * 0.5;
                width: parent.width;
                height: 1px;
                background: Theme.hairline-subtle;
            }

            if TelemetryWaveState.rx-area != "" : Path {
                x: 0px;
                y: wave-well.height - wave-well.path-h;
                width: wave-well.width;
                height: wave-well.path-h;
                viewbox-width: 560;
                viewbox-height: 60;
                commands: TelemetryWaveState.rx-area;
                fill: Theme.telemetry-down.with-alpha(Theme.dark ? 0.15 : 0.11);
            }

            if TelemetryWaveState.rx-line != "" : Path {
                x: 0px;
                y: wave-well.height - wave-well.path-h;
                width: wave-well.width;
                height: wave-well.path-h;
                viewbox-width: 560;
                viewbox-height: 60;
                commands: TelemetryWaveState.rx-line;
                stroke: Theme.telemetry-down;
                stroke-width: 1.8px;
            }

            if TelemetryWaveState.tx-dashed-line != "" : Path {
                x: 0px;
                y: wave-well.height - wave-well.path-h;
                width: wave-well.width;
                height: wave-well.path-h;
                viewbox-width: 560;
                viewbox-height: 60;
                commands: TelemetryWaveState.tx-dashed-line;
                stroke: Theme.telemetry-up;
                stroke-width: 1.6px;
            }

            if TelemetryWaveState.rx-line == "" && TelemetryWaveState.tx-dashed-line == "" : Rectangle {
                x: 0px;
                y: parent.height - 4px;
                width: parent.width;
                height: 1.5px;
                background: Theme.telemetry-down.with-alpha(0.32);
            }

            // Event onset vertical tick + tight clamped compact label (node/mode/reset/reload)
            if TelemetryWaveState.has-onset && TelemetryWaveState.onset-ratio >= 0.0 && TelemetryWaveState.onset-ratio <= 1.0 : Rectangle {
                property <length> tick-x: clamp(wave-well.width * TelemetryWaveState.onset-ratio, 2px, max(2px, wave-well.width - 2px));
                x: 0px;
                y: 0px;

                Rectangle {
                    x: parent.tick-x;
                    y: 0px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.live-emerald.with-alpha(0.65);
                }

                if TelemetryWaveState.onset-label != "" : Rectangle {
                    width: onset-lbl.preferred-width;
                    x: clamp(parent.tick-x - self.width / 2, 4px, max(4px, parent.width - self.width - 4px));
                    y: 3px;
                    height: 16px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: Theme.live-emerald-border;
                    background: Theme.live-emerald-soft;
                    onset-lbl := HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: TelemetryWaveState.onset-label;
                            font-size: 9px;
                            font-weight: 700;
                            font-family: Theme.mono-font;
                            color: Theme.live-emerald;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
