import { ScrollView } from "std-widgets.slint";
import { GroupSpectrumStats, TelemetryWaveState } from "../command_palette_state.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { OutboundGroupItem } from "../types.slint";
import { NexusVScrollBar } from "nexus_primitives.slint";

export component LatencySpectrumBar inherits Rectangle {
    in property <GroupSpectrumStats> stats: TelemetryWaveState.spectrum;
    in property <length> bar-radius: 0px;

    height: 3px;
    border-radius: root.bar-radius;
    background: Theme.inset-bg;
    clip: true;

    if root.stats.has-data : HorizontalLayout {
        if root.stats.fast-ratio > 0.0 : Rectangle {
            width: parent.width * root.stats.fast-ratio;
            background: Theme.lat-fast-fg;
        }
        if root.stats.good-ratio > 0.0 : Rectangle {
            width: parent.width * root.stats.good-ratio;
            background: Theme.lat-good-fg;
        }
        if root.stats.mid-ratio > 0.0 : Rectangle {
            width: parent.width * root.stats.mid-ratio;
            background: Theme.lat-mid-fg;
        }
        if root.stats.slow-ratio > 0.0 : Rectangle {
            width: parent.width * root.stats.slow-ratio;
            background: Theme.lat-slow-fg;
        }
        if root.stats.timeout-ratio > 0.0 : Rectangle {
            width: parent.width * root.stats.timeout-ratio;
            background: Theme.error-fg;
        }
    }
}

// Fluent 2 Policy-Group Rail Card (3px left accent indicator matching Sidebar)
export component GroupRail inherits Rectangle {
    in property <[OutboundGroupItem]> groups: [];
    in property <string> selected-group: "";
    in property <int> healthy-count: 0;
    in property <int> total-count: 0;
    in property <int> fastest-latency-ms: -1;
    in property <int> p50-latency-ms: -1;
    callback choose-group(string);

    property <int> effective-p50: TelemetryWaveState.spectrum.p50-ms > 0 ? TelemetryWaveState.spectrum.p50-ms : root.p50-latency-ms;

    width: 224px;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;
    clip: true;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            HorizontalLayout {
                padding-left: 2px;
                padding-right: 2px;
                Text {
                    text: I18n.t("策略组", "Policy Groups");
                    font-size: 13px;
                    font-weight: 800;
                    color: Theme.text-primary;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    height: 20px;
                    min-width: 22px;
                    border-radius: Theme.radius-sm;
                    background: Theme.well-bg;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: "\{root.groups.length}";
                            font-size: 10.5px;
                            font-weight: 700;
                            font-family: Theme.mono-font;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.hairline-subtle; }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            rail-sv := ScrollView {
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, rail-col.preferred-height);

                rail-col := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: rail-sv.visible-width;
                    padding-right: root.groups.length > 6 ? 12px : 0px;
                    spacing: 4px;
                    alignment: start;

                    for g in root.groups : Rectangle {
                        property <bool> is-current: g.tag == root.selected-group;
                        changed is-current => {
                            if (self.is-current) {
                                self.ensure-visible(Motion.reduced ? ScrollBehavior.instant : ScrollBehavior.smooth);
                            }
                        }
                        height: 52px;
                        border-radius: Theme.radius-md;
                        background:
                            is-current ? Theme.nav-active-bg
                            : item-ta.has-hover ? Theme.nav-hover-bg
                            : transparent;
                        animate background { duration: Motion.fast; }

                        // Fluent 2 left accent indicator pill
                        if is-current : Rectangle {
                            x: 0px;
                            y: (parent.height - 20px) / 2;
                            width: 3px;
                            height: 20px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        accessible-role: button;
                        accessible-label: g.tag;
                        accessible-action-default => { root.choose-group(g.tag); }

                        gr-fs := FocusScope {
                            key-pressed(ev) => {
                                if (ev.text == Key.Return || ev.text == " ") {
                                    root.choose-group(g.tag);
                                    return accept;
                                }
                                reject
                            }
                        }

                        item-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choose-group(g.tag); }
                        }

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            padding-top: 7px;
                            padding-bottom: 7px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    horizontal-stretch: 0;
                                    min-width: 0px;
                                    text: g.tag;
                                    font-size: 13px;
                                    font-weight: is-current ? 800 : 600;
                                    color: is-current ? Theme.nav-active-fg : Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if g.auto-mode : Rectangle {
                                    horizontal-stretch: 0;
                                    height: 17px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius-sm;
                                    background: is-current ? Theme.pill-active-bot : Theme.well-bg;
                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: I18n.t("自动", "Auto");
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: is-current ? Theme.pill-active-fg : Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: g.active-member != "" ? g.active-member : I18n.t("未选择", "None");
                                    font-size: 11px;
                                    color: is-current ? Theme.text-secondary : Theme.text-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if g.active-latency-ms > 0 : Text {
                                    text: "\{g.active-latency-ms} ms";
                                    font-size: 11px;
                                    font-weight: 800;
                                    font-family: Theme.mono-font;
                                    color: Theme.latency-fg(g.active-latency-ms, "healthy");
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            NexusVScrollBar {
                x: parent.width - self.width;
                y: 2px;
                height: max(0px, parent.height - 4px);
                viewport-size: rail-sv.visible-height;
                content-size: rail-sv.content-height;
                scroll-pos <=> rail-sv.content-y;
            }
        }

        Rectangle { height: 1px; background: Theme.card-border; }

        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 2px;
            padding-right: 2px;
            padding-top: 4px;
            padding-bottom: 2px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: I18n.t("策略组健康度", "Group Health");
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: 6px; height: 6px; y: (parent.height - self.height) / 2; border-radius: 3px;
                    background: root.healthy-count > 0 ? Theme.live-emerald : Theme.offline-fg;
                }
            }

            LatencySpectrumBar {
                stats: TelemetryWaveState.spectrum;
            }

            HorizontalLayout {
                spacing: 2px;

                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; alignment: center; spacing: 1px;
                    Text { text: "\{root.healthy-count}/\{root.total-count}"; font-size: 11px; font-weight: 800; font-family: Theme.mono-font; color: root.healthy-count > 0 ? Theme.live-emerald : Theme.text-muted; horizontal-alignment: center; }
                    Text { text: I18n.t("可用", "Ready"); font-size: 9px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                }

                Rectangle { width: 1px; y: 4px; height: 22px; background: Theme.hairline-subtle; }

                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; alignment: center; spacing: 1px;
                    Text {
                        text: root.effective-p50 > 0 ? "\{root.effective-p50} ms" : "--";
                        font-size: 11px; font-weight: 800; font-family: Theme.mono-font;
                        color: root.effective-p50 > 0 ? Theme.latency-fg(root.effective-p50, "healthy") : Theme.text-muted;
                        horizontal-alignment: center;
                    }
                    Text { text: "P50"; font-size: 9px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                }

                Rectangle { width: 1px; y: 4px; height: 22px; background: Theme.hairline-subtle; }

                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; alignment: center; spacing: 1px;
                    Text {
                        text: root.fastest-latency-ms > 0 ? "\{root.fastest-latency-ms} ms" : "--";
                        font-size: 11px; font-weight: 800; font-family: Theme.mono-font;
                        color: root.fastest-latency-ms > 0 ? Theme.latency-fg(root.fastest-latency-ms, "healthy") : Theme.text-muted;
                        horizontal-alignment: center;
                    }
                    Text { text: I18n.t("最快", "Best"); font-size: 9px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                }
            }
        }
    }
}

// Fluent 2 Active Policy-Group Summary Strip Card
export component GroupSummaryStrip inherits Rectangle {
    in property <string> group-name: "";
    in property <string> group-mode: "";
    in property <bool> auto-mode: false;
    in property <string> active-node: "";
    in property <int> active-latency-ms: -1;
    in property <int> p50-latency-ms: -1;
    in property <int> healthy-count: 0;
    in property <int> total-count: 0;
    in property <bool> probing: false;

    property <int> effective-p50: TelemetryWaveState.spectrum.p50-ms > 0 ? TelemetryWaveState.spectrum.p50-ms : root.p50-latency-ms;

    vertical-stretch: 0;
    height: 44px;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;
    clip: true;

    if root.probing : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 2px;
        background: Theme.accent-soft;
        Rectangle {
            property <float> scan: Motion.reduced ? 0.35 : mod(animation-tick(), 1100ms) / 1100ms;
            x: (parent.width + self.width) * self.scan - self.width;
            width: parent.width * 0.34;
            height: 2px;
            background: Theme.accent;
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;

        Text {
            text: root.group-name;
            font-size: 15px;
            font-weight: 800;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 0;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: root.auto-mode ? Theme.pill-active-bot : Theme.well-bg;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                Text {
                    text: root.auto-mode ? I18n.t("自动优选", "Auto") : I18n.t("手动", "Manual");
                    font-size: 10px;
                    font-weight: 700;
                    color: root.auto-mode ? Theme.pill-active-fg : Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if root.active-node != "" : Text {
            text: "→ " + root.active-node;
            font-size: 12px;
            font-weight: 700;
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.active-latency-ms > 0 : Text {
            text: "\{root.active-latency-ms} ms";
            font-size: 12px;
            font-weight: 800;
            font-family: Theme.mono-font;
            color: Theme.latency-fg(root.active-latency-ms, "healthy");
            vertical-alignment: center;
        }

        if root.effective-p50 > 0 : Rectangle {
            horizontal-stretch: 0;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.well-bg;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                Text {
                    text: "P50 \{root.effective-p50} ms";
                    font-size: 10px;
                    font-weight: 700;
                    font-family: Theme.mono-font;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        if root.total-count > 0 : Rectangle {
            horizontal-stretch: 0;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: root.healthy-count > 0 ? Theme.live-emerald-soft : Theme.well-bg;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                spacing: 4px;
                Text {
                    text: "\{root.healthy-count}/\{root.total-count}";
                    font-size: 10px;
                    font-weight: 700;
                    font-family: Theme.mono-font;
                    color: root.healthy-count > 0 ? Theme.live-emerald : Theme.text-primary;
                    vertical-alignment: center;
                }
                Text {
                    text: root.healthy-count > 0 ? I18n.t("可用", "ready") : I18n.t("节点", "nodes");
                    font-size: 10px;
                    font-weight: 700;
                    color: root.healthy-count > 0 ? Theme.live-emerald : Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }
    }

    if TelemetryWaveState.spectrum.has-data : LatencySpectrumBar {
        x: 0px;
        y: parent.height - 3px;
        width: parent.width;
        stats: TelemetryWaveState.spectrum;
    }
}
