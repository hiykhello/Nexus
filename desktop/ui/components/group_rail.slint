import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { OutboundGroupItem } from "../types.slint";
import { NexusVScrollBar, ProportionBar } from "glass_primitives.slint";

// Wide Studio (>=1200px) 224px vertical policy-group rail with Group Health & Latency Summary Footer
export component GroupRail inherits Rectangle {
    in property <[OutboundGroupItem]> groups: [];
    in property <string> selected-group: "";
    in property <int> healthy-count: 0;
    in property <int> total-count: 0;
    in property <int> fastest-latency-ms: -1;
    callback choose-group(string);

    width: 224px;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;
    clip: true;

    VerticalLayout {
        padding: Theme.space-sm;
        spacing: Theme.space-sm;

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 2px;
            Text {
                text: I18n.t("策略组", "POLICY GROUPS");
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.4px;
                color: Theme.text-secondary;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Rectangle {
                height: 20px;
                min-width: 22px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.well-border;
                background: Theme.well-bg;
                HorizontalLayout {
                    padding-left: 7px;
                    padding-right: 7px;
                    Text {
                        text: "\{root.groups.length}";
                        font-size: 10px;
                        font-weight: 700;
                        font-family: Theme.mono-font;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            rail-sv := ScrollView {
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, rail-col.preferred-height);

                rail-col := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: rail-sv.visible-width;
                    padding-right: root.groups.length > 5 ? 16px : 0px;
                    spacing: 8px;
                    alignment: start;

                    for g in root.groups : Rectangle {
                        property <bool> is-current: g.tag == root.selected-group;
                        changed is-current => {
                            if (self.is-current) {
                                self.ensure-visible(Motion.reduced ? ScrollBehavior.instant : ScrollBehavior.smooth);
                            }
                        }
                        height: 58px;
                        border-radius: Theme.radius-sm;
                        border-width: gr-fs.has-focus ? 2px : 1px;
                        border-color:
                            gr-fs.has-focus ? Theme.accent
                            : is-current ? Theme.accent.with-alpha(Theme.dark ? 0.78 : 0.62)
                            : item-ta.has-hover ? Theme.hairline-strong
                            : Theme.well-border;
                        background:
                            is-current ? Theme.selected-bg
                            : item-ta.has-hover ? Theme.row-hover-bg
                            : Theme.well-bg;
                        animate border-color { duration: Motion.fast; }
                        animate background { duration: Motion.fast; }

                        accessible-role: button;
                        accessible-label: g.tag;
                        accessible-action-default => { root.choose-group(g.tag); }

                        gr-fs := FocusScope {
                            key-pressed(ev) => {
                                if (ev.text == Key.Return || ev.text == " ") {
                                    root.choose-group(g.tag);
                                    return accept;
                                }
                                reject
                            }
                        }

                        item-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choose-group(g.tag); }
                        }

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 4px;

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    horizontal-stretch: 0;
                                    min-width: 0px;
                                    text: g.tag;
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if g.auto-mode : Rectangle {
                                    horizontal-stretch: 0;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.radius-xs;
                                    background: is-current ? Theme.pill-active-bot : Theme.inset-bg;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: I18n.t("自动", "Auto");
                                            font-size: 9px;
                                            font-weight: 700;
                                            color: is-current ? Theme.pill-active-fg : Theme.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: g.active-member != "" ? g.active-member : I18n.t("未选择", "None");
                                    font-size: 11px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if g.active-latency-ms > 0 : Text {
                                    text: "\{g.active-latency-ms}ms";
                                    font-size: 11px;
                                    font-weight: 700;
                                    font-family: Theme.mono-font;
                                    color: Theme.latency-fg(g.active-latency-ms, "healthy");
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            NexusVScrollBar {
                x: parent.width - self.width;
                y: 2px;
                height: max(0px, parent.height - 4px);
                viewport-size: rail-sv.visible-height;
                content-size: rail-sv.content-height;
                scroll-pos <=> rail-sv.content-y;
            }
        }

        Rectangle { height: 1px; background: Theme.hairline-subtle; }

        // Borderless Typographic Group Health Summary Footer
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 4px;
            padding-bottom: 2px;
            spacing: Theme.space-sm;

            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 1;
                    text: I18n.t("策略组健康度", "Group Health");
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    width: 6px; height: 6px; y: (parent.height - self.height) / 2; border-radius: 3px;
                    background: root.healthy-count > 0 ? Theme.success-fg : Theme.offline-fg;
                }
            }

            ProportionBar {
                first-ratio: root.total-count > 0 ? (root.healthy-count / root.total-count) : 0.0;
                first-color: Theme.success-fg;
                second-color: Theme.error-fg;
                has-data: root.total-count > 0 && root.healthy-count > 0;
                has-second: root.total-count > root.healthy-count;
            }

            HorizontalLayout {
                spacing: 4px;

                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; alignment: center; spacing: 1px;
                    Text { text: "\{root.total-count}"; font-size: 13px; font-weight: 800; font-family: Theme.mono-font; color: Theme.text-primary; horizontal-alignment: center; }
                    Text { text: I18n.t("总节点", "Total"); font-size: 9px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                }

                Rectangle { width: 1px; y: 4px; height: 22px; background: Theme.hairline-subtle; }

                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; alignment: center; spacing: 1px;
                    Text { text: "\{root.healthy-count}"; font-size: 13px; font-weight: 800; font-family: Theme.mono-font; color: root.healthy-count > 0 ? Theme.success-fg : Theme.text-muted; horizontal-alignment: center; }
                    Text { text: I18n.t("可用", "Ready"); font-size: 9px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                }

                Rectangle { width: 1px; y: 4px; height: 22px; background: Theme.hairline-subtle; }

                VerticalLayout {
                    horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; alignment: center; spacing: 1px;
                    Text {
                        text: root.fastest-latency-ms > 0 ? "\{root.fastest-latency-ms}ms" : "--";
                        font-size: 12px; font-weight: 800; font-family: Theme.mono-font;
                        color: root.fastest-latency-ms > 0 ? Theme.latency-fg(root.fastest-latency-ms, "healthy") : Theme.text-muted;
                        horizontal-alignment: center;
                    }
                    Text { text: I18n.t("最快", "Best"); font-size: 9px; font-weight: 600; color: Theme.text-muted; horizontal-alignment: center; }
                }
            }
        }
    }
}

// Active policy-group summary card cleanly anchored above the Bento node grid
export component GroupSummaryStrip inherits Rectangle {
    in property <string> group-name: "";
    in property <string> group-mode: "";
    in property <bool> auto-mode: false;
    in property <string> active-node: "";
    in property <int> active-latency-ms: -1;
    in property <int> healthy-count: 0;
    in property <int> total-count: 0;
    in property <bool> probing: false;

    vertical-stretch: 0;
    height: 44px;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: root.probing ? Theme.selected-border : Theme.card-border;
    background: Theme.card-surface;
    clip: true;
    animate border-color { duration: Motion.fast; }

    if root.probing : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 2px;
        background: Theme.accent-soft;
        Rectangle {
            property <float> scan: Motion.reduced ? 0.35 : mod(animation-tick(), 1100ms) / 1100ms;
            x: (parent.width + self.width) * self.scan - self.width;
            width: parent.width * 0.34;
            height: 2px;
            background: Theme.accent;
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: root.group-name;
            font-size: 15px;
            font-weight: 800;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 0;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-xs;
            background: root.auto-mode ? Theme.pill-active-bot : Theme.well-bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.auto-mode ? I18n.t("自动优选", "Auto") : I18n.t("手动", "Manual");
                    font-size: 10px;
                    font-weight: 700;
                    color: root.auto-mode ? Theme.pill-active-fg : Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if root.active-node != "" : Text {
            text: "→ " + root.active-node;
            font-size: 12px;
            font-weight: 600;
            font-family: Theme.mono-font;
            color: Theme.text-secondary;
            vertical-alignment: center;
            overflow: elide;
        }

        if root.active-latency-ms > 0 : Rectangle {
            horizontal-stretch: 0;
            min-width: 58px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-sm;
            background: Theme.latency-bg(root.active-latency-ms, "healthy");
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: "\{root.active-latency-ms} ms";
                    font-size: 11px;
                    font-weight: 700;
                    font-family: Theme.mono-font;
                    color: Theme.latency-fg(root.active-latency-ms, "healthy");
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        if root.total-count > 0 : Rectangle {
            horizontal-stretch: 0;
            height: 22px;
            y: (parent.height - self.height) / 2;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.well-border;
            background: Theme.well-bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 5px;
                Text {
                    text: root.healthy-count > 0
                        ? I18n.t("\{root.healthy-count}/\{root.total-count} 可用", "\{root.healthy-count}/\{root.total-count} ready")
                        : I18n.t("\{root.total-count} 节点", "\{root.total-count} nodes");
                    font-size: 10px;
                    font-weight: 700;
                    font-family: Theme.mono-font;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: root.healthy-count > 0 ? Theme.success-fg : Theme.offline-fg;
                }
            }
        }
    }
}
