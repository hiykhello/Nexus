import { Theme } from "../theme.slint";
import { OutboundMemberItem, ProfileItem } from "../types.slint";
import { DragHandleOverlay } from "dash_drag_chrome.slint";
import { CoreMemoryCard, NetworkHealthCard } from "bento_cards.slint";
import { ConnectionTrafficCard, LocalPortsCompactCard, QuickProfilesDeckCard } from "bento_deck_cards.slint";
import { QuickNodesCard } from "quick_nodes_card.slint";

component InfoCardSlot inherits Rectangle {
    in property <int> card-id: 0;
    in property <bool> shown: true;
    in property <bool> editing: false;
    in property <bool> is-source: false;
    in property <bool> is-target: false;
    in property <bool> is-dragging-any: false;
    in property <string> drag-kind: "";
    in property <length> drag-abs-x: 0px;
    in property <length> drag-abs-y: 0px;
    in property <bool> core-running: false;
    in property <string> active-node: "";
    in property <int> active-node-latency-ms: -1;
    in property <bool> groups-probing: false;
    in property <string> total-memory-text: "--";
    in property <string> app-memory-text: "--";
    in property <string> core-memory-text: "--";
    in property <float> app-memory-ratio: 0.78;
    in property <int> active-sessions: 0;
    in property <string> download-total: "0 B";
    in property <string> upload-total: "0 B";
    in property <float> total-down-ratio: 0.85;
    in-out property <bool> mixed-proxy-enabled: true;
    in-out property <string> mixed-proxy-host: "127.0.0.1";
    in-out property <string> mixed-proxy-port: "7890";
    in-out property <bool> socks-proxy-enabled: true;
    in-out property <string> socks-proxy-host: "127.0.0.1";
    in-out property <string> socks-proxy-port: "1080";
    in-out property <bool> http-proxy-enabled: false;
    in-out property <string> http-proxy-host: "127.0.0.1";
    in-out property <string> http-proxy-port: "8080";

    callback probe-active-group();
    callback open-groups();
    callback clear-cache();
    callback open-connections();
    callback apply-inbound-proxy-config(string, bool, string, string);
    callback copy-text(string);
    callback copy-proxy-env();
    callback open-config();
    callback drag-started(int, length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback drag-cancelled();
    callback report-hover(int, bool);

    property <bool> ptr-over:
        root.shown && root.drag-kind == "info" && root.width > 0px && root.height > 0px
        && root.drag-abs-x >= root.absolute-position.x && root.drag-abs-x <= root.absolute-position.x + root.width
        && root.drag-abs-y >= root.absolute-position.y && root.drag-abs-y <= root.absolute-position.y + root.height;
    changed ptr-over => { root.report-hover(root.card-id, self.ptr-over); }

    visible: root.shown;

    if root.shown && root.card-id == 0 : NetworkHealthCard {
        width: 100%; height: 100%;
        core-running: root.core-running; active-node: root.active-node;
        active-node-latency-ms: root.active-node-latency-ms; probing: root.groups-probing;
        probe-active-group => { root.probe-active-group(); } open-groups => { root.open-groups(); }
    }
    if root.shown && root.card-id == 1 : CoreMemoryCard {
        width: 100%; height: 100%;
        core-running: root.core-running; total-memory-text: root.total-memory-text;
        app-memory-text: root.app-memory-text; core-memory-text: root.core-memory-text; app-memory-ratio: root.app-memory-ratio;
        clear-cache => { root.clear-cache(); }
    }
    if root.shown && root.card-id == 2 : ConnectionTrafficCard {
        width: 100%; height: 100%;
        core-running: root.core-running; active-sessions: root.active-sessions;
        download-total: root.download-total; upload-total: root.upload-total; total-down-ratio: root.total-down-ratio;
        open-connections => { root.open-connections(); }
    }
    if root.shown && root.card-id == 3 : LocalPortsCompactCard {
        width: 100%; height: 100%;
        core-running: root.core-running;
        mixed-proxy-enabled <=> root.mixed-proxy-enabled; mixed-proxy-host <=> root.mixed-proxy-host; mixed-proxy-port <=> root.mixed-proxy-port;
        socks-proxy-enabled <=> root.socks-proxy-enabled; socks-proxy-host <=> root.socks-proxy-host; socks-proxy-port <=> root.socks-proxy-port;
        http-proxy-enabled <=> root.http-proxy-enabled; http-proxy-host <=> root.http-proxy-host; http-proxy-port <=> root.http-proxy-port;
        apply-inbound-proxy-config(proto, on, host, port) => { root.apply-inbound-proxy-config(proto, on, host, port); }
        copy-endpoint(ep) => { root.copy-text(ep); } copy-proxy-env => { root.copy-proxy-env(); } open-config => { root.open-config(); }
    }

    if root.shown && root.editing : DragHandleOverlay {
        editing: root.editing; is-source: root.is-source; is-target: root.is-target; is-dragging-any: root.is-dragging-any;
        drag-started(ax, ay) => { root.drag-started(root.card-id, ax, ay); }
        drag-moved(ax, ay) => { root.drag-moved(ax, ay); }
        drag-ended => { root.drag-ended(); }
        drag-cancelled => { root.drag-cancelled(); }
    }
}

export component DeckCardSlot inherits Rectangle {
    in property <int> deck-id: 0; // 0 = QuickNodesCard, 1 = QuickProfilesDeckCard
    in property <bool> shown: true;
    in property <bool> is-wide: false;
    in property <bool> editing: false;
    in property <bool> is-source: false;
    in property <bool> is-target: false;
    in property <bool> is-dragging-any: false;
    in property <string> drag-kind: "";
    in property <length> drag-abs-x: 0px;
    in property <length> drag-abs-y: 0px;
    in property <string> selected-group: "";
    in property <[OutboundMemberItem]> quick-nodes: [];
    in property <bool> groups-probing: false;
    in property <[ProfileItem]> profiles: [];
    in property <string> active-profile: "";

    callback select-member(string, string);
    callback probe-active-group();
    callback open-groups();
    callback activate-profile(string);
    callback open-profiles();
    callback open-logs();
    callback open-rules();
    callback drag-started(int, length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback drag-cancelled();
    callback report-hover(int, bool);

    property <bool> ptr-over:
        root.shown && root.drag-kind == "deck" && root.width > 0px && root.height > 0px
        && root.drag-abs-x >= root.absolute-position.x && root.drag-abs-x <= root.absolute-position.x + root.width
        && root.drag-abs-y >= root.absolute-position.y && root.drag-abs-y <= root.absolute-position.y + root.height;
    changed ptr-over => { root.report-hover(root.deck-id, self.ptr-over); }

    visible: root.shown;
    preferred-height: root.shown ? body.preferred-height : 0px;

    body := VerticalLayout {
        if root.shown && root.deck-id == 0 : QuickNodesCard {
            vertical-stretch: 1;
            selected-group: root.selected-group; nodes: root.quick-nodes; probing: root.groups-probing; three-cols: root.is-wide;
            select-member(g, m) => { root.select-member(g, m); }
            probe-group(g) => { root.probe-active-group(); }
            open-groups => { root.open-groups(); }
        }
        if root.shown && root.deck-id == 1 : QuickProfilesDeckCard {
            vertical-stretch: 1;
            profiles: root.profiles; active-profile: root.active-profile;
            activate-profile(id) => { root.activate-profile(id); }
            probe-active-group => { root.probe-active-group(); }
            open-profiles => { root.open-profiles(); }
            open-logs => { root.open-logs(); }
            open-rules => { root.open-rules(); }
        }
    }

    if root.shown && root.editing : DragHandleOverlay {
        editing: root.editing; is-source: root.is-source; is-target: root.is-target; is-dragging-any: root.is-dragging-any;
        drag-started(ax, ay) => { root.drag-started(root.deck-id, ax, ay); }
        drag-moved(ax, ay) => { root.drag-moved(ax, ay); }
        drag-ended => { root.drag-ended(); }
        drag-cancelled => { root.drag-cancelled(); }
    }
}

// Single-template reactive Info Cards grid (4-col wide / 2x2 packed compact, 1x Slint codegen!)
export component DashInfoGrid inherits Rectangle {
    in property <bool> is-compact: false;
    in property <bool> editing: false;
    in property <string> drag-kind: "";
    in property <int> drag-source-id: -1;
    in property <int> target-info-id: -1;
    in property <length> drag-abs-x: 0px;
    in property <length> drag-abs-y: 0px;
    in property <[int]> info-order: [0, 1, 2, 3];
    in property <bool> show-network: true;
    in property <bool> show-memory: true;
    in property <bool> show-traffic: true;
    in property <bool> show-ports: true;
    in property <bool> core-running: false;
    in property <string> active-node: "";
    in property <int> active-node-latency-ms: -1;
    in property <bool> groups-probing: false;
    in property <string> total-memory-text: "--";
    in property <string> app-memory-text: "--";
    in property <string> core-memory-text: "--";
    in property <float> app-memory-ratio: 0.78;
    in property <int> active-sessions: 0;
    in property <string> download-total: "0 B";
    in property <string> upload-total: "0 B";
    in property <float> total-down-ratio: 0.85;
    in-out property <bool> mixed-proxy-enabled: true;
    in-out property <string> mixed-proxy-host: "127.0.0.1";
    in-out property <string> mixed-proxy-port: "7890";
    in-out property <bool> socks-proxy-enabled: true;
    in-out property <string> socks-proxy-host: "127.0.0.1";
    in-out property <string> socks-proxy-port: "1080";
    in-out property <bool> http-proxy-enabled: false;
    in-out property <string> http-proxy-host: "127.0.0.1";
    in-out property <string> http-proxy-port: "8080";

    callback probe-active-group();
    callback open-groups();
    callback clear-cache();
    callback open-connections();
    callback apply-inbound-proxy-config(string, bool, string, string);
    callback copy-text(string);
    callback copy-proxy-env();
    callback open-config();
    callback start-drag(string, int, length, length);
    callback move-drag(length, length);
    callback end-drag();
    callback cancel-drag();
    callback report-hover-info(int, bool);

    pure function info-vis(id: int) -> bool {
        id == 0 ? root.show-network : id == 1 ? root.show-memory : id == 2 ? root.show-traffic : id == 3 ? root.show-ports : false
    }
    pure function info-at(i: int) -> int {
        (i >= 0 && i < root.info-order.length && root.info-order[i] >= 0 && root.info-order[i] <= 3) ? root.info-order[i] : i
    }
    pure function vis-rank(idx: int) -> int {
        (idx > 0 && root.info-vis(root.info-at(0)) ? 1 : 0)
        + (idx > 1 && root.info-vis(root.info-at(1)) ? 1 : 0)
        + (idx > 2 && root.info-vis(root.info-at(2)) ? 1 : 0)
    }

    property <int> vis-n:
        (root.show-network ? 1 : 0) + (root.show-memory ? 1 : 0)
        + (root.show-traffic ? 1 : 0) + (root.show-ports ? 1 : 0);
    property <length> wide-card-w: max(0px, (root.width - Theme.space-md * max(0, root.vis-n - 1)) / max(1, root.vis-n));
    property <length> compact-half-w: max(0px, (root.width - Theme.space-sm) / 2);

    vertical-stretch: 0;
    height: root.vis-n == 0 ? 0px : (root.is-compact && root.vis-n > 2 ? 292px : 142px);

    for info-id[idx] in root.info-order : InfoCardSlot {
        property <bool> vis: root.info-vis(info-id);
        property <int> rank: root.vis-rank(idx);
        property <bool> compact-full: root.vis-n == 1 || (root.vis-n == 3 && self.rank == 2);

        card-id: info-id;
        shown: self.vis;
        x: !self.vis ? 0px
            : !root.is-compact ? self.rank * (root.wide-card-w + Theme.space-md)
            : (self.compact-full ? 0px : Math.mod(self.rank, 2) * (root.compact-half-w + Theme.space-sm));
        y: !self.vis ? 0px
            : !root.is-compact ? 0px
            : Math.floor(self.rank / 2) * (142px + Theme.space-sm);
        width: !self.vis ? 0px
            : !root.is-compact ? root.wide-card-w
            : (self.compact-full ? root.width : root.compact-half-w);
        height: self.vis ? 142px : 0px;

        editing: root.editing;
        is-source: root.drag-kind == "info" && root.drag-source-id == info-id;
        is-target: root.target-info-id == info-id;
        is-dragging-any: root.drag-kind != "";
        drag-kind: root.drag-kind; drag-abs-x: root.drag-abs-x; drag-abs-y: root.drag-abs-y;
        core-running: root.core-running; active-node: root.active-node; active-node-latency-ms: root.active-node-latency-ms; groups-probing: root.groups-probing;
        total-memory-text: root.total-memory-text; app-memory-text: root.app-memory-text; core-memory-text: root.core-memory-text; app-memory-ratio: root.app-memory-ratio;
        active-sessions: root.active-sessions; download-total: root.download-total; upload-total: root.upload-total; total-down-ratio: root.total-down-ratio;
        mixed-proxy-enabled <=> root.mixed-proxy-enabled; mixed-proxy-host <=> root.mixed-proxy-host; mixed-proxy-port <=> root.mixed-proxy-port;
        socks-proxy-enabled <=> root.socks-proxy-enabled; socks-proxy-host <=> root.socks-proxy-host; socks-proxy-port <=> root.socks-proxy-port;
        http-proxy-enabled <=> root.http-proxy-enabled; http-proxy-host <=> root.http-proxy-host; http-proxy-port <=> root.http-proxy-port;
        probe-active-group => { root.probe-active-group(); } open-groups => { root.open-groups(); } clear-cache => { root.clear-cache(); }
        open-connections => { root.open-connections(); } apply-inbound-proxy-config(pr, on, h, p) => { root.apply-inbound-proxy-config(pr, on, h, p); }
        copy-text(t) => { root.copy-text(t); } copy-proxy-env => { root.copy-proxy-env(); } open-config => { root.open-config(); }
        drag-started(id, ax, ay) => { root.start-drag("info", id, ax, ay); } drag-moved(ax, ay) => { root.move-drag(ax, ay); }
        drag-ended => { root.end-drag(); } drag-cancelled => { root.cancel-drag(); }
        report-hover(id, inside) => { root.report-hover-info(id, inside); }
    }
}
