import { ControlInspectState } from "../control_inspect_state.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";

component ProcessPidPill inherits Rectangle {
    in property <string> text;
    in property <color> fg: Theme.text-secondary;
    in property <brush> bg: Theme.well-bg;
    in property <color> bd: Theme.well-border;

    horizontal-stretch: 0;
    height: 22px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.bd;
    background: root.bg;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            font-family: Theme.mono-font;
            color: root.fg;
            vertical-alignment: center;
        }
    }
}

component MiniActionChip inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();

    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.enabled && ta.has-hover ? Theme.selected-border : Theme.well-border;
    background: root.enabled && ta.has-hover ? Theme.row-hover-bg : Theme.well-bg;
    opacity: root.enabled ? 1.0 : 0.48;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: 10px;
        font-weight: 600;
        color: Theme.text-primary;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component AppPerfCard inherits Rectangle {
    in property <string> pid-text: "--";
    in property <string> cpu-text: "0.0%";
    in property <float> cpu-ratio: 0.0;
    in property <string> memory-text: "--";

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;

    VerticalLayout {
        padding: 13px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: I18n.t("软件性能", "App Performance");
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            ProcessPidPill {
                text: root.pid-text != "" ? root.pid-text : "PID --";
            }
        }

        VerticalLayout {
            spacing: 10px;

            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    Text { horizontal-stretch: 1; text: "CPU"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    Text { text: root.cpu-text; font-size: 13px; font-weight: 700; font-family: Theme.mono-font; color: Theme.text-primary; }
                }
                Rectangle {
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.inset-bg;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * clamp(root.cpu-ratio, 0.02, 1.0);
                        height: 100%;
                        border-radius: 2.5px;
                        background: Theme.accent;
                    }
                }
            }

            Rectangle {
                height: 50px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.well-border;
                background: Theme.well-bg;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text { text: I18n.t("私有内存", "Private Memory"); font-size: 10px; font-weight: 600; color: Theme.text-muted; }
                        Text { text: root.memory-text; font-size: 16px; font-weight: 800; font-family: Theme.mono-font; color: Theme.text-primary; }
                    }
                }
            }
        }

        Text {
            text: I18n.t("桌面界面进程独立统计", "Desktop UI process metrics");
            font-size: 10px;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
}

export component CorePerfCard inherits Rectangle {
    in property <bool> core-running: false;
    in property <string> pid-text: "";
    in property <string> cpu-text: "--";
    in property <float> cpu-ratio: 0.0;
    in property <string> memory-text: "--";

    callback clear-cache();

    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;

    VerticalLayout {
        padding: 13px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 6px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: I18n.t("内核性能", "Core Performance");
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            ProcessPidPill {
                text: root.core-running
                    ? (root.pid-text != "" ? root.pid-text : I18n.t("运行中", "Active"))
                    : I18n.t("未启动", "Stopped");
                fg: root.core-running ? Theme.success-fg : Theme.text-muted;
                bg: root.core-running ? Theme.success-bg : Theme.well-bg;
                bd: root.core-running ? Theme.success-border : Theme.well-border;
            }
        }

        VerticalLayout {
            spacing: 10px;

            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    Text { horizontal-stretch: 1; text: "CPU"; font-size: 11px; font-weight: 600; color: Theme.text-secondary; }
                    Text { text: root.core-running ? root.cpu-text : "--"; font-size: 13px; font-weight: 700; font-family: Theme.mono-font; color: Theme.text-primary; }
                }
                Rectangle {
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.inset-bg;
                    clip: true;
                    if root.core-running : Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width * clamp(root.cpu-ratio, 0.02, 1.0);
                        height: 100%;
                        border-radius: 2.5px;
                        background: Theme.success-fg;
                    }
                }
            }

            Rectangle {
                height: 50px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.well-border;
                background: Theme.well-bg;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px;
                        Text { text: I18n.t("私有内存", "Private Memory"); font-size: 10px; font-weight: 600; color: Theme.text-muted; }
                        Text { text: root.core-running ? root.memory-text : "--"; font-size: 16px; font-weight: 800; font-family: Theme.mono-font; color: Theme.text-primary; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 5px;
            MiniActionChip {
                label: "FakeIP";
                enabled: root.core-running;
                clicked => { ControlInspectState.flush-fakeip(); }
            }
            MiniActionChip {
                label: "DNS";
                enabled: root.core-running;
                clicked => { ControlInspectState.clear-dns-cache(); }
            }
            MiniActionChip {
                label: I18n.t("整理内存", "Trim");
                clicked => { root.clear-cache(); }
            }
        }
    }
}
