import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { DnsRuleDraft } from "../types.slint";
import { NexusInput } from "nexus_primitives.slint";
import { NexusChip } from "nexus_buttons.slint";
import { NexusSelect } from "nexus_select.slint";
import { RuleActionBar } from "rule_builder_parts.slint";

export component RuleDnsTab inherits VerticalLayout {
    in-out property <string> match-kind: "domain-suffix";
    in-out property <string> match-value: "internal.corp";
    in-out property <string> action-kind: "direct";
    in-out property <string> target-server: "direct";
    in property <string> status-text: "";
    in property <bool> status-ok: true;

    callback add-dns-rule(DnsRuleDraft);

    pure function current-draft() -> DnsRuleDraft {
        {
            match-kind: root.match-kind,
            match-value: root.match-value,
            action-kind: root.action-kind,
            target-server: root.target-server,
        }
    }

    function reset-form() {
        root.match-kind = "domain-suffix";
        root.match-value = "internal.corp";
        root.action-kind = "direct";
        root.target-server = "direct";
    }

    vertical-stretch: 0;
    alignment: start;
    spacing: Theme.space-md;

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-sm;

        Text {
            text: I18n.t("匹配条件", "Match Predicates");
            font-size: 13px; font-weight: 700; color: Theme.text-primary;
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            NexusSelect {
                width: 148px;
                options: ["domain-suffix", "domain", "domain-keyword", "domain-wildcard", "domain-regex", "rule-set"];
                current-value <=> root.match-kind;
            }
            NexusInput {
                min-width: 80px;
                horizontal-stretch: 1;
                mono: true;
                text <=> root.match-value;
                placeholder-text: root.match-kind == "rule-set"
                    ? I18n.t("规则集名称", "Rule-set name")
                    : I18n.t("域名 / 后缀 (如 internal.corp)", "Domain / Suffix");
            }
        }
    }

    Rectangle { height: 1px; background: Theme.hairline-subtle; }

    VerticalLayout {
        alignment: start;
        spacing: Theme.space-sm;

        Text {
            text: I18n.t("解析策略", "Resolution Policy");
            font-size: 13px; font-weight: 700; color: Theme.text-primary;
        }

        FlexboxLayout {
            spacing: 6px;
            NexusChip {
                label: I18n.t("直连 DNS", "Direct DNS");
                active: root.action-kind == "direct";
                clicked => { root.action-kind = "direct"; root.target-server = "direct"; }
            }
            NexusChip {
                label: I18n.t("代理 DNS", "Remote DNS");
                active: root.action-kind == "proxy";
                clicked => { root.action-kind = "proxy"; root.target-server = "proxy"; }
            }
            NexusChip {
                label: I18n.t("拦截 (NXDOMAIN)", "Block (NXDOMAIN)");
                warn-accent: true;
                active: root.action-kind == "block";
                clicked => { root.action-kind = "block"; root.target-server = "block"; }
            }
        }
    }

    Rectangle { height: 1px; background: Theme.hairline-subtle; }

    RuleActionBar {
        button-text: I18n.t("添加 DNS 规则", "Add DNS Rule");
        status-text: root.status-text;
        status-ok: root.status-ok;
        commit => { root.add-dns-rule(root.current-draft()); }
        reset => { root.reset-form(); }
    }
}
