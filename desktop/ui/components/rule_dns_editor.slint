import { Button, ComboBox, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component RuleDnsEditorPanel inherits VerticalBox {
    in-out property <string> route-rule-kind: "domain-suffix";
    in-out property <string> route-match-value: "example.com";
    in-out property <string> route-target-outbound: "proxy";
    in-out property <string> dns-rule-kind: "domain-suffix";
    in-out property <string> dns-match-value: "internal.corp";
    in-out property <string> dns-target-server: "local";
    in property <string> editor-status: "";

    callback append-rule-snippet(string, string, string);
    callback append-dns-rule-snippet(string, string, string);

    spacing: 12px;

    Text {
        text: "可视化路由与 DNS 规则片段编辑器 (KDL 2.0)";
        font-size: 16px;
        font-weight: 700;
    }

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-bg;
        VerticalBox {
            padding: 12px;
            spacing: 8px;
            Text { text: "路由规则生成"; font-size: 14px; font-weight: 600; }
            HorizontalBox {
                spacing: 8px;
                ComboBox {
                    width: 170px;
                    model: ["domain-suffix", "domain", "ip-cidr", "source-mac", "gateway-mac", "process-name"];
                    current-value <=> root.route-rule-kind;
                }
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.route-match-value;
                    placeholder-text: "匹配值 (如 example.com 或 aa:bb:cc:dd:ee:ff)";
                }
                LineEdit {
                    width: 130px;
                    text <=> root.route-target-outbound;
                    placeholder-text: "目标出站";
                }
                Button {
                    text: "追加至配置";
                    primary: true;
                    clicked => { root.append-rule-snippet(root.route-rule-kind, root.route-match-value, root.route-target-outbound); }
                }
            }
        }
    }

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-bg;
        VerticalBox {
            padding: 12px;
            spacing: 8px;
            Text { text: "DNS 分流规则生成"; font-size: 14px; font-weight: 600; }
            HorizontalBox {
                spacing: 8px;
                ComboBox {
                    width: 170px;
                    model: ["domain-suffix", "domain", "query-type", "rule-set"];
                    current-value <=> root.dns-rule-kind;
                }
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.dns-match-value;
                    placeholder-text: "域名后缀 / 查询类型 (如 HTTPS 或 .local)";
                }
                LineEdit {
                    width: 130px;
                    text <=> root.dns-target-server;
                    placeholder-text: "DNS 服务器标签";
                }
                Button {
                    text: "追加 DNS 规则";
                    clicked => { root.append-dns-rule-snippet(root.dns-rule-kind, root.dns-match-value, root.dns-target-server); }
                }
            }
        }
    }

    if root.editor-status != "" : Text {
        text: root.editor-status;
        font-size: 12px;
    }

    Rectangle { vertical-stretch: 1; }
}
