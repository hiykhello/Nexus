import { ScrollView } from "std-widgets.slint";
import { ControlInspectState } from "../control_inspect_state.slint";
import { NexusVScrollBar, SlidingSegmentBar } from "nexus_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { DnsRuleDraft, RouteRuleDraft } from "../types.slint";
import { RuleDnsTab } from "rule_dns_tab.slint";
import { RuleExplainPanel } from "rule_explain_panel.slint";
import { LiveDnsQueryTab, LiveRulesTab } from "rule_inspect_tabs.slint";
import { RuleRouteTab } from "rule_route_tab.slint";

// Centered modal dialog for Routing Rules, DNS Rules, Live Explain, Live Rules & Live DNS Query
export component RuleModalDialog inherits Rectangle {
    in-out property <int> active-mode: 0;
    in-out property <string> route-rule-kind: "domain-suffix";
    in-out property <string> route-match-value: "example.com";
    in-out property <string> route-rule-action: "route";
    in-out property <string> route-target-outbound: "proxy";
    in-out property <string> dns-rule-kind: "domain-suffix";
    in-out property <string> dns-match-value: "internal.corp";
    in-out property <string> dns-target-server: "direct";
    in property <string> editor-status: "";
    in property <bool> editor-ok: true;
    in property <string> explain-result: "";
    in property <bool> explain-ok: true;

    callback close-requested();
    callback add-route-rule(RouteRuleDraft);
    callback add-dns-rule(DnsRuleDraft);
    callback run-explain(string, string, string, string);

    background: Theme.modal-backdrop;

    TouchArea {
        clicked => { root.close-requested(); }
    }

    Rectangle {
        property <length> max-dialog-h: max(280px, min(parent.height - 64px, 620px));
        width: max(320px, min(parent.width - 56px, 840px));
        height: min(self.max-dialog-h, max(240px, 62px + modal-body.preferred-height));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-card;
        border-width: 1.5px;
        border-color: Theme.modal-border;
        background: Theme.overlay-bg;
        clip: true;

        // Absorb clicks inside modal sheet so backdrop doesn't dismiss
        TouchArea {}

        VerticalLayout {
            // Modal header bar: icon + title + 3-tab segment bar + close button
            HorizontalLayout {
                vertical-stretch: 0;
                padding-left: 20px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: Theme.space-md;

                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: Theme.space-sm;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(Theme.dark ? 0.42 : 0.30);
                        background: Theme.accent-soft;

                        Image {
                            x: 6px;
                            y: 6px;
                            width: 16px;
                            height: 16px;
                            source: @image-url("../icons/rule-edit.svg");
                            colorize: Theme.accent;
                        }
                    }

                    Text {
                        text: I18n.t("路由与 DNS", "Routing & DNS");
                        font-size: 15px;
                        font-weight: 800;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                SlidingSegmentBar {
                    horizontal-stretch: 0;
                    width: min(470px, max(280px, parent.width - 210px));
                    bar-height: 32px;
                    options: [
                        I18n.t("路由规则", "Route"),
                        I18n.t("DNS 规则", "DNS"),
                        I18n.t("规则测试", "Explain"),
                        I18n.t("运行规则", "Live Rules"),
                        I18n.t("DNS 解析", "DNS Query"),
                    ];
                    current-index: root.active-mode;
                    selected(idx) => {
                        root.active-mode = idx;
                        modal-sv.content-y = 0px;
                        if (idx == 3 && ControlInspectState.live-rules.length == 0 && !ControlInspectState.rules-loading) {
                            ControlInspectState.refresh-live-rules();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    IconActionButton {
                        size: 28px;
                        icon: @image-url("../icons/x.svg");
                        label: I18n.t("关闭 (Esc)", "Close (Esc)");
                        clicked => { root.close-requested(); }
                    }
                }
            }

            Rectangle { height: 1px; background: Theme.hairline-subtle; }

            // Scrollable modal body with clean NexusVScrollBar when overflowing
            Rectangle {
                vertical-stretch: 1;

                modal-sv := ScrollView {
                    width: 100%;
                    height: 100%;
                    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, modal-body.preferred-height);

                    modal-body := VerticalLayout {
                        x: 0px;
                        y: 0px;
                        width: modal-sv.visible-width;
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 16px;
                        padding-bottom: 18px;
                        alignment: start;

                        if root.active-mode == 0 : RuleRouteTab {
                            primary-kind <=> root.route-rule-kind;
                            primary-value <=> root.route-match-value;
                            action-kind <=> root.route-rule-action;
                            target-outbound <=> root.route-target-outbound;
                            status-text: root.editor-status;
                            status-ok: root.editor-ok;
                            add-route-rule(draft) => { root.add-route-rule(draft); }
                        }

                        if root.active-mode == 1 : RuleDnsTab {
                            match-kind <=> root.dns-rule-kind;
                            match-value <=> root.dns-match-value;
                            target-server <=> root.dns-target-server;
                            status-text: root.editor-status;
                            status-ok: root.editor-ok;
                            add-dns-rule(draft) => { root.add-dns-rule(draft); }
                        }

                        if root.active-mode == 2 : RuleExplainPanel {
                            explain-result: root.explain-result;
                            explain-ok: root.explain-ok;
                            run-explain(inb, net, tgt, extra) => { root.run-explain(inb, net, tgt, extra); }
                        }

                        if root.active-mode == 3 : LiveRulesTab {}

                        if root.active-mode == 4 : LiveDnsQueryTab {}
                    }
                }

                NexusVScrollBar {
                    x: parent.width - self.width - 4px;
                    y: 12px;
                    height: max(0px, parent.height - 24px);
                    viewport-size: modal-sv.visible-height;
                    content-size: modal-sv.content-height;
                    scroll-pos <=> modal-sv.content-y;
                }
            }
        }
    }
}
