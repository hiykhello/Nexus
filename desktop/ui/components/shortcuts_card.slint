import { IconActionButton } from "icon_button.slint";
import { NexusButton } from "nexus_buttons.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { KeyBinding, Shortcuts } from "../shortcuts.slint";
import { Theme } from "../theme.slint";

component ShortcutRow inherits VerticalLayout {
    in property <string> label;
    in property <string> action-id;
    in property <KeyBinding> binding;
    in property <bool> show-divider: true;

    property <bool> is-recording: Shortcuts.recording-action == root.action-id;

    forward-focus: row-fs;
    vertical-stretch: 0;

    Rectangle {
        height: 40px;
        border-radius: Theme.radius-sm;
        border-width: row-fs.has-focus ? 2px : 0px;
        border-color: row-fs.has-focus ? Theme.accent : transparent;
        background:
            is-recording ? Theme.selected-bg
            : row-ta.has-hover ? Theme.row-hover-bg
            : transparent;
        animate background { duration: Motion.fast; }

        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { Shortcuts.start-recording(root.action-id); }

        row-fs := FocusScope {
            key-pressed(ev) => {
                if (ev.text == Key.Return || ev.text == " ") {
                    Shortcuts.start-recording(root.action-id);
                    return accept;
                }
                reject
            }
        }

        row-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Shortcuts.start-recording(root.action-id); }
        }

        HorizontalLayout {
            padding-left: Theme.space-sm;
            padding-right: Theme.space-xs;
            spacing: Theme.space-sm;

            Text {
                text: root.label;
                font-size: 13px;
                font-weight: 500;
                color: Theme.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
            }

            Rectangle {
                width: 112px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: is-recording ? Theme.accent : Theme.well-border;
                background: is-recording ? Theme.accent-soft : Theme.well-bg;

                key-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Shortcuts.start-recording(root.action-id); }
                }

                Text {
                    width: 100%;
                    height: 100%;
                    text: is-recording ? I18n.t("按下按键...", "Press keys...") : Shortcuts.format-full(root.binding);
                    font-size: 11px;
                    font-weight: 700;
                    font-family: Theme.mono-font;
                    color:
                        is-recording ? Theme.accent
                        : root.binding.key == "" ? Theme.text-muted
                        : Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;
                IconActionButton {
                    icon: @image-url("../icons/x.svg");
                    label: I18n.t("清除", "Clear");
                    enabled: root.binding.key != "";
                    size: 26px;
                    clicked => { Shortcuts.clear-action(root.action-id); }
                }
            }
        }
    }

    if root.show-divider : Rectangle { height: 1px; background: Theme.hairline-subtle; }
}

component ShortcutsGroupA inherits VerticalLayout {
    ShortcutRow { label: I18n.t("命令面板", "Command Palette"); action-id: "command-palette"; binding: Shortcuts.command-palette; }
    ShortcutRow { label: I18n.t("侧边栏", "Sidebar"); action-id: "toggle-sidebar"; binding: Shortcuts.toggle-sidebar; }
    ShortcutRow { label: I18n.t("热重载", "Reload"); action-id: "reload-config"; binding: Shortcuts.reload-config; }
    ShortcutRow { label: I18n.t("规则模拟器", "Rule Simulator"); action-id: "open-rules"; binding: Shortcuts.open-rules; }
    ShortcutRow { label: I18n.t("退出", "Quit"); action-id: "quit-app"; binding: Shortcuts.quit-app; }
    ShortcutRow { label: I18n.t("仪表盘", "Dashboard"); action-id: "tab-overview"; binding: Shortcuts.tab-overview; }
    ShortcutRow { label: I18n.t("配置文件与订阅", "Profiles"); action-id: "tab-profiles"; binding: Shortcuts.tab-profiles; show-divider: false; }
}

component ShortcutsGroupB inherits VerticalLayout {
    ShortcutRow { label: I18n.t("代理组", "Proxy Groups"); action-id: "tab-groups"; binding: Shortcuts.tab-groups; }
    ShortcutRow { label: I18n.t("路由与规则集", "Routing & Rules"); action-id: "tab-routing"; binding: Shortcuts.tab-routing; }
    ShortcutRow { label: I18n.t("DNS 与入站", "DNS & Inbounds"); action-id: "tab-dns-host"; binding: Shortcuts.tab-dns-host; }
    ShortcutRow { label: I18n.t("实时连接", "Connections"); action-id: "tab-connections"; binding: Shortcuts.tab-connections; }
    ShortcutRow { label: I18n.t("运行日志", "Logs"); action-id: "tab-logs"; binding: Shortcuts.tab-logs; }
    ShortcutRow { label: I18n.t("软件设置", "Settings"); action-id: "tab-settings"; binding: Shortcuts.tab-settings; show-divider: false; }
}

export component ShortcutsCard inherits VerticalLayout {
    in property <length> window-width: 1040px;

    property <bool> two-col: root.window-width >= 840px;

    vertical-stretch: 0;
    alignment: start;
    spacing: Theme.space-md;

    Rectangle {
        vertical-stretch: 0;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-surface;

        VerticalLayout {
            alignment: start;
            padding: Theme.space-lg;
            spacing: Theme.space-md;

            HorizontalLayout {
                vertical-stretch: 0;
                spacing: Theme.space-sm;

                if Shortcuts.recording-action != "" || Shortcuts.status-hint != "" : Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Shortcuts.recording-action != "" ? Theme.accent : Theme.success-border;
                    background: Shortcuts.recording-action != "" ? Theme.accent-soft : Theme.success-bg;
                    HorizontalLayout {
                        padding-left: Theme.space-sm; padding-right: Theme.space-sm; padding-top: Theme.space-xs; padding-bottom: Theme.space-xs;
                        Text {
                            text: Shortcuts.status-hint; font-size: 12px;
                            color: Shortcuts.recording-action != "" ? Theme.nav-active-fg : Theme.success-fg; overflow: elide;
                        }
                    }
                }

                if Shortcuts.recording-action == "" && Shortcuts.status-hint == "" : Text {
                    horizontal-stretch: 1;
                    text: I18n.t("快捷键绑定", "Keyboard Shortcuts");
                    font-size: 14px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center;
                }

                NexusButton {
                    btn-height: 28px;
                    label: I18n.t("恢复默认", "Reset");
                    clicked => { Shortcuts.reset-defaults(); }
                }
            }

            if root.two-col : HorizontalLayout {
                spacing: Theme.space-lg;
                ShortcutsGroupA { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
                ShortcutsGroupB { horizontal-stretch: 1; preferred-width: 0px; min-width: 0px; }
            }

            if !root.two-col : VerticalLayout {
                spacing: Theme.space-md;
                ShortcutsGroupA {}
                ShortcutsGroupB {}
            }
        }
    }
}
