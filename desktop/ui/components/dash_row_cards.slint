import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { NexusSwitch } from "nexus_controls.slint";

component QuickSwitchTile inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> mono-subtitle: false;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    forward-focus: fs;
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 0px;
    height: 64px;
    border-radius: Theme.radius-card;
    border-width: fs.has-focus ? 2px : 1px;
    border-color:
        fs.has-focus ? Theme.accent
        : (ta.has-hover && root.enabled) ? Theme.hairline-strong
        : Theme.card-border;
    background: (ta.has-hover && root.enabled) ? Theme.row-hover-bg : Theme.card-surface;
    opacity: root.enabled ? 1.0 : 0.55;
    animate border-color { duration: Motion.fast; }
    animate background { duration: Motion.fast; }

    accessible-role: switch;
    accessible-label: root.title;
    accessible-checked: root.checked;
    accessible-action-default => { if (root.enabled) { root.toggled(!root.checked); } }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(ev) => {
            if (root.enabled && (ev.text == Key.Return || ev.text == " ")) {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!root.checked); }
    }

    HorizontalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        spacing: Theme.space-sm;

        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                font-size: 12px;
                font-weight: 700;
                color: Theme.text-primary;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                font-size: 11px;
                font-family: root.mono-subtitle ? Theme.mono-font : "";
                color: root.checked ? Theme.nav-active-fg : Theme.text-muted;
                overflow: elide;
            }
        }

        VerticalLayout {
            alignment: center;
            NexusSwitch {
                checked: root.checked;
                enabled: root.enabled;
                interactive: false;
                auto-toggle: false;
            }
        }
    }
}

export component QuickSwitchRow inherits VerticalLayout {
    in property <bool> compact: false;
    in property <bool> mixed-enabled: true;
    in property <string> mixed-port: "7890";
    in property <bool> lan-enabled: false;
    in property <string> lan-subtitle: "";
    in property <bool> sys-proxy-supported: true;
    in property <bool> sys-proxy-enabled: false;
    in property <bool> tun-enabled: false;

    callback toggle-mixed-port(bool);
    callback toggle-lan-share(bool);
    callback toggle-system-proxy(bool);
    callback toggle-tun(bool);

    vertical-stretch: 0;
    spacing: Theme.space-sm;

    if !root.compact : HorizontalLayout {
        spacing: Theme.space-sm;
        QuickSwitchTile {
            title: I18n.t("端口代理", "Port Proxy");
            subtitle: root.mixed-enabled ? "Mixed :" + root.mixed-port : I18n.t("已关闭", "Disabled");
            mono-subtitle: root.mixed-enabled;
            checked: root.mixed-enabled;
            toggled(on) => { root.toggle-mixed-port(on); }
        }
        QuickSwitchTile {
            title: I18n.t("局域网代理", "LAN Proxy");
            subtitle: root.lan-enabled ? (root.lan-subtitle != "" ? "0.0.0.0" + root.lan-subtitle : I18n.t("已开放", "Open")) : I18n.t("仅本机", "Local only");
            mono-subtitle: root.lan-enabled && root.lan-subtitle != "";
            checked: root.lan-enabled;
            toggled(on) => { root.toggle-lan-share(on); }
        }
        QuickSwitchTile {
            title: I18n.t("系统代理", "System Proxy");
            subtitle: !root.sys-proxy-supported ? I18n.t("不支持", "Unsupported") : root.sys-proxy-enabled ? I18n.t("已接管", "Active") : I18n.t("未启用", "Off");
            checked: root.sys-proxy-enabled;
            enabled: root.sys-proxy-supported;
            toggled(on) => { root.toggle-system-proxy(on); }
        }
        QuickSwitchTile {
            title: I18n.t("TUN 模式", "TUN Mode");
            subtitle: root.tun-enabled ? I18n.t("全局虚拟网卡", "Virtual NIC") : I18n.t("未启用", "Off");
            checked: root.tun-enabled;
            toggled(on) => { root.toggle-tun(on); }
        }
    }

    if root.compact : GridLayout {
        spacing: Theme.space-sm;
        Row {
            QuickSwitchTile {
                title: I18n.t("端口代理", "Port Proxy");
                subtitle: root.mixed-enabled ? "Mixed :" + root.mixed-port : I18n.t("已关闭", "Disabled");
                mono-subtitle: root.mixed-enabled;
                checked: root.mixed-enabled;
                toggled(on) => { root.toggle-mixed-port(on); }
            }
            QuickSwitchTile {
                title: I18n.t("局域网代理", "LAN Proxy");
                subtitle: root.lan-enabled ? (root.lan-subtitle != "" ? "0.0.0.0" + root.lan-subtitle : I18n.t("已开放", "Open")) : I18n.t("仅本机", "Local only");
                mono-subtitle: root.lan-enabled && root.lan-subtitle != "";
                checked: root.lan-enabled;
                toggled(on) => { root.toggle-lan-share(on); }
            }
        }
        Row {
            QuickSwitchTile {
                title: I18n.t("系统代理", "System Proxy");
                subtitle: !root.sys-proxy-supported ? I18n.t("不支持", "Unsupported") : root.sys-proxy-enabled ? I18n.t("已接管", "Active") : I18n.t("未启用", "Off");
                checked: root.sys-proxy-enabled;
                enabled: root.sys-proxy-supported;
                toggled(on) => { root.toggle-system-proxy(on); }
            }
            QuickSwitchTile {
                title: I18n.t("TUN 模式", "TUN Mode");
                subtitle: root.tun-enabled ? I18n.t("全局虚拟网卡", "Virtual NIC") : I18n.t("未启用", "Off");
                checked: root.tun-enabled;
                toggled(on) => { root.toggle-tun(on); }
            }
        }
    }
}
