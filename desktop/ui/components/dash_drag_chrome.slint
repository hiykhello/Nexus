import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";

// Tactile drag handle + drop-target highlight overlay active ONLY in Dashboard Customize mode
export component DragHandleOverlay inherits Rectangle {
    in property <bool> editing: false;
    in property <bool> is-source: false;
    in property <bool> is-target: false;
    in property <bool> is-dragging-any: false;
    in property <length> corner-radius: 20px;
    in property <bool> show-grip-pill: true;

    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback drag-cancelled();

    width: 100%;
    height: 100%;
    visible: root.editing;
    border-radius: root.corner-radius;
    border-width: root.is-target ? 2px : 1px;
    border-color:
        root.is-target ? Theme.accent
        : root.is-source ? Theme.accent.with-alpha(0.55)
        : ta.has-hover ? Theme.accent.with-alpha(0.60)
        : Theme.accent.with-alpha(Theme.dark ? 0.24 : 0.34);
    background:
        root.is-target ? Theme.accent.with-alpha(Theme.dark ? 0.16 : 0.11)
        : root.is-source ? Theme.surface-bg.with-alpha(0.42)
        : ta.has-hover ? Theme.accent.with-alpha(Theme.dark ? 0.06 : 0.04)
        : transparent;
    drop-shadow-blur: root.is-target ? 14px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.45);
    animate border-color { duration: Motion.fast; }
    animate background { duration: Motion.fast; }

    ta := TouchArea {
        enabled: root.editing;
        mouse-cursor: root.is-dragging-any ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.drag-started(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                root.drag-ended();
            } else if (ev.kind == PointerEventKind.cancel) {
                root.drag-cancelled();
            }
        }
        moved => {
            if (self.pressed && root.editing) {
                root.drag-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // Subtle top-center grip pill (zero overlap with top-left titles or top-right card icons)
    if root.editing && root.show-grip-pill && !root.is-target : Rectangle {
        x: (parent.width - self.width) / 2;
        y: 6px;
        width: grip-lbl.preferred-width + 14px;
        height: 18px;
        border-radius: 9px;
        border-width: 1px;
        border-color: root.is-source || ta.has-hover ? Theme.accent.with-alpha(0.65) : Theme.hairline-strong;
        background: root.is-source ? Theme.accent-soft : Theme.overlay-bg;
        opacity: root.is-source ? 0.95 : ta.has-hover ? 1.0 : 0.86;

        grip-lbl := Text {
            width: 100%;
            height: 100%;
            text: "⠿";
            font-size: 11px;
            font-weight: 700;
            color: root.is-source || ta.has-hover ? Theme.accent : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // Drop target badge when hovered with a compatible dragged card
    if root.editing && root.is-target : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: drop-row.preferred-width + 20px;
        height: 28px;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.pill-active-top.brighter(0.20);
        background: @linear-gradient(135deg, Theme.pill-active-top 0%, Theme.pill-active-bot 100%);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 3px;
        drop-shadow-color: Theme.pill-active-bot.with-alpha(0.45);

        drop-row := HorizontalLayout {
            alignment: center;
            spacing: 5px;
            Text { text: "⠿"; font-size: 12px; font-weight: 700; color: Theme.pill-active-fg; vertical-alignment: center; }
            Text { text: I18n.t("放置于此", "Drop here"); font-size: 11px; font-weight: 700; color: Theme.pill-active-fg; vertical-alignment: center; }
        }
    }
}

// Slim section-level drag bar shown above each Bento row ONLY in Customize mode
export component SectionDragHeader inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <bool> is-source: false;
    in property <bool> is-target: false;
    in property <bool> is-dragging-any: false;

    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback drag-ended();
    callback drag-cancelled();

    vertical-stretch: 0;
    height: 22px;
    border-radius: 9px;
    border-width: 1px;
    border-color:
        root.is-target ? Theme.accent
        : root.is-source || ta.has-hover ? Theme.selected-border
        : Theme.well-border;
    background:
        root.is-target ? Theme.accent.with-alpha(Theme.dark ? 0.24 : 0.14)
        : root.is-source || ta.has-hover ? Theme.selected-bg
        : Theme.well-bg;
    animate border-color { duration: Motion.fast; }
    animate background { duration: Motion.fast; }

    ta := TouchArea {
        mouse-cursor: root.is-dragging-any ? MouseCursor.grabbing : MouseCursor.grab;
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.drag-started(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                root.drag-ended();
            } else if (ev.kind == PointerEventKind.cancel) {
                root.drag-cancelled();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;

        Text {
            text: "⠿";
            font-size: 12px;
            font-weight: 700;
            color: root.is-target || root.is-source || ta.has-hover ? Theme.accent : Theme.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 700;
            color: root.is-target || root.is-source ? Theme.nav-active-fg : Theme.text-secondary;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.hint != "" : Text {
            text: root.is-target ? I18n.t("松开以移动整行", "Release to move row") : root.hint;
            font-size: 10px;
            font-weight: 600;
            color: root.is-target ? Theme.accent : Theme.text-muted;
            vertical-alignment: center;
        }
    }
}

// Floating pointer-tracking drag ghost pill (non-interactive, never blocks pointer events)
export component DragGhostPill inherits Rectangle {
    in property <string> label;

    width: ghost-row.preferred-width + 24px;
    height: 34px;
    border-radius: 17px;
    border-width: 1.5px;
    border-color: Theme.accent;
    background: Theme.overlay-bg;
    opacity: 0.94;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: Theme.accent.with-alpha(Theme.dark ? 0.42 : 0.28);

    ghost-row := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        Text { text: "⠿"; font-size: 13px; font-weight: 800; color: Theme.accent; vertical-alignment: center; }
        Text { text: root.label; font-size: 12px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
    }
}
