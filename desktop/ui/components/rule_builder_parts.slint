import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { NexusInput } from "nexus_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusButton } from "nexus_buttons.slint";
import { NexusSelect } from "nexus_select.slint";

export component ConditionRow inherits HorizontalLayout {
    in-out property <string> kind: "domain-suffix";
    in-out property <string> value: "";
    in property <bool> removable: true;
    callback remove-requested();

    vertical-stretch: 0;
    spacing: Theme.space-sm;

    NexusSelect {
        width: 148px;
        options: [
            "domain-suffix",
            "domain",
            "domain-keyword",
            "domain-wildcard",
            "domain-regex",
            "ip-cidr",
            "ip-is-private",
            "port",
            "port-range",
            "network",
            "protocol",
            "process-name",
            "process-path",
        ];
        current-value <=> root.kind;
    }

    NexusInput {
        min-width: 80px;
        horizontal-stretch: 1;
        mono: true;
        text <=> root.value;
        placeholder-text:
            root.kind == "ip-cidr" ? I18n.t("如 10.0.0.0/8 或 2001:db8::/32", "e.g. 10.0.0.0/8 or 2001:db8::/32")
            : root.kind == "port" ? I18n.t("如 443", "e.g. 443")
            : root.kind == "port-range" ? I18n.t("如 8000-9000", "e.g. 8000-9000")
            : root.kind == "network" ? I18n.t("tcp 或 udp", "tcp or udp")
            : root.kind == "protocol" ? "tls / http / quic / dns / ssh / stun"
            : root.kind == "ip-is-private" ? I18n.t("私网地址 (private)", "private")
            : root.kind == "process-name" ? I18n.t("如 curl", "e.g. curl")
            : root.kind == "process-path" ? I18n.t("如 /usr/bin/curl", "e.g. /usr/bin/curl")
            : I18n.t("输入匹配值 (如 example.com)", "Match value (e.g. example.com)");
    }

    IconActionButton {
        icon: @image-url("../icons/x.svg");
        label: I18n.t("移除条件", "Remove condition");
        enabled: root.removable;
        clicked => { root.remove-requested(); }
    }
}

export component RuleActionBar inherits VerticalLayout {
    in property <string> button-text: I18n.t("添加到配置", "Add to Config");
    in property <string> status-text: "";
    in property <bool> status-ok: true;
    callback commit();
    callback reset();

    vertical-stretch: 0;
    spacing: Theme.space-sm;

    if root.status-text != "" : Rectangle {
        vertical-stretch: 0;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: root.status-ok ? Theme.success-border : Theme.error-border;
        background: root.status-ok ? Theme.success-bg : Theme.error-bg;
        HorizontalLayout {
            padding-left: Theme.space-md;
            padding-right: Theme.space-md;
            padding-top: 6px;
            padding-bottom: 6px;
            Text {
                text: root.status-text;
                font-size: 12px;
                font-weight: 600;
                color: root.status-ok ? Theme.success-fg : Theme.error-fg;
                wrap: word-wrap;
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 0;
        spacing: Theme.space-sm;

        Rectangle { horizontal-stretch: 1; }

        NexusButton {
            label: I18n.t("重置", "Reset");
            clicked => { root.reset(); }
        }

        NexusButton {
            label: root.button-text;
            primary: true;
            clicked => { root.commit(); }
        }
    }
}
