import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { GlassSpeculum } from "glass_primitives.slint";
import { IconActionButton } from "icon_button.slint";

// Hero Command Card geometry: Status + Hero Node + 2-Cell Meta on left, Large Morphing Power Orb on right
export component HeroCommandCard inherits Rectangle {
    in property <bool> core-running: false;
    in property <bool> core-toggling: false;
    in property <string> core-uptime: "";
    in property <string> active-profile: "";
    in property <string> selected-group: "";
    in property <string> active-node: "";
    in property <int> active-node-latency-ms: -1;
    in property <int> active-sessions: 0;
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;
    in property <string> hero-state-override: "";
    in property <bool> compact: false;
    in property <bool> wide: false;

    callback toggle-core();
    callback reload-config();
    callback open-groups();
    callback open-connections();
    callback open-profiles();
    callback open-config();
    callback probe-active-group();

    property <string> state:
        root.hero-state-override != "" ? root.hero-state-override
        : root.core-toggling ? "starting"
        : (!root.core-running && !root.diagnostic-ok && root.diagnostic-message != "") ? "error"
        : (root.core-running && (!root.diagnostic-ok || (root.active-node != "" && root.active-node-latency-ms == 0))) ? "degraded"
        : root.core-running ? "connected"
        : "standby";

    property <bool> is-starting: root.state == "starting";
    property <bool> is-connected: root.state == "connected";
    property <bool> is-degraded: root.state == "degraded";
    property <bool> is-error: root.state == "error";

    property <color> state-color:
        root.is-error ? Theme.error-fg
        : root.is-degraded || root.is-starting ? Theme.warn-fg
        : root.is-connected ? Theme.success-fg
        : Theme.offline-fg;

    property <int> bars: root.core-running ? Theme.latency-bars(root.active-node-latency-ms) : 0;
    property <color> lat-color: !root.core-running ? Theme.offline-fg : Theme.latency-fg(root.active-node-latency-ms, root.active-node-latency-ms == 0 ? "timeout" : "healthy");
    property <float> aura-phase: Motion.reduced ? 0.0 : mod(animation-tick(), 2600ms) / 2600ms;
    property <float> aura-breath: Motion.reduced ? 0.72 : (0.62 + 0.34 * Math.abs(Math.sin(root.aura-phase * 180deg)));
    property <length> orb-size: root.compact ? 66px : root.wide ? 86px : 76px;

    property <string> inline-issue-text:
        (!root.diagnostic-ok && root.diagnostic-message != "") ? root.diagnostic-message
        : root.is-degraded ? I18n.t("当前节点响应超时", "Active node timed out")
        : I18n.t("启动失败，请检查配置", "Start failed, check config");

    border-radius: 20px;
    border-width: 1px;
    border-color:
        root.is-error ? Theme.error-border
        : root.is-degraded ? Theme.warn-border
        : root.is-connected ? Theme.success-border
        : Theme.card-border;
    background:
        root.is-error ? @linear-gradient(135deg, Theme.error-fg.with-alpha(Theme.dark ? 0.14 : 0.08) 0%, Theme.card-bg 58%)
        : root.is-degraded ? @linear-gradient(135deg, Theme.warn-fg.with-alpha(Theme.dark ? 0.14 : 0.08) 0%, Theme.card-bg 58%)
        : root.is-connected ? @linear-gradient(135deg, Theme.success-fg.with-alpha(Theme.dark ? 0.12 : 0.07) 0%, Theme.card-bg 56%)
        : Theme.card-surface;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 3px;
    drop-shadow-color: Theme.card-shadow;
    clip: true;
    animate border-color { duration: Motion.fast; }

    GlassSpeculum {}

    // Crisp geometric faceted Prism watermark sized 100% inside card with comfortable vertical margins
    Path {
        property <length> wm-size: root.compact ? 114px : 136px;
        x: parent.width - self.width - (root.wide ? 26px : 16px);
        y: (parent.height - self.height) / 2;
        width: self.wm-size;
        height: self.wm-size;
        viewbox-width: 120;
        viewbox-height: 120;
        fill: (root.is-connected ? Theme.success-fg : Theme.accent).with-alpha(Theme.dark ? 0.055 : 0.065);
        stroke: (root.is-connected ? Theme.success-fg : Theme.accent).with-alpha(Theme.dark ? 0.12 : 0.13);
        stroke-width: 1.2px;
        commands: "M 60 6 L 112 96 L 60 112 L 8 96 Z M 60 6 L 60 76 M 8 96 L 60 76 L 112 96 M 60 28 L 88 82 L 60 72 L 32 82 Z";
    }

    // Animated top optical scan bar during Starting / Stopping
    if root.is-starting : Rectangle {
        x: 0px; y: 0px; width: 100%; height: 2px; background: Theme.warn-bg;
        Rectangle {
            property <float> sweep: Motion.reduced ? 0.25 : mod(animation-tick(), 1200ms) / 1200ms;
            x: (parent.width + self.width) * self.sweep - self.width;
            y: 0px; width: parent.width * 0.36; height: 2px; background: Theme.warn-fg;
        }
    }

    HorizontalLayout {
        padding-left: root.wide ? 20px : 14px;
        padding-right: root.wide ? 20px : 14px;
        padding-top: root.compact ? 12px : 16px;
        padding-bottom: root.compact ? 12px : 16px;
        spacing: root.wide ? 12px : 8px;

        // Left content column
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: root.compact ? 6px : 10px;

            // Calm top row: glowing status pill on left + subtle reload icon on right
            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 0;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: root.state-color.with-alpha(0.38);
                    background: root.state-color.with-alpha(Theme.dark ? 0.16 : 0.12);

                    HorizontalLayout {
                        padding-left: 9px; padding-right: 10px; spacing: 6px;
                        Rectangle {
                            width: 7px; height: 7px; y: (parent.height - self.height) / 2; border-radius: 3.5px;
                            background: root.state-color;
                        }
                        Text {
                            text:
                                root.is-starting ? (root.core-running ? I18n.t("正在停止", "Stopping") : I18n.t("正在启动", "Starting"))
                                : root.is-error ? I18n.t("连接失败", "Failed")
                                : root.is-degraded ? I18n.t("连接波动", "Degraded")
                                : root.is-connected ? I18n.t("已连接", "Connected")
                                : I18n.t("未连接", "Disconnected");
                            font-size: 11px; font-weight: 700; color: root.state-color; vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                IconActionButton {
                    size: 24px;
                    icon: @image-url("../icons/reload.svg");
                    label: I18n.t("重载", "Reload");
                    spin-on-click: true;
                    enabled: root.core-running;
                    clicked => { root.reload-config(); }
                }
            }

            // Tightly grouped Hero Active Node headline + 4-bar ascending signal + latency pill (zero middle void!)
            Rectangle {
                height: root.compact ? 32px : 38px;
                border-radius: 10px;
                background: node-ta.has-hover ? Theme.row-hover-bg : transparent;
                animate background { duration: Motion.fast; }

                node-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-groups(); } }

                HorizontalLayout {
                    spacing: 9px;

                    Text {
                        horizontal-stretch: 0; min-width: 0px;
                        text: root.active-node != "" ? root.active-node : (root.selected-group != "" ? root.selected-group : I18n.t("待连接节点", "Ready to connect"));
                        font-size: root.wide ? 26px : 20px;
                        font-weight: 800;
                        letter-spacing: -0.4px;
                        color: root.core-running ? Theme.text-primary : Theme.text-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        horizontal-stretch: 0;
                        width: 20px; spacing: 2px; padding-top: 8px; padding-bottom: 8px;
                        Rectangle { width: 3.5px; height: 5px; y: parent.height - self.height - 8px; border-radius: 1.5px; background: root.bars >= 1 ? root.lat-color : Theme.offline-fg; opacity: root.bars >= 1 ? 1.0 : 0.28; }
                        Rectangle { width: 3.5px; height: 8px; y: parent.height - self.height - 8px; border-radius: 1.5px; background: root.bars >= 2 ? root.lat-color : Theme.offline-fg; opacity: root.bars >= 2 ? 1.0 : 0.24; }
                        Rectangle { width: 3.5px; height: 11px; y: parent.height - self.height - 8px; border-radius: 1.5px; background: root.bars >= 3 ? root.lat-color : Theme.offline-fg; opacity: root.bars >= 3 ? 1.0 : 0.22; }
                        Rectangle { width: 3.5px; height: 14px; y: parent.height - self.height - 8px; border-radius: 1.5px; background: root.bars >= 4 ? root.lat-color : Theme.offline-fg; opacity: root.bars >= 4 ? 1.0 : 0.20; }
                    }

                    if root.core-running && root.active-node-latency-ms >= 0 : Rectangle {
                        horizontal-stretch: 0;
                        height: 22px; y: (parent.height - self.height) / 2; border-radius: 7px;
                        background: Theme.latency-bg(root.active-node-latency-ms, root.active-node-latency-ms == 0 ? "timeout" : "healthy");
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            Text {
                                text: root.active-node-latency-ms > 0 ? "\{root.active-node-latency-ms} ms" : I18n.t("超时", "Timeout");
                                font-size: 11px; font-weight: 700; font-family: Theme.mono-font; color: root.lat-color; vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // Calm standby ready subtitle when idle (never leaves a hollow gap in cold-launch state)
            if !root.core-running && !root.is-error && !root.is-starting : HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    horizontal-stretch: 0;
                    width: 6px; height: 6px; y: (parent.height - self.height) / 2; border-radius: 3px;
                    background: Theme.accent.with-alpha(0.75);
                }
                Text {
                    horizontal-stretch: 1; min-width: 0px;
                    text: (root.active-profile != "" ? root.active-profile + " · " : "")
                        + (root.active-node != ""
                            ? I18n.t("节点已就绪，点击右侧启动", "Node ready, click orb to start")
                            : I18n.t("配置已就绪，点击右侧启动连接", "Profile ready, click orb to connect"));
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            // Crisp 1-line inline recovery bar ONLY for Degraded / Failed states
            if root.is-error || root.is-degraded : Rectangle {
                height: 28px;
                border-radius: 9px;
                border-width: 1px;
                border-color: root.is-error ? Theme.error-border : Theme.warn-border;
                background: root.is-error ? Theme.error-bg : Theme.warn-bg;

                HorizontalLayout {
                    padding-left: 8px; padding-right: 6px; spacing: 6px;
                    Image { width: 13px; height: 13px; y: (parent.height - self.height) / 2; source: @image-url("../icons/alert-triangle.svg"); colorize: root.is-error ? Theme.error-fg : Theme.warn-fg; }
                    Text { horizontal-stretch: 1; min-width: 0px; text: root.inline-issue-text; font-size: 11px; font-weight: 600; color: root.is-error ? Theme.error-fg : Theme.warn-fg; vertical-alignment: center; overflow: elide; }
                    Rectangle {
                        horizontal-stretch: 0; height: 20px; y: (parent.height - self.height) / 2; border-radius: 6px;
                        border-width: 1px; border-color: root.is-error ? Theme.error-border : Theme.warn-border;
                        background: fix-ta.has-hover ? Theme.row-hover-bg : Theme.overlay-bg;
                        fix-ta := TouchArea { mouse-cursor: pointer; clicked => { if (root.is-error) { root.open-config(); } else { root.probe-active-group(); } } }
                        HorizontalLayout {
                            padding-left: 7px; padding-right: 7px;
                            Text { text: root.is-error ? I18n.t("检查配置", "Config") : I18n.t("测速", "Probe"); font-size: 10px; font-weight: 700; color: Theme.text-primary; vertical-alignment: center; }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // Clean bottom inline metadata strip (Runtime · Active Connections ↗)
            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: I18n.t("运行时长 ", "Uptime ") + (root.core-running && root.core-uptime != "" ? root.core-uptime : "--:--:--");
                    font-size: 12px; font-weight: 600; font-family: Theme.mono-font;
                    color: root.core-running ? Theme.text-secondary : Theme.text-muted;
                    vertical-alignment: center;
                }

                Text { text: "·"; font-size: 12px; font-weight: 700; color: Theme.text-muted; vertical-alignment: center; }

                Rectangle {
                    horizontal-stretch: 0; height: 22px; border-radius: 7px;
                    background: conn-ta.has-hover ? Theme.row-hover-bg : transparent;
                    conn-ta := TouchArea { mouse-cursor: pointer; clicked => { root.open-connections(); } }
                    HorizontalLayout {
                        padding-left: 4px; padding-right: 6px; spacing: 4px;
                        Text {
                            text: I18n.t("活跃连接 ", "Connections ") + (root.core-running ? "\{root.active-sessions}" : "0") + " ↗";
                            font-size: 12px; font-weight: 600; font-family: Theme.mono-font;
                            color: root.core-running ? Theme.text-secondary : Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        // Right side: Radiant Jewel Power Orb with multi-layer ambient bloom & crisp solid white glyph
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;

            Rectangle {
                width: root.orb-size + (root.wide ? 24px : 10px);
                height: root.orb-size + (root.wide ? 24px : 10px);

                // Soft multi-layer outer radial Emerald / Cobalt bloom
                Rectangle {
                    property <length> bloom-d: root.orb-size + 52px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: self.bloom-d;
                    height: self.bloom-d;
                    border-radius: self.bloom-d / 2;
                    background: root.core-running
                        ? @radial-gradient(circle, #10b98166 0%, #10b98122 48%, transparent 72%)
                        : @radial-gradient(circle, Theme.accent.with-alpha(Theme.dark ? 0.36 : 0.24) 0%, Theme.accent.with-alpha(0.10) 48%, transparent 72%);
                }

                // Breathing ambient ring when connected
                if (root.is-connected || root.is-degraded) && !Motion.reduced : Rectangle {
                    property <length> ring-d: root.orb-size + 14px * root.aura-phase;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: self.ring-d;
                    height: self.ring-d;
                    border-radius: self.ring-d / 2;
                    background: root.state-color.with-alpha(0.32 * (1.0 - root.aura-phase));
                }

                orb := Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.orb-size;
                    height: root.orb-size;
                    border-radius: root.core-running || root.is-starting ? (root.compact ? 25px : 32px) : (root.orb-size / 2);
                    border-width: 1.5px;
                    border-color:
                        root.is-starting ? Theme.warn-border
                        : root.core-running ? #a7f3d0.with-alpha(orb-ta.has-hover ? 0.92 : 0.64)
                        : Theme.pill-active-top.brighter(0.22);
                    background:
                        root.is-starting ? Theme.warn-bg
                        : root.core-running
                            ? (orb-ta.pressed
                                ? @linear-gradient(145deg, #059669 0%, #047857 100%)
                                : orb-ta.has-hover
                                    ? @linear-gradient(145deg, #6ee7b7 0%, #10b981 52%, #059669 100%)
                                    : @linear-gradient(145deg, #34d399 0%, #10b981 52%, #059669 100%))
                            : (orb-ta.pressed
                                ? @linear-gradient(145deg, Theme.pill-active-bot 0%, Theme.pill-active-bot.darker(0.14) 100%)
                                : @linear-gradient(145deg, Theme.pill-active-top 0%, Theme.pill-active-bot 100%));
                    drop-shadow-blur: root.core-running ? 26px : 20px;
                    drop-shadow-offset-y: 4px;
                    drop-shadow-color: root.core-running ? #10b98188 : Theme.pill-active-bot.with-alpha(Theme.dark ? 0.48 : 0.32);
                    transform-scale: !root.is-starting && orb-ta.pressed ? 0.93 : 1.0;
                    clip: true;
                    animate border-radius { duration: Motion.slow; easing: cubic-bezier(0.34, 1.4, 0.64, 1.0); }
                    animate border-color { duration: Motion.fast; }
                    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.34, 1.56, 0.64, 1.0); }

                    // Top jewel specular crescent sheen
                    Rectangle {
                        x: 10px; y: 3px;
                        width: parent.width - 20px; height: parent.height * 0.36;
                        border-radius: self.height / 2;
                        background: @linear-gradient(180deg, #ffffff40 0%, transparent 100%);
                    }

                    orb-ta := TouchArea {
                        enabled: !root.is-starting;
                        mouse-cursor: root.is-starting ? default : pointer;
                        clicked => { root.toggle-core(); }
                    }

                    if root.is-starting : Image {
                        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        width: root.compact ? 24px : 28px; height: root.compact ? 24px : 28px;
                        source: @image-url("../icons/loader.svg");
                        colorize: Theme.warn-fg;
                        transform-rotation: Motion.reduced ? 0deg : 360deg * (mod(animation-tick(), 900ms) / 900ms);
                    }
                    // Crisp SOLID filled white rounded square when running (matching approved v6 concept!)
                    if !root.is-starting && root.core-running : Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.compact ? 18px : 22px;
                        height: root.compact ? 18px : 22px;
                        border-radius: 5px;
                        background: #ffffff;
                        drop-shadow-blur: 6px;
                        drop-shadow-color: #00000028;
                    }
                    // Crisp solid white Play glyph when idle
                    if !root.is-starting && !root.core-running : Path {
                        x: (parent.width - self.width) / 2 + 2px;
                        y: (parent.height - self.height) / 2;
                        width: root.compact ? 20px : 24px;
                        height: root.compact ? 22px : 26px;
                        viewbox-width: 24;
                        viewbox-height: 26;
                        fill: #ffffff;
                        commands: "M 5 3.5 C 5 2.0 6.6 1.1 7.9 1.9 L 21.4 10.9 C 22.6 11.7 22.6 13.5 21.4 14.3 L 7.9 23.3 C 6.6 24.1 5 23.2 5 21.7 Z";
                    }
                }
            }
        }
    }
}
