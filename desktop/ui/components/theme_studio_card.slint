import { I18n, LanguagePreference } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { AccentPreset, Theme, ThemePreference } from "../theme.slint";
import { SlidingSegmentBar } from "glass_primitives.slint";
import { NexusButton } from "nexus_buttons.slint";
import { NexusSwitch } from "nexus_controls.slint";

component AccentChip inherits Rectangle {
    in property <string> label;
    in property <color> swatch-color;
    in property <bool> selected: false;
    callback chosen();

    forward-focus: fs;
    height: 30px;
    border-radius: Theme.radius-md;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.accent : (root.selected ? root.swatch-color : Theme.well-border);
    background:
        root.selected ? root.swatch-color.with-alpha(Theme.dark ? 0.22 : 0.14)
        : ta.has-hover ? Theme.row-hover-bg
        : Theme.well-bg;
    transform-scale: ta.pressed ? 0.97 : 1.0;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Return || ev.text == " ") { root.chosen(); return accept; }
            reject
        }
    }

    ta := TouchArea { mouse-cursor: pointer; clicked => { root.chosen(); } }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 11px;
        spacing: 6px;

        Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.swatch-color;
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

export component ThemeStudioCard inherits Rectangle {
    in property <length> window-width: 1280px;
    callback prefs-changed();

    vertical-stretch: 0;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;

    VerticalLayout {
        alignment: start;
        padding: Theme.space-lg;
        spacing: Theme.space-md;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: I18n.t("外观与语言", "Appearance & Language");
                font-size: 14px;
                font-weight: 700;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }

            NexusButton {
                btn-height: 28px;
                label: I18n.t("恢复默认", "Reset");
                clicked => {
                    Theme.apply-preference(ThemePreference.system);
                    Theme.accent-preset = AccentPreset.ocean;
                    I18n.preference = LanguagePreference.system;
                    Motion.reduced = false;
                    root.prefs-changed();
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-md;
            Text { width: 72px; text: I18n.t("主题模式", "Theme"); font-size: 13px; font-weight: 500; color: Theme.text-secondary; vertical-alignment: center; }
            SlidingSegmentBar {
                horizontal-stretch: 1;
                max-width: 360px;
                bar-height: 32px;
                options: [I18n.t("跟随系统", "System"), I18n.t("浅色", "Light"), I18n.t("深色", "Dark")];
                current-index: Theme.preference == ThemePreference.light ? 1 : Theme.preference == ThemePreference.dark ? 2 : 0;
                selected(idx) => {
                    Theme.apply-preference(idx == 1 ? ThemePreference.light : idx == 2 ? ThemePreference.dark : ThemePreference.system);
                    root.prefs-changed();
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-md;
            Text { width: 72px; text: I18n.t("界面语言", "Language"); font-size: 13px; font-weight: 500; color: Theme.text-secondary; vertical-alignment: center; }
            SlidingSegmentBar {
                horizontal-stretch: 1;
                max-width: 360px;
                bar-height: 32px;
                options: [I18n.t("跟随系统", "System"), "简体中文", "English"];
                current-index: I18n.preference == LanguagePreference.zh-cn ? 1 : I18n.preference == LanguagePreference.en-us ? 2 : 0;
                selected(idx) => {
                    I18n.preference = idx == 1 ? LanguagePreference.zh-cn : idx == 2 ? LanguagePreference.en-us : LanguagePreference.system;
                    root.prefs-changed();
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-md;
            Text { width: 72px; text: I18n.t("强调色", "Accent"); font-size: 13px; font-weight: 500; color: Theme.text-secondary; vertical-alignment: center; }
            FlexboxLayout {
                horizontal-stretch: 1;
                vertical-stretch: 0;
                spacing: 6px;
                AccentChip { label: I18n.t("蔚蓝", "Ocean"); swatch-color: Theme.dark ? #3b82f6 : #1d4ed8; selected: Theme.accent-preset == AccentPreset.ocean; chosen => { Theme.accent-preset = AccentPreset.ocean; root.prefs-changed(); } }
                AccentChip { label: I18n.t("翡翠", "Emerald"); swatch-color: Theme.dark ? #22c55e : #15803d; selected: Theme.accent-preset == AccentPreset.emerald; chosen => { Theme.accent-preset = AccentPreset.emerald; root.prefs-changed(); } }
                AccentChip { label: I18n.t("极光紫", "Violet"); swatch-color: Theme.dark ? #a78bfa : #6d28d9; selected: Theme.accent-preset == AccentPreset.violet; chosen => { Theme.accent-preset = AccentPreset.violet; root.prefs-changed(); } }
                AccentChip { label: I18n.t("琥珀", "Amber"); swatch-color: Theme.dark ? #f59e0b : #b45309; selected: Theme.accent-preset == AccentPreset.amber; chosen => { Theme.accent-preset = AccentPreset.amber; root.prefs-changed(); } }
                AccentChip { label: I18n.t("绯红", "Rose"); swatch-color: Theme.dark ? #fb7185 : #dc2626; selected: Theme.accent-preset == AccentPreset.rose; chosen => { Theme.accent-preset = AccentPreset.rose; root.prefs-changed(); } }
            }
        }

        Rectangle { height: 1px; background: Theme.hairline-subtle; }

        HorizontalLayout {
            vertical-stretch: 0;
            height: 30px;
            spacing: Theme.space-md;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: I18n.t("减弱动态效果", "Reduced Motion");
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.text-primary;
                }
            }
            VerticalLayout {
                alignment: center;
                NexusSwitch {
                    checked <=> Motion.reduced;
                    toggled => { root.prefs-changed(); }
                }
            }
        }
    }
}
