import { I18n, LanguagePreference } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { AccentPreset, Theme, ThemePreference } from "../theme.slint";
import { SlidingSegmentBar } from "nexus_primitives.slint";
import { NexusButton, NexusChip } from "nexus_buttons.slint";
import { NexusOpacitySlider, NexusSwitch } from "nexus_controls.slint";

// Pure-Slint miniature chassis window swatch (0ms instant theme switching, zero bitmaps/gradients)
component ThemeSwatchCard inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> split-system: false;
    in property <color> rail-bg;
    in property <color> canvas-bg;
    in property <color> mini-card-bg;
    in property <color> mini-border;
    in property <color> swatch-accent;
    in property <color> swatch-emerald;
    callback chosen();

    forward-focus: fs;
    horizontal-stretch: 1;
    preferred-width: 0px;
    min-width: 112px;
    height: 70px;
    border-radius: Theme.radius-md;
    border-width: fs.has-focus || root.selected ? 2px : 1px;
    border-color:
        fs.has-focus ? Theme.accent
        : root.selected ? Theme.accent
        : ta.has-hover ? Theme.hairline-strong
        : Theme.well-border;
    background: root.selected ? Theme.selected-bg : ta.has-hover ? Theme.row-hover-bg : Theme.well-bg;
    clip: true;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Return || ev.text == " ") { root.chosen(); return accept; }
            reject
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    VerticalLayout {
        padding: 6px;
        spacing: 5px;

        // Miniature window chassis preview
        Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-xs;
            border-width: 1px;
            border-color: root.mini-border;
            background: root.canvas-bg;
            clip: true;

            if !root.split-system : HorizontalLayout {
                // Mini Navigation Rail
                Rectangle {
                    width: 14px;
                    background: root.rail-bg;
                    Rectangle { x: 2px; y: 5px; width: 10px; height: 5px; border-radius: 2px; background: root.swatch-accent; }
                    Rectangle { x: 2px; y: 13px; width: 10px; height: 3px; border-radius: 1.5px; background: root.mini-border; }
                    Rectangle { x: 2px; y: 19px; width: 10px; height: 3px; border-radius: 1.5px; background: root.mini-border; }
                }
                Rectangle { width: 1px; background: root.mini-border; }
                // Mini 2x2 Card Dashboard
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 4px;
                    spacing: 3px;
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 3px;
                        Rectangle { horizontal-stretch: 1; border-radius: 3px; border-width: 1px; border-color: root.mini-border; background: root.mini-card-bg;
                            Rectangle { x: 3px; y: 4px; width: max(6px, parent.width - 6px); height: 5px; border-radius: 2px; background: root.swatch-accent; }
                        }
                        Rectangle { horizontal-stretch: 1; border-radius: 3px; border-width: 1px; border-color: root.mini-border; background: root.mini-card-bg;
                            Rectangle { x: 3px; y: 6px; width: max(6px, parent.width - 6px); height: 3px; border-radius: 1.5px; background: root.swatch-emerald; }
                        }
                    }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 3px;
                        Rectangle { horizontal-stretch: 1; border-radius: 3px; border-width: 1px; border-color: root.mini-border; background: root.mini-card-bg; }
                        Rectangle { horizontal-stretch: 1; border-radius: 3px; border-width: 1px; border-color: root.mini-border; background: root.mini-card-bg; }
                    }
                }
            }

            // System Auto split preview: left Light Card Console / right Dark Card Console
            if root.split-system : HorizontalLayout {
                Rectangle {
                    horizontal-stretch: 1;
                    background: #f4f6f9;
                    Rectangle { x: 0px; y: 0px; width: 10px; height: 100%; background: #ffffff; }
                    Rectangle { x: 14px; y: 4px; width: max(8px, parent.width - 18px); height: 12px; border-radius: 3px; border-width: 1px; border-color: #e2e8f0; background: #ffffff; }
                    Rectangle { x: 14px; y: 19px; width: max(8px, parent.width - 18px); height: 11px; border-radius: 3px; border-width: 1px; border-color: #e2e8f0; background: #ffffff; }
                }
                Rectangle { width: 1px; background: Theme.hairline-strong; }
                Rectangle {
                    horizontal-stretch: 1;
                    background: #0f141c;
                    Rectangle { x: 0px; y: 0px; width: 10px; height: 100%; background: #131923; }
                    Rectangle { x: 14px; y: 4px; width: max(8px, parent.width - 18px); height: 12px; border-radius: 3px; border-width: 1px; border-color: #263142; background: #171e29; }
                    Rectangle { x: 14px; y: 19px; width: max(8px, parent.width - 18px); height: 11px; border-radius: 3px; border-width: 1px; border-color: #263142; background: #171e29; }
                }
            }
        }

        // Swatch label + dual accent/emerald micro-dots
        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 4px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.label;
                font-size: 11px;
                font-weight: root.selected ? 700 : 600;
                color: root.selected ? Theme.nav-active-fg : Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                width: 6px; height: 6px; y: (parent.height - self.height) / 2;
                border-radius: 3px; background: root.swatch-accent;
            }
            Rectangle {
                width: 6px; height: 6px; y: (parent.height - self.height) / 2;
                border-radius: 3px; background: root.swatch-emerald;
            }
        }
    }
}

component AccentChip inherits Rectangle {
    in property <string> label;
    in property <color> swatch-color;
    in property <bool> selected: false;
    callback chosen();

    forward-focus: fs;
    height: 30px;
    border-radius: Theme.radius-md;
    border-width: fs.has-focus ? 2px : 1px;
    border-color: fs.has-focus ? Theme.accent : (root.selected ? root.swatch-color : Theme.well-border);
    background:
        root.selected ? root.swatch-color.with-alpha(Theme.dark ? 0.22 : 0.14)
        : ta.has-hover ? Theme.row-hover-bg
        : Theme.well-bg;
    transform-scale: ta.pressed ? 0.97 : 1.0;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.chosen(); }

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Return || ev.text == " ") { root.chosen(); return accept; }
            reject
        }
    }

    ta := TouchArea { mouse-cursor: pointer; clicked => { root.chosen(); } }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 11px;
        spacing: 6px;

        Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: root.swatch-color;
        }

        Text {
            text: root.label;
            font-size: 12px;
            font-weight: root.selected ? 700 : 500;
            color: Theme.text-primary;
            vertical-alignment: center;
        }
    }
}

export component ThemeStudioCard inherits Rectangle {
    in property <length> window-width: 1280px;
    callback prefs-changed();

    vertical-stretch: 0;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.card-border;
    background: Theme.card-surface;

    VerticalLayout {
        alignment: start;
        padding: Theme.space-lg;
        spacing: Theme.space-md;

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: I18n.t("外观", "Appearance");
                font-size: 16px;
                font-weight: 800;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }

            NexusButton {
                btn-height: 28px;
                label: I18n.t("恢复默认", "Reset");
                clicked => {
                    Theme.apply-preference(ThemePreference.system);
                    Theme.accent-preset = AccentPreset.ocean;
                    Theme.blur-enabled = true;
                    Theme.window-opacity = 0.88;
                    I18n.preference = LanguagePreference.system;
                    root.prefs-changed();
                }
            }
        }

        // 4 Live Instrument Swatch Cards (0ms instant apply)
        VerticalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-sm;
            Text { text: I18n.t("主题预设", "Theme Preset"); font-size: 12px; font-weight: 600; color: Theme.text-secondary; }
            HorizontalLayout {
                spacing: Theme.space-sm;
                ThemeSwatchCard {
                    label: I18n.t("跟随系统", "System");
                    split-system: true;
                    rail-bg: #ffffff; canvas-bg: #f4f6f9; mini-card-bg: #ffffff; mini-border: #e2e8f0;
                    swatch-accent: #2563eb; swatch-emerald: #10b981;
                    selected: Theme.preference == ThemePreference.system;
                    chosen => { Theme.apply-preference(ThemePreference.system); root.prefs-changed(); }
                }
                ThemeSwatchCard {
                    label: I18n.t("浅色", "Light");
                    rail-bg: #ffffff; canvas-bg: #f4f6f9; mini-card-bg: #ffffff; mini-border: #e2e8f0;
                    swatch-accent: #2563eb; swatch-emerald: #059669;
                    selected: Theme.preference == ThemePreference.paper;
                    chosen => { Theme.apply-preference(ThemePreference.paper); root.prefs-changed(); }
                }
                ThemeSwatchCard {
                    label: I18n.t("深色", "Dark");
                    rail-bg: #131923; canvas-bg: #0f141c; mini-card-bg: #171e29; mini-border: #263142;
                    swatch-accent: #60a5fa; swatch-emerald: #10b981;
                    selected: Theme.preference == ThemePreference.obsidian;
                    chosen => { Theme.apply-preference(ThemePreference.obsidian); root.prefs-changed(); }
                }
                ThemeSwatchCard {
                    label: I18n.t("暖金", "Amber");
                    rail-bg: #161411; canvas-bg: #12100e; mini-card-bg: #1b1815; mini-border: #2f2a23;
                    swatch-accent: #f59e0b; swatch-emerald: #10b981;
                    selected: Theme.preference == ThemePreference.amber;
                    chosen => { Theme.apply-preference(ThemePreference.amber); root.prefs-changed(); }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-md;
            Text { width: 72px; text: I18n.t("界面语言", "Language"); font-size: 13px; font-weight: 500; color: Theme.text-secondary; vertical-alignment: center; }
            SlidingSegmentBar {
                horizontal-stretch: 1;
                max-width: 360px;
                bar-height: 32px;
                options: [I18n.t("跟随系统", "System"), "简体中文", "English"];
                current-index: I18n.preference == LanguagePreference.zh-cn ? 1 : I18n.preference == LanguagePreference.en-us ? 2 : 0;
                selected(idx) => {
                    I18n.preference = idx == 1 ? LanguagePreference.zh-cn : idx == 2 ? LanguagePreference.en-us : LanguagePreference.system;
                    root.prefs-changed();
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            spacing: Theme.space-md;
            Text { width: 72px; text: I18n.t("强调色", "Accent"); font-size: 13px; font-weight: 500; color: Theme.text-secondary; vertical-alignment: center; }
            FlexboxLayout {
                horizontal-stretch: 1;
                vertical-stretch: 0;
                spacing: 6px;
                AccentChip { label: I18n.t("默认", "Default"); swatch-color: Theme.is-amber ? #f59e0b : (Theme.dark ? #60a5fa : #2563eb); selected: Theme.accent-preset == AccentPreset.ocean; chosen => { Theme.accent-preset = AccentPreset.ocean; root.prefs-changed(); } }
                AccentChip { label: I18n.t("翡翠", "Emerald"); swatch-color: Theme.dark ? #10b981 : #059669; selected: Theme.accent-preset == AccentPreset.emerald; chosen => { Theme.accent-preset = AccentPreset.emerald; root.prefs-changed(); } }
                AccentChip { label: I18n.t("极光紫", "Violet"); swatch-color: Theme.dark ? #a78bfa : #6d28d9; selected: Theme.accent-preset == AccentPreset.violet; chosen => { Theme.accent-preset = AccentPreset.violet; root.prefs-changed(); } }
                AccentChip { label: I18n.t("琥珀", "Amber"); swatch-color: Theme.dark ? #f59e0b : #d97706; selected: Theme.accent-preset == AccentPreset.amber; chosen => { Theme.accent-preset = AccentPreset.amber; root.prefs-changed(); } }
                AccentChip { label: I18n.t("绯红", "Rose"); swatch-color: Theme.dark ? #f87171 : #e11d48; selected: Theme.accent-preset == AccentPreset.rose; chosen => { Theme.accent-preset = AccentPreset.rose; root.prefs-changed(); } }
            }
        }

        Rectangle { height: 1px; background: Theme.hairline-subtle; }

        // Window & Surface Opacity Control (40% – 100% continuous slider + presets)
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    spacing: 2px;
                    Text {
                        text: I18n.t("窗口透明度", "Window Opacity");
                        font-size: 13px;
                        font-weight: 600;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: I18n.t("低于 100% 自动启用窗口透明", "Below 100% enables translucency");
                        font-size: 11px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
                Text {
                    text: "\{Math.round(Theme.clamped-opacity * 100.0)}%";
                    font-size: 12px;
                    font-weight: 700;
                    font-family: Theme.mono-font;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 10px;
                NexusOpacitySlider {
                    horizontal-stretch: 1;
                    value <=> Theme.window-opacity;
                    changed-value(v) => {
                        root.prefs-changed();
                    }
                }
                HorizontalLayout {
                    horizontal-stretch: 0;
                    spacing: 4px;
                    NexusChip {
                        chip-height: 24px;
                        label: "100%";
                        active: Math.abs(Theme.window-opacity - 1.0) < 0.02;
                        clicked => { Theme.window-opacity = 1.0; root.prefs-changed(); }
                    }
                    NexusChip {
                        chip-height: 24px;
                        label: "88%";
                        active: Math.abs(Theme.window-opacity - 0.88) < 0.02;
                        clicked => { Theme.window-opacity = 0.88; root.prefs-changed(); }
                    }
                    NexusChip {
                        chip-height: 24px;
                        label: "75%";
                        active: Math.abs(Theme.window-opacity - 0.75) < 0.02;
                        clicked => { Theme.window-opacity = 0.75; root.prefs-changed(); }
                    }
                    NexusChip {
                        chip-height: 24px;
                        label: "60%";
                        active: Math.abs(Theme.window-opacity - 0.60) < 0.02;
                        clicked => { Theme.window-opacity = 0.60; root.prefs-changed(); }
                    }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 0;
            min-height: 36px;
            spacing: Theme.space-md;
            VerticalLayout {
                horizontal-stretch: 1;
                min-width: 0px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: I18n.t("背景模糊", "Backdrop Blur");
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.text-primary;
                }
                Text {
                    text: I18n.t("启用系统毛玻璃效果", "Enable native window blur");
                    font-size: 11px;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                NexusSwitch {
                    checked <=> Theme.blur-enabled;
                    toggled => { root.prefs-changed(); }
                }
            }
        }
    }
}
