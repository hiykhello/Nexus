import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";

export component NexusSwitch inherits HorizontalLayout {
    in-out property <bool> checked: false;
    in property <string> text: "";
    in property <bool> enabled: true;
    in property <bool> interactive: true;
    in property <bool> auto-toggle: true;
    callback toggled();

    forward-focus: fs;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    spacing: Theme.space-sm;

    accessible-role: switch;
    accessible-label: root.text;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled && root.interactive) {
            if (root.auto-toggle) { root.checked = !root.checked; }
            root.toggled();
        }
    }

    Rectangle {
        width: 38px;
        height: 22px;
        y: (parent.height - self.height) / 2;
        border-radius: 11px;
        border-width: fs.has-focus ? 2px : 1px;
        border-color:
            fs.has-focus ? Theme.accent
            : root.checked ? Theme.pill-active-top
            : (track-ta.has-hover && root.enabled && root.interactive ? Theme.selected-border : Theme.well-border);
        background: root.checked
            ? (track-ta.pressed ? Theme.pill-active-bot.darker(0.12) : Theme.pill-active-bot)
            : Theme.inset-bg;
        opacity: root.enabled ? 1.0 : 0.45;
        animate border-color { duration: Motion.fast; }

        fs := FocusScope {
            enabled: root.enabled && root.interactive;
            key-pressed(ev) => {
                if (root.enabled && root.interactive && (ev.text == Key.Return || ev.text == " ")) {
                    if (root.auto-toggle) { root.checked = !root.checked; }
                    root.toggled();
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            x: root.checked ? 18px : 2px;
            y: 2px;
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: Theme.control-knob-bg;
            animate x { duration: Motion.reduced ? 0ms : 140ms; easing: cubic-bezier(0.23, 1.0, 0.32, 1.0); }
        }

        track-ta := TouchArea {
            width: root.interactive ? parent.width : 0px;
            height: root.interactive ? parent.height : 0px;
            enabled: root.enabled && root.interactive;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                if (root.auto-toggle) { root.checked = !root.checked; }
                root.toggled();
            }
        }
    }

    if root.text != "" : Text {
        text: root.text;
        font-size: 13px;
        color: root.enabled ? Theme.text-primary : Theme.text-muted;
        vertical-alignment: center;
        horizontal-stretch: 0;
        overflow: elide;

        label-ta := TouchArea {
            width: root.interactive ? parent.width : 0px;
            height: root.interactive ? parent.height : 0px;
            enabled: root.enabled && root.interactive;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                if (root.auto-toggle) { root.checked = !root.checked; }
                root.toggled();
            }
        }
    }
}
