import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";

export component NexusSelect inherits Rectangle {
    in property <[string]> options: [];
    in-out property <string> current-value: "";
    in property <string> prefix: "";
    in property <string> all-label: "";
    in property <length> control-height: 32px;
    in property <bool> mono: true;
    in property <bool> enabled: true;
    callback selected(string);

    private property <int> highlight-idx: 0;

    function open-popup() {
        if (!root.enabled || root.options.length == 0) { return; }
        root.highlight-idx = 0;
        popup.show();
    }

    pure function display-opt(v: string) -> string {
        (root.all-label != "" && v == "all") ? root.all-label : v
    }

    forward-focus: sel-focus;
    vertical-stretch: 0;
    height: root.control-height;
    min-width: 72px;
    border-radius: Theme.radius-md;
    border-width: sel-focus.has-focus ? 2px : 1px;
    border-color:
        sel-focus.has-focus ? Theme.accent
        : !root.enabled ? Theme.well-border
        : sel-ta.has-hover ? Theme.control-border-hover-brush
        : Theme.control-border-brush;
    background:
        !root.enabled ? Theme.surface-bg
        : sel-ta.pressed ? Theme.control-fill-pressed
        : sel-ta.has-hover ? Theme.control-fill-hover
        : Theme.control-fill;
    opacity: root.enabled ? 1.0 : 0.52;
    animate background { duration: Motion.fast; }

    accessible-role: combobox;
    accessible-label: root.prefix != "" ? root.prefix + " " + root.display-opt(root.current-value) : root.display-opt(root.current-value);
    accessible-action-default => {
        root.open-popup();
    }

    sel-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(ev) => {
            if (root.enabled && (ev.text == Key.Return || ev.text == " " || ev.text == Key.DownArrow)) {
                root.open-popup();
                return accept;
            }
            reject
        }
    }

    sel-ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.open-popup();
        }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 7px;
        spacing: 5px;

        if root.prefix != "" : Text {
            horizontal-stretch: 0;
            text: root.prefix;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text-muted;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 1;
            min-width: 0px;
            text: root.display-opt(root.current-value);
            font-size: 12px;
            font-weight: 600;
            font-family: root.mono ? Theme.mono-font : "";
            color: Theme.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }

        Image {
            width: 13px;
            height: 13px;
            y: (parent.height - self.height) / 2;
            source: @image-url("../icons/chevron-down.svg");
            colorize: sel-ta.has-hover ? Theme.accent : Theme.text-muted;
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: max(root.width, 136px);
        close-policy: PopupClosePolicy.close-on-click-outside;
        forward-focus: popup-focus;

        popup-focus := FocusScope {
            width: 100%;
            height: min(260px, list-col.preferred-height);
            init => { self.focus(); }
            key-pressed(ev) => {
                if (ev.text == Key.Escape) {
                    popup.close();
                    return accept;
                }
                if (ev.text == Key.DownArrow && root.options.length > 0) {
                    root.highlight-idx = Math.mod(root.highlight-idx + 1, root.options.length);
                    return accept;
                }
                if (ev.text == Key.UpArrow && root.options.length > 0) {
                    root.highlight-idx = Math.mod(root.highlight-idx - 1 + root.options.length, root.options.length);
                    return accept;
                }
                if ((ev.text == Key.Return || ev.text == " ") && root.highlight-idx >= 0 && root.highlight-idx < root.options.length) {
                    let chosen = root.options[root.highlight-idx];
                    root.current-value = chosen;
                    root.selected(chosen);
                    popup.close();
                    return accept;
                }
                reject
            }

            Rectangle {
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.popup-border;
                background: Theme.overlay-bg;
                clip: true;

                Flickable {
                    width: 100%;
                    height: 100%;
                    content-height: list-col.preferred-height;

                    list-col := VerticalLayout {
                        width: parent.width;
                        padding: 4px;
                        spacing: 2px;

                        for opt[idx] in root.options : Rectangle {
                            property <bool> is-current: opt == root.current-value;
                            property <bool> is-highlighted: idx == root.highlight-idx && popup-focus.has-focus;
                            height: 28px;
                            border-radius: Theme.radius-sm;
                            background:
                                is-current ? Theme.nav-active-bg
                                : (item-ta.has-hover || is-highlighted) ? Theme.nav-hover-bg
                                : transparent;

                            // Fluent 2 left selection indicator pill
                            if is-current : Rectangle {
                                x: 2px;
                                y: (parent.height - 14px) / 2;
                                width: 3px;
                                height: 14px;
                                border-radius: 1.5px;
                                background: Theme.accent;
                            }

                            item-ta := TouchArea {
                                mouse-cursor: pointer;
                                moved => { root.highlight-idx = idx; }
                                clicked => {
                                    root.current-value = opt;
                                    root.selected(opt);
                                    popup.close();
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 6px;

                                Text {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    text: root.display-opt(opt);
                                    font-size: 12px;
                                    font-weight: is-current ? 700 : 500;
                                    font-family: root.mono ? Theme.mono-font : "";
                                    color: Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                if is-current : Image {
                                    width: 12px;
                                    height: 12px;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("../icons/check.svg");
                                    colorize: Theme.accent;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component CollapsibleSection inherits Rectangle {
    in property <string> title;
    in property <string> badge: "";
    in-out property <bool> expanded: false;

    forward-focus: hdr-fs;
    vertical-stretch: 0;
    border-radius: Theme.radius-md;
    border-width: hdr-fs.has-focus ? 2px : 1px;
    border-color:
        hdr-fs.has-focus ? Theme.accent
        : root.expanded ? Theme.hairline-strong
        : Theme.well-border;
    background: Theme.well-bg;
    animate border-color { duration: Motion.fast; }

    VerticalLayout {
        padding-left: Theme.space-md;
        padding-right: Theme.space-md;
        padding-top: Theme.space-sm;
        padding-bottom: Theme.space-sm;
        spacing: root.expanded ? Theme.space-sm : 0px;

        Rectangle {
            height: 24px;

            accessible-role: button;
            accessible-label: root.title;
            accessible-action-default => { root.expanded = !root.expanded; }

            hdr-fs := FocusScope {
                key-pressed(ev) => {
                    if (ev.text == Key.Return || ev.text == " ") {
                        root.expanded = !root.expanded;
                        return accept;
                    }
                    reject
                }
            }

            hdr-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }

            HorizontalLayout {
                spacing: Theme.space-sm;

                Image {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../icons/chevron-down.svg");
                    colorize: hdr-ta.has-hover ? Theme.accent : Theme.text-muted;
                    transform-rotation: root.expanded ? 0deg : -90deg;
                }

                Text {
                    text: root.title;
                    font-size: 12px;
                    font-weight: 600;
                    color: hdr-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    vertical-alignment: center;
                }

                if root.badge != "" : Rectangle {
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-xs;
                    background: Theme.accent-soft;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.badge;
                            font-size: 10px;
                            font-weight: 700;
                            color: Theme.nav-active-fg;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        Rectangle {
            visible: root.expanded;
            clip: true;
            height: root.expanded ? body-layout.preferred-height : 0px;

            body-layout := VerticalLayout {
                spacing: Theme.space-sm;
                @children
            }
        }
    }
}
