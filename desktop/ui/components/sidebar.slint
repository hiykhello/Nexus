import { CommandPaletteState } from "../command_palette_state.slint";
import { TooltipState } from "../feedback.slint";
import { I18n } from "../i18n.slint";
import { LayoutMetrics } from "../layout_metrics.slint";
import { Shortcuts } from "../shortcuts.slint";
import { Theme } from "../theme.slint";

component NavRailItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip-text: "";
    in property <bool> active: false;
    in property <bool> collapsed: true;
    callback triggered();

    private property <bool> tip-armed: false;

    forward-focus: fs;
    height: 36px;
    border-radius: Theme.radius-md;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: fs.has-focus ? Theme.accent : transparent;
    background:
        root.active ? Theme.nav-active-bg
        : ta.has-hover ? Theme.nav-hover-bg
        : transparent;

    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.triggered(); }

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Return || ev.text == " ") {
                root.triggered();
                return accept;
            }
            reject
        }
    }

    Timer {
        interval: 260ms;
        running: root.tip-armed && root.collapsed && !ta.pressed;
        triggered => {
            root.tip-armed = false;
            if (ta.has-hover && root.collapsed) {
                TooltipState.show-right(
                    root.tip-text != "" ? root.tip-text : root.label,
                    root.absolute-position.x,
                    root.absolute-position.y,
                    root.width,
                    root.height
                );
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover && root.collapsed) {
                if (TooltipState.visible || TooltipState.warm) {
                    root.tip-armed = false;
                    TooltipState.show-right(
                        root.tip-text != "" ? root.tip-text : root.label,
                        root.absolute-position.x,
                        root.absolute-position.y,
                        root.width,
                        root.height
                    );
                } else {
                    root.tip-armed = true;
                }
            } else {
                root.tip-armed = false;
                TooltipState.hide();
            }
        }
        clicked => {
            root.tip-armed = false;
            TooltipState.hide();
            root.triggered();
        }
    }

    if root.active : Rectangle {
        x: 0px;
        y: 8px;
        width: 3px;
        height: 20px;
        border-radius: 1.5px;
        background: Theme.accent;
    }

    Image {
        x: root.collapsed ? (parent.width - self.width) / 2 : 11px;
        y: (parent.height - self.height) / 2;
        width: 17px;
        height: 17px;
        source: root.icon;
        colorize:
            root.active ? Theme.nav-active-fg
            : ta.has-hover ? Theme.text-primary
            : Theme.text-secondary;
    }

    if !root.collapsed : Text {
        x: 36px;
        y: 0px;
        width: max(0px, parent.width - 44px);
        height: 100%;
        text: root.label;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.nav-active-fg : Theme.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }
}

component RailUtilityButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> tip-text: "";
    in property <bool> collapsed: true;
    in property <angle> icon-rotation: 0deg;
    callback clicked();

    private property <bool> tip-armed: false;

    forward-focus: fs;
    height: 34px;
    border-radius: Theme.radius-md;
    border-width: fs.has-focus ? 2px : 0px;
    border-color: fs.has-focus ? Theme.accent : transparent;
    background: ta.pressed ? Theme.nav-active-bg : ta.has-hover ? Theme.nav-hover-bg : transparent;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.Return || ev.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    Timer {
        interval: 260ms;
        running: root.tip-armed && root.collapsed && !ta.pressed;
        triggered => {
            root.tip-armed = false;
            if (ta.has-hover && root.collapsed) {
                TooltipState.show-right(
                    root.tip-text != "" ? root.tip-text : root.label,
                    root.absolute-position.x,
                    root.absolute-position.y,
                    root.width,
                    root.height
                );
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover && root.collapsed) {
                if (TooltipState.visible || TooltipState.warm) {
                    root.tip-armed = false;
                    TooltipState.show-right(
                        root.tip-text != "" ? root.tip-text : root.label,
                        root.absolute-position.x,
                        root.absolute-position.y,
                        root.width,
                        root.height
                    );
                } else {
                    root.tip-armed = true;
                }
            } else {
                root.tip-armed = false;
                TooltipState.hide();
            }
        }
        clicked => {
            root.tip-armed = false;
            TooltipState.hide();
            root.clicked();
        }
    }

    Image {
        x: root.collapsed ? (parent.width - self.width) / 2 : 11px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: ta.has-hover ? Theme.accent : Theme.text-secondary;
        transform-rotation: root.icon-rotation;
    }

    if !root.collapsed : Text {
        x: 36px;
        y: 0px;
        width: max(0px, parent.width - 44px);
        height: 100%;
        text: root.label;
        font-size: 12px;
        font-weight: 500;
        color: ta.has-hover ? Theme.text-primary : Theme.text-secondary;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component Sidebar inherits Rectangle {
    in-out property <int> active-tab: 0;
    in-out property <length> sidebar-width: 196px;
    in-out property <bool> sidebar-collapsed: true;
    in property <length> window-width: 1280px;

    callback toggle-sidebar-requested();
    callback prefs-changed();
    callback refresh-groups();
    callback refresh-connections();
    callback refresh-profiles();
    callback refresh-logs();

    property <bool> is-compact: LayoutMetrics.is-compact-w(root.window-width);
    property <bool> eff-collapsed: root.is-compact ? !LayoutMetrics.compact-override-expanded : root.sidebar-collapsed;
    property <length> expanded-w: clamp(root.sidebar-width, 176px, 224px);

    width: root.eff-collapsed ? 54px : root.expanded-w;
    horizontal-stretch: 0;
    background: Theme.sidebar-card-bg;
    clip: true;

    VerticalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 12px;
        padding-bottom: 10px;
        spacing: 4px;

        // Top Brand Mark
        Rectangle {
            height: 36px;

            Image {
                x: root.eff-collapsed ? (parent.width - self.width) / 2 : 9px;
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                source: @image-url("../icons/nexus-prism.svg");
            }

            if !root.eff-collapsed : Text {
                x: 38px;
                y: 0px;
                width: max(0px, parent.width - 44px);
                height: 100%;
                text: "Nexus";
                font-size: 16px;
                font-weight: 800;
                letter-spacing: 0.3px;
                color: Theme.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle { height: 6px; }

        // 6 Primary Navigation Entries (zero section headers, zero persistent shortcut badges)
        NavRailItem {
            icon: @image-url("../icons/overview.svg");
            label: I18n.t("概览", "Dashboard");
            tip-text: I18n.t("概览", "Dashboard") + " (" + Shortcuts.format-full(Shortcuts.tab-overview) + ")";
            collapsed: root.eff-collapsed;
            active: root.active-tab == 0;
            triggered => { root.active-tab = 0; }
        }
        NavRailItem {
            icon: @image-url("../icons/groups.svg");
            label: I18n.t("代理", "Proxies");
            tip-text: I18n.t("代理", "Proxies") + " (" + Shortcuts.format-full(Shortcuts.tab-groups) + ")";
            collapsed: root.eff-collapsed;
            active: root.active-tab == 1;
            triggered => { root.active-tab = 1; root.refresh-groups(); }
        }
        NavRailItem {
            icon: @image-url("../icons/connections.svg");
            label: I18n.t("连接", "Connections");
            tip-text: I18n.t("连接", "Connections") + " (" + Shortcuts.format-full(Shortcuts.tab-connections) + ")";
            collapsed: root.eff-collapsed;
            active: root.active-tab == 2;
            triggered => { root.active-tab = 2; root.refresh-connections(); }
        }
        NavRailItem {
            icon: @image-url("../icons/profiles.svg");
            label: I18n.t("配置与订阅", "Profiles");
            tip-text: I18n.t("配置与订阅", "Profiles") + " (" + Shortcuts.format-full(Shortcuts.tab-profiles) + ")";
            collapsed: root.eff-collapsed;
            active: root.active-tab == 3;
            triggered => { root.active-tab = 3; root.refresh-profiles(); }
        }
        NavRailItem {
            icon: @image-url("../icons/logs.svg");
            label: I18n.t("日志", "Logs");
            tip-text: I18n.t("日志", "Logs") + " (" + Shortcuts.format-full(Shortcuts.tab-logs) + ")";
            collapsed: root.eff-collapsed;
            active: root.active-tab == 4;
            triggered => { root.active-tab = 4; root.refresh-logs(); }
        }
        NavRailItem {
            icon: @image-url("../icons/settings.svg");
            label: I18n.t("设置", "Settings");
            tip-text: I18n.t("设置", "Settings") + " (" + Shortcuts.format-full(Shortcuts.tab-settings) + ")";
            collapsed: root.eff-collapsed;
            active: root.active-tab == 5;
            triggered => { root.active-tab = 5; }
        }

        Rectangle { vertical-stretch: 1; min-height: 8px; }

        Rectangle { height: 1px; background: Theme.hairline-subtle; }

        // Bottom Utility Controls: Command Palette, Light/Dark toggle & Expand/Collapse toggle
        RailUtilityButton {
            icon: @image-url("../icons/search.svg");
            label: I18n.t("命令面板", "Command");
            tip-text: I18n.t("命令面板", "Command Palette") + " (" + Shortcuts.format-full(Shortcuts.command-palette) + ")";
            collapsed: root.eff-collapsed;
            clicked => { CommandPaletteState.toggle-palette(); }
        }

        RailUtilityButton {
            icon: Theme.dark ? @image-url("../icons/sun.svg") : @image-url("../icons/moon.svg");
            label: Theme.dark ? I18n.t("切换浅色", "Light Mode") : I18n.t("切换深色", "Dark Mode");
            collapsed: root.eff-collapsed;
            clicked => {
                Theme.toggle-light-dark();
                root.prefs-changed();
            }
        }

        RailUtilityButton {
            icon: @image-url("../icons/chevron-left.svg");
            icon-rotation: root.eff-collapsed ? 180deg : 0deg;
            label: root.eff-collapsed ? I18n.t("展开侧栏", "Expand") : I18n.t("收起侧栏", "Collapse");
            tip-text: (root.eff-collapsed ? I18n.t("展开侧栏", "Expand Sidebar") : I18n.t("收起侧栏", "Collapse Sidebar"))
                + " (" + Shortcuts.format-full(Shortcuts.toggle-sidebar) + ")";
            collapsed: root.eff-collapsed;
            clicked => { root.toggle-sidebar-requested(); }
        }
    }

    // Crisp 1px structural right divider
    Rectangle {
        x: parent.width - 1px;
        y: 0px;
        width: 1px;
        height: 100%;
        background: Theme.sidebar-border;
    }
}
