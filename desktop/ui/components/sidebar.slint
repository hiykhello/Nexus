import { TooltipState } from "../feedback.slint";
import { I18n } from "../i18n.slint";
import { LayoutMetrics } from "../layout_metrics.slint";
import { Motion } from "../motion.slint";
import { Shortcuts } from "../shortcuts.slint";
import { Theme } from "../theme.slint";
import { GlassSpeculum } from "glass_primitives.slint";

component NavSectionLabel inherits Rectangle {
    in property <string> label;
    in property <float> collapse-t: 0.0;

    height: root.collapse-t < 0.5 ? 20px : 8px;
    clip: true;

    if root.collapse-t < 0.5 : Text {
        x: 10px;
        y: 6px;
        text: root.label;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        color: Theme.text-muted;
        opacity: clamp(1.0 - root.collapse-t * 2.4, 0.0, 1.0);
    }

    if root.collapse-t >= 0.5 : Rectangle {
        x: 10px;
        y: 4px;
        width: max(0px, parent.width - 20px);
        height: 1px;
        background: Theme.hairline-subtle;
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> shortcut: "";
    in property <bool> active: false;
    in property <float> collapse-t: 0.0;
    in property <bool> show-shortcut: true;
    in property <bool> collapsed-tip: false;
    callback triggered();

    private property <bool> tip-armed: false;

    height: 33px;
    clip: true;
    border-radius: 10px;
    background:
        root.active ? @linear-gradient(135deg, Theme.accent.with-alpha(Theme.dark ? 0.22 : 0.14) 0%, Theme.accent.with-alpha(Theme.dark ? 0.11 : 0.07) 100%)
        : ta.has-hover ? Theme.nav-hover-bg
        : transparent;
    drop-shadow-blur: root.active ? 10px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(Theme.dark ? 0.16 : 0.10);
    transform-scale: ta.pressed ? 0.97 : 1.0;
    animate drop-shadow-blur { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; }

    accessible-role: tab;
    accessible-label: root.label;
    accessible-action-default => { root.triggered(); }

    Timer {
        interval: 260ms;
        running: root.tip-armed && root.collapsed-tip && !ta.pressed;
        triggered => {
            root.tip-armed = false;
            if (ta.has-hover && root.collapsed-tip) {
                TooltipState.show(root.label, root.absolute-position.x, root.absolute-position.y, root.width, root.height);
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover && root.collapsed-tip) {
                root.tip-armed = true;
            } else {
                root.tip-armed = false;
                TooltipState.hide();
            }
        }
        clicked => {
            root.tip-armed = false;
            TooltipState.hide();
            root.triggered();
        }
    }

    Rectangle {
        x: 2px;
        y: root.active ? 8px : parent.height / 2;
        width: 3px;
        height: root.active ? 16px : 0px;
        border-radius: 2px;
        opacity: root.active ? 1.0 : 0.0;
        background: Theme.accent;
        animate height { duration: Motion.normal; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
        animate y { duration: Motion.normal; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
        animate opacity { duration: Motion.fast; }
    }

    Image {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize:
            root.active ? Theme.nav-active-fg
            : ta.has-hover ? Theme.text-primary
            : Theme.text-secondary;
    }

    if root.collapse-t < 0.72 : Text {
        x: 34px;
        y: (parent.height - self.height) / 2;
        width: max(0px, parent.width - 34px - (root.show-shortcut && root.shortcut != "" ? 32px : 8px));
        text: root.label;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.nav-active-fg : Theme.text-primary;
        opacity: clamp(1.0 - root.collapse-t * 1.8, 0.0, 1.0);
        vertical-alignment: center;
        overflow: elide;
    }

    if root.show-shortcut && root.shortcut != "" && root.collapse-t < 0.55 : Text {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        text: root.shortcut;
        font-size: 10px;
        font-family: Theme.mono-font;
        color: root.active ? Theme.nav-active-fg : Theme.text-muted;
        opacity: 0.42 * clamp(1.0 - root.collapse-t * 2.2, 0.0, 1.0);
        vertical-alignment: center;
    }
}

export component Sidebar inherits HorizontalLayout {
    in-out property <int> active-tab: 0;
    in-out property <length> sidebar-width: 196px;
    in property <length> min-sidebar-width: 168px;
    in property <length> max-sidebar-width: 240px;
    in-out property <bool> sidebar-collapsed: false;
    in property <length> window-width: 1040px;

    callback toggle-sidebar-requested();
    callback refresh-groups();
    callback refresh-connections();
    callback refresh-profiles();
    callback refresh-logs();

    property <bool> is-compact: LayoutMetrics.is-compact-w(root.window-width);
    property <length> clamped-width: clamp(root.sidebar-width, root.min-sidebar-width, root.max-sidebar-width);
    property <bool> eff-collapsed: root.is-compact ? !LayoutMetrics.compact-override-expanded : root.sidebar-collapsed;
    property <float> collapse-t: root.eff-collapsed ? 1.0 : 0.0;
    animate collapse-t { duration: Motion.normal; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
    property <length> current-width: root.clamped-width + (60px - root.clamped-width) * root.collapse-t;
    property <bool> show-shortcuts: !root.eff-collapsed && root.clamped-width >= 180px;
    property <length> drag-start-width: 196px;
    property <length> drag-start-abs-x: 0px;

    Rectangle { width: 12px; }

    // Floating optical dock column
    VerticalLayout {
        width: root.current-width;
        padding-top: 16px;
        padding-bottom: 16px;

        Rectangle {
            vertical-stretch: 1;
            border-radius: 20px;
            border-width: 1px;
            border-color: Theme.sidebar-border;
            background: Theme.sidebar-card-bg;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.sidebar-shadow;

            GlassSpeculum {}

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 12px;
                padding-bottom: 10px;
                spacing: 4px;

                // Brand Prism mark + clean "Nexus" wordmark + collapse button
                Rectangle {
                    height: 34px;
                    clip: true;

                    if root.collapse-t < 0.6 : Image {
                        x: 4px;
                        y: (parent.height - self.height) / 2;
                        width: 24px;
                        height: 24px;
                        source: @image-url("../icons/nexus-prism.svg");
                        opacity: clamp(1.0 - root.collapse-t * 2.2, 0.0, 1.0);
                    }

                    if root.collapse-t < 0.6 : Text {
                        x: 34px;
                        y: (parent.height - self.height) / 2;
                        width: max(0px, parent.width - 66px);
                        text: "Nexus";
                        font-size: 17px;
                        font-weight: 800;
                        letter-spacing: 0.3px;
                        color: Theme.text-primary;
                        opacity: clamp(1.0 - root.collapse-t * 2.2, 0.0, 1.0);
                        overflow: elide;
                    }

                    collapse-toggle := Rectangle {
                        x: parent.width - self.width - 5px * root.collapse-t;
                        y: 2px;
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.radius-md;
                        border-width: 1px;
                        border-color: toggle-ta.has-hover || toggle-ta.pressed ? Theme.sidebar-border : transparent;
                        background:
                            toggle-ta.pressed ? Theme.nav-active-bg
                            : toggle-ta.has-hover ? Theme.nav-hover-bg
                            : transparent;
                        transform-scale: toggle-ta.pressed ? 0.92 : 1.0;
                        animate background { duration: Motion.fast; }
                        animate border-color { duration: Motion.fast; }
                        animate transform-scale { duration: Motion.micro; }

                        toggle-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.toggle-sidebar-requested(); }
                        }

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 15px;
                            height: 15px;
                            source: @image-url("../icons/chevron-left.svg");
                            colorize: toggle-ta.has-hover || toggle-ta.pressed ? Theme.accent : Theme.text-secondary;
                            transform-rotation: 180deg * root.collapse-t;
                        }
                    }
                }

                // Categorized navigation groups (核心 / 网络 / 系统 — 6 symmetric 2+2+2 tabs)
                VerticalLayout {
                    spacing: 2px;

                    NavSectionLabel { label: I18n.t("核心", "CORE"); collapse-t: root.collapse-t; }
                    NavItem { icon: @image-url("../icons/overview.svg"); label: I18n.t("概览", "Dashboard"); shortcut: Shortcuts.format-short(Shortcuts.tab-overview); collapse-t: root.collapse-t; show-shortcut: root.show-shortcuts; collapsed-tip: root.collapse-t > 0.6; active: root.active-tab == 0; triggered => { root.active-tab = 0; } }
                    NavItem { icon: @image-url("../icons/groups.svg"); label: I18n.t("代理", "Proxies"); shortcut: Shortcuts.format-short(Shortcuts.tab-groups); collapse-t: root.collapse-t; show-shortcut: root.show-shortcuts; collapsed-tip: root.collapse-t > 0.6; active: root.active-tab == 1; triggered => { root.active-tab = 1; root.refresh-groups(); } }

                    NavSectionLabel { label: I18n.t("网络", "NETWORK"); collapse-t: root.collapse-t; }
                    NavItem { icon: @image-url("../icons/connections.svg"); label: I18n.t("连接", "Connections"); shortcut: Shortcuts.format-short(Shortcuts.tab-connections); collapse-t: root.collapse-t; show-shortcut: root.show-shortcuts; collapsed-tip: root.collapse-t > 0.6; active: root.active-tab == 2; triggered => { root.active-tab = 2; root.refresh-connections(); } }
                    NavItem { icon: @image-url("../icons/profiles.svg"); label: I18n.t("档案", "Profiles"); shortcut: Shortcuts.format-short(Shortcuts.tab-profiles); collapse-t: root.collapse-t; show-shortcut: root.show-shortcuts; collapsed-tip: root.collapse-t > 0.6; active: root.active-tab == 3; triggered => { root.active-tab = 3; root.refresh-profiles(); } }

                    NavSectionLabel { label: I18n.t("系统", "SYSTEM"); collapse-t: root.collapse-t; }
                    NavItem { icon: @image-url("../icons/logs.svg"); label: I18n.t("日志", "Logs"); shortcut: Shortcuts.format-short(Shortcuts.tab-logs); collapse-t: root.collapse-t; show-shortcut: root.show-shortcuts; collapsed-tip: root.collapse-t > 0.6; active: root.active-tab == 4; triggered => { root.active-tab = 4; root.refresh-logs(); } }
                    NavItem { icon: @image-url("../icons/settings.svg"); label: I18n.t("设置", "Settings"); shortcut: Shortcuts.format-short(Shortcuts.tab-settings); collapse-t: root.collapse-t; show-shortcut: root.show-shortcuts; collapsed-tip: root.collapse-t > 0.6; active: root.active-tab == 5; triggered => { root.active-tab = 5; } }
                }

                Rectangle { vertical-stretch: 1; min-height: 4px; }
            }
        }
    }

    // Interactive horizontal width-resize handle gutter
    Rectangle {
        width: 12px;

        resize-ta := TouchArea {
            mouse-cursor: col-resize;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    root.drag-start-width = root.eff-collapsed ? 60px : root.clamped-width;
                    root.drag-start-abs-x = self.absolute-position.x + self.mouse-x;
                }
            }
            moved => {
                if (self.pressed && !root.is-compact) {
                    if (root.sidebar-collapsed) {
                        if (self.absolute-position.x + self.mouse-x - root.drag-start-abs-x > 16px) {
                            root.sidebar-collapsed = false;
                            root.sidebar-width = clamp(196px, root.min-sidebar-width, root.max-sidebar-width);
                        }
                    } else {
                        root.sidebar-width = clamp(
                            root.drag-start-width + (self.absolute-position.x + self.mouse-x - root.drag-start-abs-x),
                            root.min-sidebar-width,
                            root.max-sidebar-width
                        );
                    }
                }
            }
            double-clicked => {
                if (!root.is-compact) {
                    if (root.sidebar-collapsed) {
                        root.sidebar-collapsed = false;
                    } else {
                        root.sidebar-width = clamp(196px, root.min-sidebar-width, root.max-sidebar-width);
                    }
                }
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: resize-ta.has-hover || resize-ta.pressed ? 3px : 2px;
            height: resize-ta.has-hover || resize-ta.pressed ? 48px : 26px;
            border-radius: 2px;
            opacity: resize-ta.has-hover || resize-ta.pressed ? 0.90 : 0.16 * (1.0 - root.collapse-t * 0.65);
            background:
                resize-ta.pressed ? Theme.accent
                : resize-ta.has-hover ? Theme.accent.transparentize(0.25)
                : Theme.resize-handle;
            animate width { duration: Motion.fast; }
            animate height { duration: Motion.fast; }
            animate opacity { duration: Motion.fast; }
            animate background { duration: Motion.fast; }
        }
    }
}
