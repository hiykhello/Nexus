import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { WorkspaceState } from "../workspace_state.slint";
import { NexusVScrollBar, SlidingSegmentBar } from "glass_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { WorkspaceProfilesView, WorkspaceSubscriptionsView } from "workspace_panels.slint";
import { WorkspaceRoutingDnsView } from "workspace_routing_dns_view.slint";
import { WorkspaceHostPortableView } from "workspace_host_view.slint";

export component ProfilesPanel inherits VerticalLayout {
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;

    callback refresh-profiles();
    callback open-add-outbound();

    spacing: Theme.space-md;

    // Unified 4-Layer Workspace Sub-Tab Bar (zero duplicate Share-URI input; 8px concentric bar)
    HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;
        spacing: Theme.space-sm;

        SlidingSegmentBar {
            horizontal-stretch: 1;
            max-width: 460px;
            bar-height: 32px;
            options: [
                I18n.t("配置项", "Profiles"),
                I18n.t("订阅", "Subs"),
                I18n.t("路由与 DNS", "Route & DNS"),
                I18n.t("本机设置", "Local"),
            ];
            current-index: WorkspaceState.active-subtab;
            selected(idx) => {
                WorkspaceState.active-subtab = idx;
                sv.content-y = 0px;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        IconActionButton {
            icon: @image-url("../icons/refresh.svg");
            label: I18n.t("刷新", "Refresh");
            clicked => { root.refresh-profiles(); }
        }
    }

    if root.diagnostic-message != "" : HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;
        Rectangle {
            horizontal-stretch: 1; min-width: 0px;
            border-radius: Theme.radius-sm; border-width: 1px;
            border-color: root.diagnostic-ok ? Theme.success-border : Theme.error-border;
            background: root.diagnostic-ok ? Theme.success-bg : Theme.error-bg;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 7px; padding-bottom: 7px;
                Text {
                    text: root.diagnostic-message; font-size: 11px; font-weight: 600;
                    color: root.diagnostic-ok ? Theme.success-fg : Theme.error-fg; overflow: elide;
                }
            }
        }
    }

    // Main Scrollable 4-Layer Workspace Surface
    Rectangle {
        vertical-stretch: 1;
        clip: true;

        sv := ScrollView {
            width: 100%; height: 100%;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, ws-col.preferred-height);

            ws-col := VerticalLayout {
                x: 0px; y: 0px;
                width: sv.visible-width;
                padding-bottom: 10px;
                alignment: start;

                property <length> grid-w: max(0px, sv.visible-width - 18px);

                if WorkspaceState.active-subtab == 0 : WorkspaceProfilesView {
                    grid-w: grid-w;
                    viewport-h: sv.visible-height;
                    open-add-outbound => { root.open-add-outbound(); }
                }
                if WorkspaceState.active-subtab == 1 : WorkspaceSubscriptionsView { grid-w: grid-w; }
                if WorkspaceState.active-subtab == 2 : WorkspaceRoutingDnsView { grid-w: grid-w; }
                if WorkspaceState.active-subtab == 3 : WorkspaceHostPortableView { grid-w: grid-w; }
            }
        }

        NexusVScrollBar {
            x: parent.width - self.width - 3px;
            y: 2px;
            height: max(0px, parent.height - 4px);
            viewport-size: sv.visible-height;
            content-size: sv.content-height;
            scroll-pos <=> sv.content-y;
        }
    }
}
