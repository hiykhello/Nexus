import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { WorkspaceState } from "../workspace_state.slint";
import { GlassSpeculum, NexusInput, NexusVScrollBar } from "glass_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { WorkspaceProfilesView, WorkspaceSubscriptionsView } from "workspace_panels.slint";
import { WorkspaceRoutingDnsView } from "workspace_routing_dns_view.slint";
import { WorkspaceHostPortableView } from "workspace_host_view.slint";

component SecondaryFileChip inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> show-label: true;
    callback clicked();

    horizontal-stretch: 0;
    height: 26px;
    border-radius: 9px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.selected-border : Theme.well-border;
    background: ta.pressed ? Theme.nav-active-bg : ta.has-hover ? Theme.row-hover-bg : Theme.well-bg;
    transform-scale: ta.pressed ? 0.96 : 1.0;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: root.show-label ? 9px : 8px;
        spacing: 5px;
        Image {
            width: 12px; height: 12px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: ta.has-hover ? Theme.nav-active-fg : Theme.text-secondary;
        }
        if root.show-label : Text {
            text: root.label;
            font-size: 11px; font-weight: 600;
            color: ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
}

component WorkspaceSubTabPill inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    horizontal-stretch: 1;
    height: 30px;
    border-radius: 15px;
    border-width: root.active ? 1px : 0px;
    border-color: root.active ? Theme.accent.with-alpha(0.75) : transparent;
    background: root.active ? Theme.accent : ta.has-hover ? Theme.row-hover-bg : transparent;
    animate background { duration: Motion.fast; }

    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Text {
        text: root.label;
        font-size: 12px; font-weight: root.active ? 700 : 600;
        color: root.active ? Theme.pill-active-fg : Theme.text-secondary;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component ProfilesPanel inherits VerticalLayout {
    in-out property <string> share-link-input: "";
    in property <string> config-path: "";
    in property <int> kdl-line-count: 0;
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;

    callback refresh-profiles();
    callback import-share-link(string);
    callback open-external-editor();
    callback reload-config-from-disk();

    property <bool> show-file-labels: root.width >= 618px;
    spacing: Theme.space-md;

    // Unified 4-Layer Workspace Sub-Tab Bar + Quick Share-URI Import
    HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;
        spacing: Theme.space-sm;

        Rectangle {
            horizontal-stretch: 1;
            min-width: 280px;
            height: 36px;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: Theme.card-surface;

            HorizontalLayout {
                padding: 3px; spacing: 3px;
                WorkspaceSubTabPill { label: I18n.t("配置项", "Profiles"); active: WorkspaceState.active-subtab == 0; clicked => { WorkspaceState.active-subtab = 0; } }
                WorkspaceSubTabPill { label: I18n.t("订阅", "Subs"); active: WorkspaceState.active-subtab == 1; clicked => { WorkspaceState.active-subtab = 1; } }
                WorkspaceSubTabPill { label: I18n.t("路由与 DNS", "Route & DNS"); active: WorkspaceState.active-subtab == 2; clicked => { WorkspaceState.active-subtab = 2; } }
                WorkspaceSubTabPill { label: I18n.t("本机宿主", "Host"); active: WorkspaceState.active-subtab == 3; clicked => { WorkspaceState.active-subtab = 3; } }
            }
        }

        NexusInput {
            horizontal-stretch: 0;
            width: root.width >= 820px ? 240px : 170px;
            mono: true;
            placeholder-text: I18n.t("粘贴分享链接导入...", "Paste share URI...");
            text <=> root.share-link-input;
            accepted => { if (root.share-link-input != "") { root.import-share-link(root.share-link-input); } }
        }
        IconActionButton {
            icon: @image-url("../icons/download.svg");
            label: I18n.t("导入", "Import");
            primary: root.share-link-input != "";
            enabled: root.share-link-input != "";
            clicked => { if (root.share-link-input != "") { root.import-share-link(root.share-link-input); } }
        }
        IconActionButton {
            icon: @image-url("../icons/refresh.svg");
            label: I18n.t("刷新", "Refresh");
            spin-on-click: true;
            clicked => { root.refresh-profiles(); }
        }
    }

    // Slim active compiled config bar (path + line count + External Editor + Reload from Disk)
    HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;

        Rectangle {
            horizontal-stretch: 1; min-width: 0px; height: 40px;
            border-radius: 14px; border-width: 1px;
            border-color: Theme.card-border; background: Theme.card-surface;
            GlassSpeculum { corner-inset: 12px; }

            HorizontalLayout {
                padding-left: 12px; padding-right: 8px; spacing: 8px;
                Image {
                    width: 13px; height: 13px; y: (parent.height - self.height) / 2;
                    source: @image-url("../icons/config.svg"); colorize: Theme.text-muted;
                }
                Text {
                    horizontal-stretch: 1; min-width: 0px;
                    text: root.config-path != "" ? root.config-path : "~/.config/nexus/config.kdl";
                    font-size: 11px; font-family: Theme.mono-font;
                    color: Theme.text-secondary; vertical-alignment: center; overflow: elide;
                }
                if root.kdl-line-count > 0 && root.show-file-labels : Rectangle {
                    horizontal-stretch: 0; height: 20px; y: (parent.height - self.height) / 2;
                    border-radius: 7px; border-width: 1px; border-color: Theme.well-border; background: Theme.well-bg;
                    HorizontalLayout {
                        padding-left: 7px; padding-right: 7px;
                        Text {
                            text: I18n.t("\{root.kdl-line-count} 行", "\{root.kdl-line-count}L");
                            font-size: 10px; font-weight: 600; font-family: Theme.mono-font;
                            color: Theme.text-muted; vertical-alignment: center;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SecondaryFileChip {
                        icon: @image-url("../icons/external-link.svg");
                        label: I18n.t("外部编辑器", "External");
                        show-label: root.show-file-labels;
                        clicked => { root.open-external-editor(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SecondaryFileChip {
                        icon: @image-url("../icons/reload.svg");
                        label: I18n.t("从磁盘重载", "Reload Disk");
                        show-label: root.show-file-labels;
                        clicked => { root.reload-config-from-disk(); }
                    }
                }
            }
        }
    }

    if root.diagnostic-message != "" : HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;
        Rectangle {
            horizontal-stretch: 1; min-width: 0px;
            border-radius: Theme.radius-sm; border-width: 1px;
            border-color: root.diagnostic-ok ? Theme.success-border : Theme.error-border;
            background: root.diagnostic-ok ? Theme.success-bg : Theme.error-bg;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 7px; padding-bottom: 7px;
                Text {
                    text: root.diagnostic-message; font-size: 11px; font-weight: 600;
                    color: root.diagnostic-ok ? Theme.success-fg : Theme.error-fg; overflow: elide;
                }
            }
        }
    }

    // Main Scrollable 4-Layer Workspace Surface
    Rectangle {
        vertical-stretch: 1;
        clip: true;

        sv := ScrollView {
            width: 100%; height: 100%;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, ws-col.preferred-height);

            ws-col := VerticalLayout {
                x: 0px; y: 0px;
                width: sv.visible-width;
                padding-bottom: 10px;
                alignment: start;

                property <length> grid-w: max(0px, sv.visible-width - 18px);

                if WorkspaceState.active-subtab == 0 : WorkspaceProfilesView { grid-w: grid-w; }
                if WorkspaceState.active-subtab == 1 : WorkspaceSubscriptionsView { grid-w: grid-w; }
                if WorkspaceState.active-subtab == 2 : WorkspaceRoutingDnsView { grid-w: grid-w; }
                if WorkspaceState.active-subtab == 3 : WorkspaceHostPortableView { grid-w: grid-w; }
            }
        }

        NexusVScrollBar {
            x: parent.width - self.width - 3px;
            y: 2px;
            height: max(0px, parent.height - 4px);
            viewport-size: sv.visible-height;
            content-size: sv.content-height;
            scroll-pos <=> sv.content-y;
        }
    }
}
