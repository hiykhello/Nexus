import { ScrollView } from "std-widgets.slint";
import { I18n } from "../i18n.slint";
import { Motion } from "../motion.slint";
import { Theme } from "../theme.slint";
import { ProfileItem } from "../types.slint";
import { EmptyStateCard, GlassSpeculum, NexusInput, NexusVScrollBar } from "glass_primitives.slint";
import { IconActionButton } from "icon_button.slint";

component SecondaryFileChip inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> show-label: true;
    callback clicked();

    horizontal-stretch: 0;
    height: 26px;
    border-radius: 9px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.selected-border : Theme.well-border;
    background: ta.pressed ? Theme.nav-active-bg : ta.has-hover ? Theme.row-hover-bg : Theme.well-bg;
    transform-scale: ta.pressed ? 0.96 : 1.0;
    animate background { duration: Motion.fast; }
    animate border-color { duration: Motion.fast; }
    animate transform-scale { duration: Motion.micro; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: root.show-label ? 9px : 8px;
        spacing: 5px;

        Image {
            width: 12px; height: 12px;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            colorize: ta.has-hover ? Theme.nav-active-fg : Theme.text-secondary;
        }
        if root.show-label : Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            vertical-alignment: center;
        }
    }
}

export component ProfilesPanel inherits VerticalLayout {
    in property <[ProfileItem]> profiles: [];
    in-out property <string> new-profile-name: "";
    in-out property <string> share-link-input: "";
    in property <string> config-path: "";
    in property <int> kdl-line-count: 0;
    in property <string> diagnostic-message: "";
    in property <bool> diagnostic-ok: true;

    callback activate-profile(string);
    callback create-profile(string);
    callback delete-profile(string);
    callback refresh-profiles();
    callback import-share-link(string);
    callback open-external-editor();
    callback reload-config-from-disk();

    property <bool> narrow-toolbar: root.width < 678px;
    property <bool> show-file-labels: root.width >= 618px;

    spacing: Theme.space-md;

    // Compact unified top controls: single row >= 660px content width, crisp 2-row stack < 660px
    if !root.narrow-toolbar : HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;
        spacing: Theme.space-sm;

        NexusInput {
            horizontal-stretch: 45;
            preferred-width: 0px;
            min-width: 140px;
            text <=> root.new-profile-name;
            placeholder-text: I18n.t("新档案名称...", "New profile name...");
            accepted => {
                if (root.new-profile-name != "") {
                    root.create-profile(root.new-profile-name);
                    root.new-profile-name = "";
                }
            }
        }
        IconActionButton {
            icon: @image-url("../icons/plus.svg");
            label: I18n.t("新建档案", "Create Profile");
            primary: true;
            clicked => {
                if (root.new-profile-name != "") {
                    root.create-profile(root.new-profile-name);
                    root.new-profile-name = "";
                }
            }
        }

        NexusInput {
            horizontal-stretch: 55;
            preferred-width: 0px;
            min-width: 160px;
            mono: true;
            placeholder-text: I18n.t("粘贴节点分享链接导入...", "Paste share URI to import...");
            text <=> root.share-link-input;
            accepted => {
                if (root.share-link-input != "") { root.import-share-link(root.share-link-input); }
            }
        }
        IconActionButton {
            icon: @image-url("../icons/download.svg");
            label: I18n.t("导入节点", "Import Node");
            primary: root.share-link-input != "";
            enabled: root.share-link-input != "";
            clicked => {
                if (root.share-link-input != "") { root.import-share-link(root.share-link-input); }
            }
        }
        IconActionButton {
            icon: @image-url("../icons/refresh.svg");
            label: I18n.t("刷新", "Refresh");
            spin-on-click: true;
            clicked => { root.refresh-profiles(); }
        }
    }

    if root.narrow-toolbar : VerticalLayout {
        vertical-stretch: 0;
        padding-right: 18px;
        spacing: Theme.space-sm;

        HorizontalLayout {
            spacing: Theme.space-sm;
            NexusInput {
                horizontal-stretch: 1;
                min-width: 120px;
                text <=> root.new-profile-name;
                placeholder-text: I18n.t("新档案名称...", "New profile name...");
                accepted => {
                    if (root.new-profile-name != "") {
                        root.create-profile(root.new-profile-name);
                        root.new-profile-name = "";
                    }
                }
            }
            IconActionButton {
                icon: @image-url("../icons/plus.svg");
                label: I18n.t("新建档案", "Create Profile");
                primary: true;
                clicked => {
                    if (root.new-profile-name != "") {
                        root.create-profile(root.new-profile-name);
                        root.new-profile-name = "";
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.space-sm;
            NexusInput {
                horizontal-stretch: 1;
                min-width: 120px;
                mono: true;
                placeholder-text: I18n.t("粘贴节点分享链接导入...", "Paste share URI to import...");
                text <=> root.share-link-input;
                accepted => {
                    if (root.share-link-input != "") { root.import-share-link(root.share-link-input); }
                }
            }
            IconActionButton {
                icon: @image-url("../icons/download.svg");
                label: I18n.t("导入节点", "Import Node");
                primary: root.share-link-input != "";
                enabled: root.share-link-input != "";
                clicked => {
                    if (root.share-link-input != "") { root.import-share-link(root.share-link-input); }
                }
            }
            IconActionButton {
                icon: @image-url("../icons/refresh.svg");
                label: I18n.t("刷新", "Refresh");
                spin-on-click: true;
                clicked => { root.refresh-profiles(); }
            }
        }
    }

    // Slim active config file bar (path + line count + External Editor + Reload from Disk)
    HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;

        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            height: 40px;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.card-border;
            background: Theme.card-surface;

            GlassSpeculum { corner-inset: 12px; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;

                Image {
                    width: 13px; height: 13px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../icons/config.svg");
                    colorize: Theme.text-muted;
                }

                Text {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    text: root.config-path != "" ? root.config-path : "~/.config/nexus/config.kdl";
                    font-size: 11px;
                    font-family: Theme.mono-font;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.kdl-line-count > 0 && root.show-file-labels : Rectangle {
                    horizontal-stretch: 0;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: Theme.well-border;
                    background: Theme.well-bg;
                    HorizontalLayout {
                        padding-left: 7px; padding-right: 7px;
                        Text {
                            text: I18n.t("\{root.kdl-line-count} 行", "\{root.kdl-line-count}L");
                            font-size: 10px; font-weight: 600; font-family: Theme.mono-font;
                            color: Theme.text-muted; vertical-alignment: center;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    SecondaryFileChip {
                        icon: @image-url("../icons/external-link.svg");
                        label: I18n.t("外部编辑器", "External");
                        show-label: root.show-file-labels;
                        clicked => { root.open-external-editor(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    SecondaryFileChip {
                        icon: @image-url("../icons/reload.svg");
                        label: I18n.t("从磁盘重载", "Reload Disk");
                        show-label: root.show-file-labels;
                        clicked => { root.reload-config-from-disk(); }
                    }
                }
            }
        }
    }

    if root.diagnostic-message != "" : HorizontalLayout {
        vertical-stretch: 0;
        padding-right: 18px;

        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: root.diagnostic-ok ? Theme.success-border : Theme.error-border;
            background: root.diagnostic-ok ? Theme.success-bg : Theme.error-bg;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 7px; padding-bottom: 7px;
                Text {
                    text: root.diagnostic-message;
                    font-size: 11px; font-weight: 600;
                    color: root.diagnostic-ok ? Theme.success-fg : Theme.error-fg;
                    overflow: elide;
                }
            }
        }
    }

    // Bento Profile Cards directly on #101114 graphite canvas
    Rectangle {
        vertical-stretch: 1;
        clip: true;

        sv := ScrollView {
            width: 100%;
            height: 100%;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            content-width: self.visible-width;
            content-height: max(self.visible-height, prof-col.preferred-height);

            prof-col := VerticalLayout {
                x: 0px;
                y: 0px;
                width: sv.visible-width;
                padding-bottom: 8px;
                alignment: start;

                property <length> grid-w: max(0px, sv.visible-width - 18px);
                property <int> grid-cols: grid-w >= 800px ? 3 : grid-w >= 440px ? 2 : 1;
                property <length> card-w: max(0px, Math.floor((grid-w - 12px * (grid-cols - 1)) / grid-cols / 1px) * 1px);
                property <length> cell-w: card-w + 12px;

                if root.profiles.length == 0 : EmptyStateCard {
                    width: grid-w;
                    icon: @image-url("../icons/profiles.svg");
                    title: I18n.t("暂无配置档案", "No profiles yet");
                    subtitle: I18n.t("保存当前配置为场景档案", "Save current config as a profile");
                    action-label: I18n.t("保存为默认档案", "Save as Default");
                    action-clicked => { root.create-profile("Default"); }
                }

                if root.profiles.length > 0 : FlexboxLayout {
                    width: max(0px, grid-w + 12px);
                    height: Math.ceil(root.profiles.length / grid-cols) * 84px;
                    for prof in root.profiles : Rectangle {
                        width: cell-w;
                        height: 84px;

                        Rectangle {
                            x: 0px; y: 0px;
                            width: card-w; height: 72px;
                            border-radius: 16px;
                            border-width: 1px;
                            border-color: prof.active ? Theme.accent.with-alpha(Theme.dark ? 0.78 : 0.62) : prof-ta.has-hover ? Theme.selected-border : Theme.card-border;
                            background: prof.active
                                ? @linear-gradient(135deg, Theme.accent.with-alpha(Theme.dark ? 0.24 : 0.14) 0%, Theme.accent.with-alpha(Theme.dark ? 0.09 : 0.04) 100%)
                                : prof-ta.has-hover ? Theme.row-hover-bg : Theme.card-surface;
                            drop-shadow-blur: prof.active || prof-ta.has-hover ? 14px : 8px;
                            drop-shadow-offset-y: prof.active || prof-ta.has-hover ? 3px : 2px;
                            drop-shadow-color: prof.active ? Theme.accent.with-alpha(Theme.dark ? 0.28 : 0.16) : Theme.card-shadow;
                            transform-scale: !prof.active && prof-ta.pressed ? 0.985 : 1.0;
                            animate border-color { duration: Motion.fast; }
                            animate drop-shadow-blur { duration: Motion.fast; }
                            animate transform-scale { duration: Motion.micro; }

                            GlassSpeculum { corner-inset: 14px; }

                            prof-ta := TouchArea {
                                mouse-cursor: prof.active ? default : pointer;
                                clicked => { if (!prof.active) { root.activate-profile(prof.id); } }
                            }

                            Rectangle {
                                x: 2px;
                                y: prof.active ? 16px : parent.height / 2;
                                width: 3px;
                                height: prof.active ? (parent.height - 32px) : 0px;
                                border-radius: 2px;
                                opacity: prof.active ? 1.0 : 0.0;
                                background: Theme.accent;
                                animate height { duration: Motion.normal; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                                animate y { duration: Motion.normal; easing: cubic-bezier(0.22, 1.0, 0.36, 1.0); }
                                animate opacity { duration: Motion.fast; }
                            }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 14px;
                                spacing: Theme.space-sm;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle { width: 8px; height: 8px; border-radius: 4px; background: prof.active ? Theme.success-fg : Theme.offline-fg; }
                                }

                                Text {
                                    text: prof.name; font-size: 14px; font-weight: prof.active ? 700 : 600;
                                    color: Theme.text-primary;
                                    vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide;
                                }

                                if prof.active : VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 22px; border-radius: 11px; border-width: 1px; border-color: Theme.success-border; background: Theme.success-bg;
                                        HorizontalLayout {
                                            padding-left: 9px; padding-right: 9px;
                                            Text { text: I18n.t("使用中", "Active"); font-size: 10px; font-weight: 700; color: Theme.success-fg; vertical-alignment: center; }
                                        }
                                    }
                                }

                                if !prof.active : VerticalLayout {
                                    alignment: center;
                                    IconActionButton {
                                        icon: @image-url("../icons/trash.svg");
                                        label: I18n.t("删除", "Delete");
                                        danger: true;
                                        size: 28px;
                                        clicked => { root.delete-profile(prof.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        NexusVScrollBar {
            x: parent.width - self.width - 3px;
            y: 2px;
            height: max(0px, parent.height - 4px);
            viewport-size: sv.visible-height;
            content-size: sv.content-height;
            scroll-pos <=> sv.content-y;
        }
    }
}
