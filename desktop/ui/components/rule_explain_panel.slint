import { Button, ComboBox, LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "../theme.slint";

export component RuleExplainPanel inherits VerticalBox {
    in-out property <string> inbound-name: "local";
    in-out property <string> network-kind: "tcp";
    in-out property <string> target-authority: "example.com:443";
    in-out property <string> extra-options: "dns-qtype=A resolved-ip=93.184.216.34";
    in property <string> explain-result: "";
    in property <bool> explain-ok: true;

    callback run-explain(string, string, string, string);

    spacing: 12px;

    Text {
        text: "规则命中交互测试台 (nexus rule explain --oneline)";
        font-size: 16px;
        font-weight: 700;
    }

    HorizontalBox {
        spacing: 8px;
        LineEdit {
            width: 140px;
            text <=> root.inbound-name;
            placeholder-text: "入站标签 (如 local)";
        }
        ComboBox {
            width: 90px;
            model: ["tcp", "udp"];
            current-value <=> root.network-kind;
        }
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.target-authority;
            placeholder-text: "目标 host:port (如 example.com:443)";
            accepted => { root.run-explain(root.inbound-name, root.network-kind, root.target-authority, root.extra-options); }
        }
    }

    HorizontalBox {
        spacing: 8px;
        LineEdit {
            horizontal-stretch: 1;
            text <=> root.extra-options;
            placeholder-text: "附加参数 (如 dns-qtype=HTTPS resolved-ip=1.1.1.1 protocol=tls --expect-outbound=direct)";
            accepted => { root.run-explain(root.inbound-name, root.network-kind, root.target-authority, root.extra-options); }
        }
        Button {
            text: "执行测试";
            primary: true;
            clicked => { root.run-explain(root.inbound-name, root.network-kind, root.target-authority, root.extra-options); }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.card-border;
        background: Theme.card-bg;
        VerticalBox {
            padding: 14px;
            spacing: 6px;
            Text {
                text: root.explain-result == "" ? "输入入站与目标后点击「执行测试」，将调用内核静态求值 DNS 策略与路由命中结果（零网络 I/O）。"
                    : (root.explain-ok ? "✓ 命中结果" : "✗ 校验失败或断言不匹配");
                font-size: 13px;
                font-weight: 600;
            }
            if root.explain-result != "" : Text {
                text: root.explain-result;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}
