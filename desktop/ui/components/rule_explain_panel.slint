import { I18n } from "../i18n.slint";
import { Theme } from "../theme.slint";
import { NexusInput } from "nexus_primitives.slint";
import { IconActionButton } from "icon_button.slint";
import { NexusSelect } from "nexus_select.slint";

export component RuleExplainPanel inherits VerticalLayout {
    in-out property <string> inbound-name: "mixed-in";
    in-out property <string> network-kind: "tcp";
    in-out property <string> target-authority: "example.com:443";
    in-out property <string> extra-options: "dns-qtype=A resolved-ip=93.184.216.34";
    in property <string> explain-result: "";
    in property <bool> explain-ok: true;
    in property <bool> embed-mode: false;

    callback run-explain(string, string, string, string);

    spacing: Theme.space-md;

    Rectangle {
        vertical-stretch: 0;
        border-radius: root.embed-mode ? Theme.radius-card : 0px;
        border-width: root.embed-mode ? 1px : 0px;
        border-color: Theme.card-border;
        background: root.embed-mode ? Theme.card-surface : transparent;

        VerticalLayout {
            padding: root.embed-mode ? Theme.space-md : 0px;
            spacing: Theme.space-sm;

            if root.embed-mode : Text {
                text: I18n.t("流水线规则解释器", "Pipeline Rule Explainer");
                font-size: 13px;
                font-weight: 700;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: Theme.space-sm;
                NexusInput {
                    width: root.embed-mode ? 104px : 132px;
                    mono: true;
                    text <=> root.inbound-name;
                    placeholder-text: I18n.t("入站", "Inbound");
                }
                NexusSelect {
                    width: 82px;
                    options: ["tcp", "udp"];
                    current-value <=> root.network-kind;
                }
                NexusInput {
                    horizontal-stretch: 1;
                    mono: true;
                    text <=> root.target-authority;
                    placeholder-text: "host:port";
                    accepted => { root.run-explain(root.inbound-name, root.network-kind, root.target-authority, root.extra-options); }
                }
            }

            HorizontalLayout {
                spacing: Theme.space-sm;
                NexusInput {
                    horizontal-stretch: 1;
                    mono: true;
                    text <=> root.extra-options;
                    placeholder-text: I18n.t("附加参数 (可选)", "Extra args (optional)");
                    accepted => { root.run-explain(root.inbound-name, root.network-kind, root.target-authority, root.extra-options); }
                }
                IconActionButton {
                    icon: @image-url("../icons/play.svg");
                    label: I18n.t("执行规则解释", "Run Explain");
                    primary: true;
                    clicked => { root.run-explain(root.inbound-name, root.network-kind, root.target-authority, root.extra-options); }
                }
            }

            // Pipeline Visualization Trace
            Rectangle {
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color:
                    root.explain-result == "" ? Theme.well-border
                    : root.explain-ok ? Theme.success-border
                    : Theme.error-border;
                background: Theme.well-bg;

                VerticalLayout {
                    padding: Theme.space-md;
                    spacing: Theme.space-sm;

                    // Pipeline Breadcrumb Chips
                    FlexboxLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 20px; border-radius: Theme.radius-xs; background: Theme.row-bg; border-width: 1px; border-color: Theme.hairline-subtle;
                            HorizontalLayout {
                                padding-left: 7px; padding-right: 7px;
                                Text { text: "1. " + root.inbound-name; font-size: 10px; font-weight: 700; font-family: Theme.mono-font; color: Theme.text-secondary; vertical-alignment: center; }
                            }
                        }
                        Text { text: "→"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                        Rectangle {
                            height: 20px; border-radius: Theme.radius-xs;
                            background: root.network-kind == "udp" ? Theme.proto-quic-bg : Theme.proto-tls-bg;
                            HorizontalLayout {
                                padding-left: 7px; padding-right: 7px;
                                Text {
                                    text: "2. " + (root.network-kind == "udp" ? "UDP" : "TCP") + " · " + root.target-authority;
                                    font-size: 10px; font-weight: 700; font-family: Theme.mono-font;
                                    color: root.network-kind == "udp" ? Theme.proto-quic-fg : Theme.proto-tls-fg;
                                    vertical-alignment: center; overflow: elide;
                                }
                            }
                        }
                        Text { text: "→"; font-size: 11px; color: Theme.text-muted; vertical-alignment: center; }
                        Rectangle {
                            height: 20px; border-radius: Theme.radius-xs;
                            background: root.explain-result == "" ? Theme.row-bg : (root.explain-ok ? Theme.success-bg : Theme.error-bg);
                            HorizontalLayout {
                                padding-left: 7px; padding-right: 7px;
                                Text {
                                    text: root.explain-result == "" ? I18n.t("3. 等待测试", "3. Pending")
                                        : (root.explain-ok ? I18n.t("3. ✓ 命中", "3. ✓ Matched") : I18n.t("3. ✗ 失败", "3. ✗ Failed"));
                                    font-size: 10px; font-weight: 700;
                                    color: root.explain-result == "" ? Theme.text-muted : (root.explain-ok ? Theme.success-fg : Theme.error-fg);
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.explain-result != "" : Text {
                        text: root.explain-result;
                        font-size: 12px;
                        font-family: Theme.mono-font;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }

                    if root.explain-result == "" : Text {
                        text: I18n.t("输入目标后运行，实时测试规则命中结果", "Press Run to test rule matching against current config");
                        font-size: 11px;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
