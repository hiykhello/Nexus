export struct OutboundMemberItem {
    name: string,
    state: string,
    latency-ms: int,
    ewma-ms: int,
    breaker-open: bool,
    selected: bool,
    overridden: bool,
    pinned: bool,
}

export struct OutboundGroupItem {
    tag: string,
    mode: string,
    active-member: string,
    auto-mode: bool,
    active-latency-ms: int,
    member-count: int,
}

export struct LogLineItem {
    level: string,
    domain: string,
    message: string,
}

export struct ActiveConnectionItem {
    id: string,
    protocol: string,
    path: string,
    target: string,
    inbound: string,
    outbound: string,
    route-rule: string,
    process-path: string,
    source: string,
    duration-text: string,
    destination-port: int,
    upload-text: string,
    download-text: string,
    up-ratio: float,
    has-traffic: bool,
}

export struct ProfileItem {
    id: string,
    name: string,
    active: bool,
}

export struct RouteRuleDraft {
    use-rule-set: bool,
    rule-set-name: string,
    cond-count: int,
    c1-kind: string,
    c1-value: string,
    c2-kind: string,
    c2-value: string,
    c3-kind: string,
    c3-value: string,
    c4-kind: string,
    c4-value: string,
    action-kind: string,
    target-outbound: string,
    tls-fragment: bool,
}

export struct DnsRuleDraft {
    match-kind: string,
    match-value: string,
    action-kind: string,
    target-server: string,
}

export struct OutboundNodeDraft {
    proto: string,
    tag: string,
    host: string,
    port: string,
    secret: string,
    uuid-str: string,
    username: string,
    flow: string,
    hy2-ports: string,
    hy2-salamander: string,
    hy2-up-mbps: string,
    hy2-down-mbps: string,
    tuic-cc: string,
    tuic-udp-over-stream: bool,
    ss-method: string,
    snell-ver: int,
    snell-obfs: string,
    snell-obfs-host: string,
    naive-proto: string,
    ssh-host-sha: string,
    sni: string,
    fingerprint: string,
    cert-sha256: string,
    use-reality: bool,
    reality-pbk: string,
    reality-sid: string,
    tls-fragment: bool,
    ech-dns: bool,
    ech-query-sni: string,
    transport: string,
    transport-path: string,
    transport-host: string,
    xhttp-mode: string,
    ws-max-early-data: string,
    ws-early-data-header: string,
    mux-enabled: bool,
    mux-proto: string,
    mux-max-conns: string,
    mux-min-streams: string,
    mux-padding: bool,
}
