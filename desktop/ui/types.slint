export struct OutboundMemberItem {
    name: string,
    state: string,
    latency-ms: int,
    selected: bool,
    overridden: bool,
    pinned: bool,
}

export struct OutboundGroupItem {
    tag: string,
    mode: string,
    active-member: string,
    auto-mode: bool,
    active-latency-ms: int,
    member-count: int,
}

export struct LogLineItem {
    level: string,
    domain: string,
    message: string,
}

export struct ActiveConnectionItem {
    id: string,
    protocol: string,
    path: string,
    target: string,
    inbound: string,
    outbound: string,
    route-rule: string,
    process-path: string,
    source: string,
    duration-text: string,
    destination-port: int,
    upload-text: string,
    download-text: string,
    up-ratio: float,
    has-traffic: bool,
}

export struct ProfileItem {
    id: string,
    name: string,
    active: bool,
}
