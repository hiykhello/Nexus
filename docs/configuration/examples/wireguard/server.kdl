schema-version 1
role "server"
endpoint "office" type="wireguard" {
    private-key-file "/run/credentials/nexus/wireguard-private"
    listen host="::" port=51820
    device name="nexus-wg" mtu=1420
    local-address "10.42.0.2/32"
    local-address "fd42::2/128"
    route-include "10.42.0.1/32"
    route-include "fd42::1/128"
    peer "client" {
        public-key-file "/etc/nexus/client-public"
        preshared-key-file "/run/credentials/nexus/client-psk"
        allowed-ip "10.42.0.1/32"
        allowed-ip "fd42::1/128"
    }
}
